+#ifdef HAVE_PAN_KMOD_KBASE
+/*
+ * mali-gl: kbase (Arm mali_kbase, /dev/mali*) submission.
+ *
+ * On panthor the kernel owns a ring per queue and, for every GROUP_SUBMIT,
+ * emits a flush + CALL + SYNC sequence into it.  kbase hands the ring to
+ * userspace, so we emit that sequence ourselves (ported from PanVK's kbase
+ * queue in zenithblue-oss/panvk-kbase-android), publish the new insert offset
+ * through the USER_IO input page and ring the doorbell or kick.
+ *
+ * Submission is asynchronous: each BO records the (slot, seqno) of its last
+ * use and is waited for on demand (panfrost_kbase_bo_wait()).  Work from other
+ * contexts of this process is ordered with GPU-side SYNC_WAIT64 on their slots,
+ * and BOs shared with other processes use dma-buf implicit sync: their fences
+ * are waited for before the submit, and ours is attached after it.
+ * PAN_KBASE_SYNC=1 waits for every batch (the original, simplest model).
+ */
+
+#define KBASE_MAX_FOREIGN_WAITS 8
+
+struct kbase_foreign_wait {
+   uint64_t va;
+   uint64_t seqno;
+};
+
+static bool
+kbase_sync_submit(void)
+{
+   static int sync = -1;
+
+   if (sync < 0)
+      sync = debug_get_bool_option("PAN_KBASE_SYNC", false);
+   return sync;
+}
+
+#define KBASE_RINGBUF_SIZE      (64 * 1024)
+#define KBASE_RING_JOB_MAX_SIZE 1024
+#define KBASE_WAIT_TIMEOUT_NS   (10ll * 1000000000ll)
+#define KBASE_CACHELINE_SIZE    64
+
+/* Layout of the completion cell written by SYNC_ADD64 (same as PanVK's
+ * panvk_cs_sync64). */
+struct kbase_sync64 {
+   uint64_t seqno;
+   uint32_t error;
+   uint32_t pad;
+};
+
+/* Drain CPU stores to the point of coherency shared with the GPU before the
+ * firmware is told about them (DMB ISH is not enough for the GPU). */
+static inline void
+kbase_gpu_wmb(void)
+{
+#if defined(__aarch64__) || defined(__arm__)
+   __asm__ volatile("dsb sy" ::: "memory");
+#else
+   __sync_synchronize();
+#endif
+}
+
+static inline void
+kbase_cache_clean(const void *start, size_t size)
+{
+#if defined(__aarch64__)
+   uintptr_t ptr = (uintptr_t)start & ~(uintptr_t)(KBASE_CACHELINE_SIZE - 1);
+   uintptr_t end = ALIGN_POT((uintptr_t)start + size, KBASE_CACHELINE_SIZE);
+
+   for (; ptr < end; ptr += KBASE_CACHELINE_SIZE)
+      __asm__ volatile("dc cvac, %0" : : "r"(ptr) : "memory");
+#else
+   (void)start;
+   (void)size;
+#endif
+   kbase_gpu_wmb();
+}
+
+static inline void
+kbase_cache_invalidate(const void *start, size_t size)
+{
+#if defined(__aarch64__)
+   uintptr_t ptr = (uintptr_t)start & ~(uintptr_t)(KBASE_CACHELINE_SIZE - 1);
+   uintptr_t end = ALIGN_POT((uintptr_t)start + size, KBASE_CACHELINE_SIZE);
+
+   for (; ptr < end; ptr += KBASE_CACHELINE_SIZE)
+      __asm__ volatile("dc civac, %0" : : "r"(ptr) : "memory");
+#else
+   (void)start;
+   (void)size;
+#endif
+   kbase_gpu_wmb();
+}
+
+/* PAN_KBASE_HEAP_RENEW=<n>: replace the tiler heap every n submissions
+ * (default 64, 0 disables). */
+static uint32_t
+kbase_heap_renew_interval(void)
+{
+   static int64_t interval = -1;
+
+   if (interval < 0) {
+      interval = debug_get_num_option("PAN_KBASE_HEAP_RENEW", 64);
+      if (interval < 0)
+         interval = 0;
+   }
+
+   return interval;
+}
+
+static int
+kbase_map_bo(struct panfrost_device *dev, struct pan_kmod_bo *bo,
+             uint64_t size, void **cpu, uint64_t *va)
+{
+   void *map =
+      pan_kmod_bo_mmap(bo, PROT_READ | PROT_WRITE, MAP_SHARED, NULL);
+   if (map == MAP_FAILED)
+      return -1;
+
+   struct pan_kmod_vm_op op = {
+      .type = PAN_KMOD_VM_OP_TYPE_MAP,
+      .va = {
+         .start = PAN_KMOD_VM_MAP_AUTO_VA,
+         .size = size,
+      },
+      .map = {
+         .bo = bo,
+         .bo_offset = 0,
+      },
+   };
+   if (pan_kmod_vm_bind(dev->kmod.vm, PAN_KMOD_VM_OP_MODE_IMMEDIATE, &op, 1))
+      return -1;
+
+   *cpu = map;
+   *va = op.va.start;
+   return 0;
+}
+
+static void
+kbase_publish(struct panfrost_context *ctx)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   const uint64_t page = kbase_kmod_page_size();
+   uint8_t *user_io = ctx->csf.kbase.user_io;
+   uint8_t *input_page = user_io + page;
+   uint8_t *output_page = user_io + 2 * page;
+   volatile uint32_t *active =
+      (volatile uint32_t *)(output_page + CS_USER_IO_OUTPUT_CS_ACTIVE);
+
+   *(volatile uint64_t *)(input_page + CS_USER_IO_INPUT_CS_INSERT) =
+      ctx->csf.kbase.insert;
+   kbase_gpu_wmb();
+
+   /* An active queue takes the userspace doorbell; if a suspend raced the
+    * write, the scheduler kick resumes the group. */
+   if (*active) {
+      *(volatile uint32_t *)user_io = 1;
+      kbase_gpu_wmb();
+      if (*active)
+         return;
+   }
+
+   kbase_kmod_csf_queue_kick(dev->kmod.dev, ctx->csf.kbase.ring_va);
+}
+
+static int
+kbase_wait_seqno(struct panfrost_context *ctx, uint64_t target)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   volatile struct kbase_sync64 *cell =
+      (volatile struct kbase_sync64 *)ctx->csf.kbase.seqno_cpu;
+   const uint8_t *output_page =
+      (const uint8_t *)ctx->csf.kbase.user_io + 2 * kbase_kmod_page_size();
+   int64_t start = os_time_get_nano();
+   int64_t last_kick = start;
+   int64_t deadline = start + KBASE_WAIT_TIMEOUT_NS;
+
+   while (true) {
+      kbase_cache_invalidate((const void *)cell, sizeof(*cell));
+      if (cell->seqno >= target)
+         return 0;
+
+      if (cell->error) {
+         /* The CS output page mirrors CS_FAULT (0x80) / CS_FAULT_INFO
+          * (0x88); exception type 0 is not a fault. */
+         uint32_t cs_fault = *(volatile uint32_t *)(output_page + 0x80);
+         uint32_t info_lo = *(volatile uint32_t *)(output_page + 0x88);
+         uint32_t info_hi = *(volatile uint32_t *)(output_page + 0x8c);
+
+         if ((cs_fault & 0xff) || info_lo || info_hi) {
+            mesa_loge("panfrost/kbase: CS error 0x%x, fault 0x%x info "
+                      "0x%08x%08x (seqno %" PRIu64 "/%" PRIu64 ")",
+                      cell->error, cs_fault, info_hi, info_lo,
+                      (uint64_t)cell->seqno, target);
+            return -EIO;
+         }
+      }
+
+      int64_t now = os_time_get_nano();
+
+      /* A kick can race with a group suspend and get dropped. */
+      if (now - last_kick > 500ll * 1000000ll) {
+         kbase_kmod_csf_queue_kick(dev->kmod.dev, ctx->csf.kbase.ring_va);
+         last_kick = now;
+      }
+
+      if (now >= deadline) {
+         uint64_t extract = *(volatile uint64_t *)(output_page +
+                                                   CS_USER_IO_OUTPUT_CS_EXTRACT);
+         uint32_t active = *(volatile uint32_t *)(output_page +
+                                                  CS_USER_IO_OUTPUT_CS_ACTIVE);
+         mesa_loge("panfrost/kbase: timeout: seqno %" PRIu64 ", target %" PRIu64
+                   ", insert %" PRIu64 ", extract %" PRIu64 ", active %u",
+                   (uint64_t)cell->seqno, target, ctx->csf.kbase.insert,
+                   extract, active);
+         return -ETIME;
+      }
+
+      /* Block on the kernel instead of spinning: that is what lets kbase
+       * service tiler OOM, sync updates and scheduling while we wait. */
+      int64_t remaining = MIN2(deadline - now, 20ll * 1000000ll);
+      if (kbase_kmod_csf_wait_cqs64(dev->kmod.dev, ctx->csf.kbase.seqno_va,
+                                    target - 1, remaining) < 0)
+         kbase_kmod_csf_wait_event(dev->kmod.dev, remaining);
+   }
+}
+
+/* Emit one ring entry: (re)program heap and tiler OOM handler, flush caches,
+ * CALL the stream, wait for all scoreboards, then SYNC_ADD64 the seqno. */
+static int
+kbase_emit_job(struct panfrost_context *ctx, uint64_t stream_addr,
+               uint32_t stream_size, const struct kbase_foreign_wait *waits,
+               unsigned wait_count)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   const struct drm_panthor_csif_info *csif_info = csf_get_csif_info(dev);
+   const uint8_t *output_page =
+      (const uint8_t *)ctx->csf.kbase.user_io + 2 * kbase_kmod_page_size();
+   uint32_t offset = ctx->csf.kbase.insert % KBASE_RINGBUF_SIZE;
+   uint64_t required = KBASE_RING_JOB_MAX_SIZE;
+
+   if (offset + KBASE_RING_JOB_MAX_SIZE > KBASE_RINGBUF_SIZE)
+      required += KBASE_RINGBUF_SIZE - offset;
+
+   uint64_t extract =
+      *(volatile uint64_t *)(output_page + CS_USER_IO_OUTPUT_CS_EXTRACT);
+   if (ctx->csf.kbase.insert - extract + required > KBASE_RINGBUF_SIZE) {
+      int ret = kbase_wait_seqno(ctx, ctx->csf.kbase.emitted);
+      if (ret)
+         return ret;
+   }
+
+   /* Never straddle the end of the ring: pad with NOPs and wrap. */
+   if (offset + KBASE_RING_JOB_MAX_SIZE > KBASE_RINGBUF_SIZE) {
+      memset(ctx->csf.kbase.ring_cpu + offset, 0, KBASE_RINGBUF_SIZE - offset);
+      kbase_cache_clean(ctx->csf.kbase.ring_cpu + offset,
+                        KBASE_RINGBUF_SIZE - offset);
+      ctx->csf.kbase.insert += KBASE_RINGBUF_SIZE - offset;
+      offset = 0;
+   }
+
+   struct cs_buffer ring = {
+      .cpu = (uint64_t *)(ctx->csf.kbase.ring_cpu + offset),
+      .gpu = ctx->csf.kbase.ring_va + offset,
+      .capacity = KBASE_RING_JOB_MAX_SIZE / sizeof(uint64_t),
+   };
+   const struct cs_builder_conf conf = {
+      .nr_registers = csif_info->cs_reg_count,
+      .nr_kernel_registers = MAX2(csif_info->unpreserved_cs_reg_count, 4),
+      .ls_sb_slot = PANFROST_SB_LS,
+   };
+   struct cs_builder b;
+   cs_builder_init(&b, &conf, ring);
+
+#if PAN_ARCH >= 11
+   cs_set_state_imm32(&b, MALI_CS_SET_STATE_TYPE_SB_SEL_OTHER, PANFROST_SB_LS);
+   cs_set_state_imm32(&b, MALI_CS_SET_STATE_TYPE_SB_SEL_DEFERRED,
+                      PANFROST_SB_DEFERRED);
+#else
+   cs_set_scoreboard_entry(&b, PANFROST_SB_RENDER, PANFROST_SB_LS);
+#endif
+
+   /* Userspace-owned queues must declare their resources in the ring
+    * itself before the first firmware-visible work item. */
+   cs_req_res(&b, CS_COMPUTE_RES | CS_TILER_RES | CS_IDVS_RES | CS_FRAG_RES);
+
+   /* Only the FW-unpreserved registers (top 4) may be clobbered here; the
+    * builder refuses to hand them out, so build the indices by hand. */
+   uint32_t reg = csif_info->cs_reg_count - 4;
+   struct cs_index addr64 = {.type = CS_INDEX_REGISTER, .size = 2, .reg = reg};
+   struct cs_index val32 = {.type = CS_INDEX_REGISTER, .size = 1, .reg = reg + 2};
+   struct cs_index val64 = {.type = CS_INDEX_REGISTER, .size = 2, .reg = reg + 2};
+
+   /* Order after other contexts' work on the BOs we touch. */
+   for (unsigned i = 0; i < wait_count; i++) {
+      cs_move64_to(&b, addr64, waits[i].va);
+      cs_move64_to(&b, val64, waits[i].seqno - 1);
+      cs_sync64_wait(&b, false, MALI_CS_CONDITION_GREATER, val64, addr64);
+   }
+
+   /* The heap context changes on renewal, and nothing guarantees that queue
+    * state set by an earlier entry survives a suspend, so program it in
+    * every entry (panthor does this once from an init stream). */
+   cs_move64_to(&b, addr64, ctx->csf.kbase.heap_ctx_va);
+   cs_heap_set(&b, addr64);
+
+   cs_move64_to(&b, addr64, ctx->csf.tiler_oom_handler.cs_bo->ptr.gpu);
+   cs_move32_to(&b, val32, ctx->csf.tiler_oom_handler.length);
+   cs_set_exception_handler(&b, MALI_CS_EXCEPTION_TYPE_TILER_OOM, addr64,
+                            val32);
+
+   if (stream_size) {
+      /* Same 0x233 flush the panthor kernel emits before a CALL. */
+      cs_move32_to(&b, val32, kbase_kmod_get_flush_id(dev->kmod.dev));
+      cs_flush_caches(&b, MALI_CS_FLUSH_MODE_CLEAN_AND_INVALIDATE,
+                      MALI_CS_FLUSH_MODE_CLEAN_AND_INVALIDATE,
+                      MALI_CS_OTHER_FLUSH_MODE_INVALIDATE, val32,
+                      cs_defer(0, PANFROST_SB_LS));
+      cs_wait_slot(&b, PANFROST_SB_LS);
+
+      cs_move64_to(&b, addr64, stream_addr);
+      cs_move32_to(&b, val32, stream_size);
+      cs_call(&b, addr64, val32);
+   }
+
+   /* Signal completion once everything retired.  Nothing but the
+    * register-less ERROR_BARRIER follows, so the operands stay intact while
+    * the deferred SYNC_ADD64 is in flight. */
+   cs_move64_to(&b, addr64, ctx->csf.kbase.seqno_va);
+   cs_wait_slots(&b, BITFIELD_MASK(8));
+   cs_move64_to(&b, val64, 1);
+   cs_sync64_add(&b, true, MALI_CS_SYNC_SCOPE_SYSTEM, val64, addr64,
+                 cs_defer(0, PANFROST_SB_DEFERRED));
+   cs_error_barrier(&b);
+   cs_end(&b);
+
+   if (!cs_is_valid(&b)) {
+      mesa_loge("panfrost/kbase: ring entry emission failed");
+      return -EINVAL;
+   }
+
+   uint32_t entry_size = cs_root_chunk_size(&b);
+   uint32_t padded_size = ALIGN_POT(entry_size, 64);
+   assert(padded_size <= KBASE_RING_JOB_MAX_SIZE);
+   if (padded_size != entry_size)
+      memset(ctx->csf.kbase.ring_cpu + offset + entry_size, 0,
+             padded_size - entry_size);
+
+   kbase_cache_clean(ctx->csf.kbase.ring_cpu + offset, padded_size);
+   ctx->csf.kbase.insert += padded_size;
+   ctx->csf.kbase.emitted++;
+
+   if (dev->debug & PAN_DBG_TRACE) {
+      uint32_t regs[256] = {0};
+      pandecode_interpret_cs(dev->decode_ctx, ctx->csf.kbase.ring_va + offset,
+                             padded_size, panfrost_device_gpu_id(dev), regs);
+   }
+
+   return 0;
+}
+
+static int
+kbase_submit_and_wait(struct panfrost_context *ctx, uint64_t stream_addr,
+                      uint32_t stream_size)
+{
+   int ret = kbase_emit_job(ctx, stream_addr, stream_size, NULL, 0);
+   if (ret)
+      return ret;
+
+   kbase_publish(ctx);
+   return kbase_wait_seqno(ctx, ctx->csf.kbase.emitted);
+}
+
+static void
+kbase_write_heap_desc(struct panfrost_context *ctx, uint64_t first_chunk)
+{
+   uint32_t chunk_size = pan_screen(ctx->base.screen)->csf_tiler_heap.chunk_size;
+
+   pan_cast_and_pack(ctx->csf.heap.desc_bo->ptr.cpu, TILER_HEAP, heap) {
+      heap.size = chunk_size;
+      heap.base = first_chunk;
+      heap.bottom = heap.base + 64;
+      heap.top = heap.base + heap.size;
+   }
+   kbase_gpu_wmb();
+}
+
+static int
+kbase_heap_create(struct panfrost_context *ctx, uint64_t *heap_ctx_va,
+                  uint64_t *first_chunk)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   struct panfrost_screen *screen = pan_screen(ctx->base.screen);
+
+   return kbase_kmod_csf_tiler_heap_create(
+      dev->kmod.dev, screen->csf_tiler_heap.chunk_size,
+      screen->csf_tiler_heap.initial_chunks,
+      MAX2(screen->csf_tiler_heap.max_chunks, 200), 65535, 0, heap_ctx_va,
+      first_chunk);
+}
+
+/* Without FRAGMENT_COMPLETED heap ops chunks are never handed back, so swap
+ * in a fresh heap now and then, after draining this context's queue. */
+static void
+kbase_heap_renew(struct panfrost_context *ctx)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   uint64_t heap_ctx_va, first_chunk;
+
+   /* The old heap may only go once nothing in flight uses it. */
+   if (kbase_wait_seqno(ctx, ctx->csf.kbase.emitted))
+      return;
+
+   if (kbase_heap_create(ctx, &heap_ctx_va, &first_chunk)) {
+      mesa_logw("panfrost/kbase: tiler heap renewal failed, keeping old heap");
+      return;
+   }
+
+   kbase_kmod_csf_tiler_heap_destroy(dev->kmod.dev, ctx->csf.kbase.heap_ctx_va);
+   ctx->csf.kbase.heap_ctx_va = heap_ctx_va;
+   kbase_write_heap_desc(ctx, first_chunk);
+   ctx->csf.kbase.heap_submits = 0;
+}
+
+static void
+kbase_mark_bo(struct panfrost_bo *bo, uint32_t slot, uint64_t seqno)
+{
+   bo->kbase_slot = slot;
+   bo->kbase_seqno = seqno;
+}
+
+/* Wait (CPU) for the implicit fences other processes put on a shared BO. */
+static void
+kbase_wait_implicit(struct panfrost_bo *bo, bool write)
+{
+#ifdef DMA_BUF_IOCTL_EXPORT_SYNC_FILE
+   int fd = kbase_kmod_bo_dmabuf_fd(bo->kmod_bo);
+   if (fd < 0)
+      return;
+
+   struct dma_buf_export_sync_file exp = {
+      .flags = write ? DMA_BUF_SYNC_WRITE : DMA_BUF_SYNC_READ,
+      .fd = -1,
+   };
+   if (ioctl(fd, DMA_BUF_IOCTL_EXPORT_SYNC_FILE, &exp) == 0 && exp.fd >= 0) {
+      sync_wait(exp.fd, 10000);
+      close(exp.fd);
+   }
+#else
+   (void)bo;
+   (void)write;
+#endif
+}
+
+/* Attach our completion fence to a shared BO so other processes (Xwayland,
+ * gamescope) wait for it.  False if that is not possible. */
+static bool
+kbase_attach_implicit(struct panfrost_bo *bo, int fence, bool write)
+{
+#ifdef DMA_BUF_IOCTL_IMPORT_SYNC_FILE
+   int fd = kbase_kmod_bo_dmabuf_fd(bo->kmod_bo);
+   if (fd < 0)
+      return false;
+
+   struct dma_buf_import_sync_file imp = {
+      .flags = write ? DMA_BUF_SYNC_WRITE : DMA_BUF_SYNC_READ,
+      .fd = fence,
+   };
+   return ioctl(fd, DMA_BUF_IOCTL_IMPORT_SYNC_FILE, &imp) == 0;
+#else
+   (void)bo;
+   (void)fence;
+   (void)write;
+   return false;
+#endif
+}
+
+static int
+csf_kbase_submit_batch(struct panfrost_batch *batch)
+{
+   struct panfrost_context *ctx = batch->ctx;
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   uint64_t cs_start = cs_root_chunk_gpu_addr(batch->csf.cs.builder);
+   uint32_t cs_size = cs_root_chunk_size(batch->csf.cs.builder);
+   const uint32_t slot = ctx->csf.kbase.slot;
+   struct kbase_foreign_wait waits[KBASE_MAX_FOREIGN_WAITS];
+   unsigned wait_count = 0;
+   bool shared = false;
+   int ret = 0;
+
+   /* No syncobjs here: honour fence_server_sync() on the CPU. */
+   if (ctx->in_sync_fd >= 0) {
+      if (sync_wait(ctx->in_sync_fd, -1))
+         mesa_logw("panfrost/kbase: waiting on an input fence failed");
+      close(ctx->in_sync_fd);
+      ctx->in_sync_fd = -1;
+   }
+
+   /* Dependencies: other contexts of this process (GPU waits on their
+    * slots) and other processes (implicit fences of shared BOs). */
+   util_dynarray_foreach(&batch->bos, pan_bo_access, ptr) {
+      unsigned i = ptr - util_dynarray_element(&batch->bos, pan_bo_access, 0);
+      pan_bo_access flags = *ptr;
+
+      if (!flags)
+         continue;
+
+      struct panfrost_bo *bo = pan_lookup_bo(dev, i);
+      panfrost_context_report_bo_access(ctx, bo, flags);
+
+      if (bo->flags & PAN_BO_SHARED) {
+         shared = true;
+         kbase_wait_implicit(bo, flags & PAN_BO_ACCESS_WRITE);
+      }
+
+      if (!bo->kbase_seqno || bo->kbase_slot == slot ||
+          panfrost_kbase_slot_value(dev, bo->kbase_slot) >= bo->kbase_seqno)
+         continue;
+
+      uint64_t va = dev->kbase_sync.va + bo->kbase_slot * PAN_KBASE_SYNC_STRIDE;
+      unsigned w;
+      for (w = 0; w < wait_count && waits[w].va != va; w++)
+         ;
+      if (w < wait_count) {
+         waits[w].seqno = MAX2(waits[w].seqno, bo->kbase_seqno);
+      } else if (wait_count < KBASE_MAX_FOREIGN_WAITS) {
+         waits[wait_count++] = (struct kbase_foreign_wait){va, bo->kbase_seqno};
+      } else {
+         panfrost_kbase_slot_wait(dev, bo->kbase_slot, bo->kbase_seqno, INT64_MAX);
+      }
+   }
+
+   if (!ctx->is_noop) {
+      ret = kbase_emit_job(ctx, cs_start, cs_size, waits, wait_count);
+      if (!ret)
+         kbase_publish(ctx);
+   }
+
+   if (ret) {
+      update_reset_status(ctx, PIPE_GUILTY_CONTEXT_RESET);
+      mesa_loge("panfrost/kbase: batch failed (%d), re-initializing context",
+                ret);
+      panfrost_context_reinit(ctx);
+      return ret;
+   }
+
+   const uint64_t seqno = ctx->csf.kbase.emitted;
+   dev->kbase_sync.high[slot] = MAX2(dev->kbase_sync.high[slot], seqno);
+
+   /* Every BO this batch touches, including its private pools, is busy
+    * until the seqno retires. */
+   util_dynarray_foreach(&batch->bos, pan_bo_access, ptr) {
+      unsigned i = ptr - util_dynarray_element(&batch->bos, pan_bo_access, 0);
+      if (*ptr)
+         kbase_mark_bo(pan_lookup_bo(dev, i), slot, seqno);
+   }
+   util_dynarray_foreach(&batch->pool.bos, struct panfrost_bo *, bo)
+      kbase_mark_bo(*bo, slot, seqno);
+   util_dynarray_foreach(&batch->csf.cs_chunk_pool.bos, struct panfrost_bo *, bo)
+      kbase_mark_bo(*bo, slot, seqno);
+
+   bool wait = ctx->is_noop ? false
+                            : kbase_sync_submit() ||
+                                 (dev->debug & (PAN_DBG_TRACE | PAN_DBG_SYNC));
+
+   /* Shared BOs: publish our fence on them; if that fails, wait instead. */
+   if (shared && !wait && !ctx->is_noop) {
+      uint64_t va = ctx->csf.kbase.seqno_va;
+      uint64_t target_minus_one = seqno - 1;
+      int fence =
+         kbase_kmod_csf_export_cqs64_fence(dev->kmod.dev, &va, &target_minus_one, 1);
+
+      if (fence < 0) {
+         wait = true;
+      } else {
+         util_dynarray_foreach(&batch->bos, pan_bo_access, ptr) {
+            unsigned i = ptr - util_dynarray_element(&batch->bos, pan_bo_access, 0);
+            struct panfrost_bo *bo = pan_lookup_bo(dev, i);
+
+            if (*ptr && (bo->flags & PAN_BO_SHARED) &&
+                !kbase_attach_implicit(bo, fence, *ptr & PAN_BO_ACCESS_WRITE))
+               wait = true;
+         }
+         close(fence);
+      }
+   }
+
+   if (wait) {
+      ret = kbase_wait_seqno(ctx, seqno);
+      if (ret) {
+         update_reset_status(ctx, PIPE_GUILTY_CONTEXT_RESET);
+         mesa_loge("panfrost/kbase: batch failed (%d), re-initializing context",
+                   ret);
+         panfrost_context_reinit(ctx);
+         return ret;
+      }
+
+      if (dev->debug & PAN_DBG_TRACE) {
+         uint32_t regs[256] = {0};
+         pandecode_interpret_cs(dev->decode_ctx, cs_start, cs_size,
+                                panfrost_device_gpu_id(dev), regs);
+         if (dev->debug & PAN_DBG_DUMP)
+            pandecode_dump_mappings(dev->decode_ctx);
+      }
+
+      struct pan_csf_tiler_oom_ctx *oom = batch->csf.tiler_oom_ctx.cpu;
+      if (oom && oom->counter > 0)
+         perf_debug(ctx, "Incremental rendering was triggered %i time(s)",
+                    oom->counter);
+   }
+
+   uint32_t interval = kbase_heap_renew_interval();
+   if (interval && ++ctx->csf.kbase.heap_submits >= interval)
+      kbase_heap_renew(ctx);
+
+   return 0;
+}
