+
+/* --- mali-gl: kbase completion tracking ------------------------------------
+ *
+ * kbase has no per-BO fences or syncobjs.  Every context owns a "slot": a
+ * 64-byte CSF event cell in a device-lifetime BO, incremented by SYNC_ADD64 at
+ * the end of each of its ring entries.  A BO remembers the (slot, seqno) of
+ * its last GPU use, so waiting for it is "slot value >= seqno".  Slots
+ * outlive their contexts and keep counting when reused, so a stale (slot,
+ * seqno) pair can never wait for work that will not come.  Cross-process
+ * users of shared BOs are covered by dma-buf implicit sync (pan_csf.c).
+ */
+
+#define PAN_KBASE_WAIT_WATCHDOG_NS (10ll * 1000000000ll)
+
+#ifdef HAVE_PAN_KMOD_KBASE
+static inline void
+pan_kbase_invalidate(const void *start, size_t size)
+{
+#if defined(__aarch64__)
+   uintptr_t ptr = (uintptr_t)start & ~(uintptr_t)63;
+   uintptr_t end = ALIGN_POT((uintptr_t)start + size, 64);
+
+   for (; ptr < end; ptr += 64)
+      __asm__ volatile("dc civac, %0" : : "r"(ptr) : "memory");
+   __asm__ volatile("dsb sy" ::: "memory");
+#else
+   (void)start;
+   (void)size;
+   __sync_synchronize();
+#endif
+}
+
+static int
+pan_kbase_sync_init_locked(struct panfrost_device *dev)
+{
+   if (dev->kbase_sync.bo)
+      return 0;
+
+   struct pan_kmod_bo *bo =
+      pan_kmod_bo_alloc(dev->kmod.dev, dev->kmod.vm,
+                        PAN_KBASE_SYNC_SLOTS * PAN_KBASE_SYNC_STRIDE,
+                        PAN_KMOD_BO_FLAG_CSF_EVENT);
+   if (!bo)
+      return -1;
+
+   void *cpu = pan_kmod_bo_mmap(bo, PROT_READ | PROT_WRITE, MAP_SHARED, NULL);
+   if (cpu == MAP_FAILED) {
+      pan_kmod_bo_put(bo);
+      return -1;
+   }
+
+   struct pan_kmod_vm_op op = {
+      .type = PAN_KMOD_VM_OP_TYPE_MAP,
+      .va = {.start = PAN_KMOD_VM_MAP_AUTO_VA,
+             .size = PAN_KBASE_SYNC_SLOTS * PAN_KBASE_SYNC_STRIDE},
+      .map = {.bo = bo, .bo_offset = 0},
+   };
+   if (pan_kmod_vm_bind(dev->kmod.vm, PAN_KMOD_VM_OP_MODE_IMMEDIATE, &op, 1)) {
+      pan_kmod_bo_put(bo);
+      return -1;
+   }
+
+   memset(cpu, 0, PAN_KBASE_SYNC_SLOTS * PAN_KBASE_SYNC_STRIDE);
+   pan_kbase_invalidate(cpu, PAN_KBASE_SYNC_SLOTS * PAN_KBASE_SYNC_STRIDE);
+   dev->kbase_sync.bo = bo;
+   dev->kbase_sync.cpu = cpu;
+   dev->kbase_sync.va = op.va.start;
+   return 0;
+}
+#endif
+
+int
+panfrost_kbase_slot_get(struct panfrost_device *dev, uint32_t *slot)
+{
+#ifdef HAVE_PAN_KMOD_KBASE
+   int ret = -1;
+
+   simple_mtx_lock(&dev->kbase_sync.lock);
+   if (!pan_kbase_sync_init_locked(dev)) {
+      for (uint32_t i = 0; i < PAN_KBASE_SYNC_SLOTS; i++) {
+         if (dev->kbase_sync.used & BITFIELD64_BIT(i))
+            continue;
+
+         /* Continue the slot's numbering; if its last owner died with work
+          * outstanding, jump the cell to the highest seqno it ever emitted so
+          * that BOs still pointing at it are released. */
+         volatile uint64_t *cell =
+            (volatile uint64_t *)(dev->kbase_sync.cpu + i * PAN_KBASE_SYNC_STRIDE);
+         pan_kbase_invalidate((const void *)cell, 16);
+         if (*cell < dev->kbase_sync.high[i])
+            *cell = dev->kbase_sync.high[i];
+         cell[1] = 0; /* error word */
+         /* Push the CPU writes out (DC CIVAC) before the GPU writes this
+          * line, or a later clean could overwrite the GPU's value. */
+         pan_kbase_invalidate((const void *)cell, 16);
+         dev->kbase_sync.used |= BITFIELD64_BIT(i);
+         *slot = i;
+         ret = 0;
+         break;
+      }
+   }
+   simple_mtx_unlock(&dev->kbase_sync.lock);
+   return ret;
+#else
+   return -1;
+#endif
+}
+
+void
+panfrost_kbase_slot_put(struct panfrost_device *dev, uint32_t slot,
+                        uint64_t emitted)
+{
+   simple_mtx_lock(&dev->kbase_sync.lock);
+   dev->kbase_sync.high[slot] = MAX2(dev->kbase_sync.high[slot], emitted);
+   dev->kbase_sync.ring_va[slot] = 0;
+   dev->kbase_sync.used &= ~BITFIELD64_BIT(slot);
+   simple_mtx_unlock(&dev->kbase_sync.lock);
+}
+
+uint64_t
+panfrost_kbase_slot_value(struct panfrost_device *dev, uint32_t slot)
+{
+#ifdef HAVE_PAN_KMOD_KBASE
+   if (!dev->kbase_sync.cpu)
+      return 0;
+
+   volatile uint64_t *cell =
+      (volatile uint64_t *)(dev->kbase_sync.cpu + slot * PAN_KBASE_SYNC_STRIDE);
+   pan_kbase_invalidate((const void *)cell, 16);
+   return *cell;
+#else
+   return 0;
+#endif
+}
+
+bool
+panfrost_kbase_slot_wait(struct panfrost_device *dev, uint32_t slot,
+                         uint64_t seqno, int64_t timeout_ns)
+{
+#ifdef HAVE_PAN_KMOD_KBASE
+   if (!seqno || panfrost_kbase_slot_value(dev, slot) >= seqno)
+      return true;
+   if (timeout_ns <= 0)
+      return false;
+
+   int64_t start = os_time_get_nano();
+   int64_t deadline = timeout_ns >= PAN_KBASE_WAIT_WATCHDOG_NS
+                         ? start + PAN_KBASE_WAIT_WATCHDOG_NS
+                         : start + timeout_ns;
+   int64_t last_kick = start;
+   uint64_t va = dev->kbase_sync.va + slot * PAN_KBASE_SYNC_STRIDE;
+
+   while (true) {
+      int64_t now = os_time_get_nano();
+      if (now >= deadline)
+         break;
+
+      /* A kick can race with a group suspend and get dropped. */
+      if (now - last_kick > 500ll * 1000000ll && dev->kbase_sync.ring_va[slot]) {
+         kbase_kmod_csf_queue_kick(dev->kmod.dev, dev->kbase_sync.ring_va[slot]);
+         last_kick = now;
+      }
+
+      int64_t remaining = MIN2(deadline - now, 20ll * 1000000ll);
+      if (kbase_kmod_csf_wait_cqs64(dev->kmod.dev, va, seqno - 1, remaining) < 0)
+         kbase_kmod_csf_wait_event(dev->kmod.dev, remaining);
+
+      if (panfrost_kbase_slot_value(dev, slot) >= seqno)
+         return true;
+   }
+
+   if (timeout_ns >= PAN_KBASE_WAIT_WATCHDOG_NS) {
+      /* Don't hang the process on a lost GPU job. */
+      mesa_loge("panfrost/kbase: slot %u stuck at %" PRIu64 " waiting for %" PRIu64
+                ", giving up", slot, panfrost_kbase_slot_value(dev, slot), seqno);
+      return true;
+   }
+   return false;
+#else
+   return true;
+#endif
+}
+
+bool
+panfrost_kbase_bo_wait(struct panfrost_bo *bo, int64_t timeout_ns,
+                       bool wait_readers)
+{
+   struct panfrost_device *dev = bo->dev;
+
+   if (bo->kbase_seqno &&
+       !panfrost_kbase_slot_wait(dev, bo->kbase_slot, bo->kbase_seqno, timeout_ns))
+      return false;
+
+#ifdef HAVE_PAN_KMOD_KBASE
+   /* Another process may be using a shared BO: dma-buf implicit fences. */
+   if (bo->flags & PAN_BO_SHARED) {
+      int fd = kbase_kmod_bo_dmabuf_fd(bo->kmod_bo);
+      if (fd >= 0) {
+         struct pollfd pfd = {
+            .fd = fd,
+            .events = wait_readers ? POLLOUT : POLLIN,
+         };
+         int ms = timeout_ns == INT64_MAX ? 10000
+                                          : (int)MIN2(DIV_ROUND_UP(timeout_ns, 1000000), 10000);
+         if (poll(&pfd, 1, ms) == 0 && timeout_ns != INT64_MAX)
+            return false;
+      }
+   }
+#endif
+
+   return true;
+}
+
+void
+panfrost_kbase_sync_fini(struct panfrost_device *dev)
+{
+   if (dev->kbase_sync.bo)
+      pan_kmod_bo_put(dev->kbase_sync.bo);
+   dev->kbase_sync.bo = NULL;
+   dev->kbase_sync.cpu = NULL;
+}
+
+bool
+panfrost_bo_wait(struct panfrost_bo *bo, int64_t timeout_ns, bool wait_readers)
+{
+   PAN_TRACE_FUNC(PAN_TRACE_GL_BO);
+
+   if (bo->dev && bo->dev->kbase)
+      return panfrost_kbase_bo_wait(bo, timeout_ns, wait_readers);
+
+   return pan_kmod_bo_wait(bo->kmod_bo, timeout_ns, !wait_readers);
+}
 
