+   const char *node = getenv("MESA_KBASE_DEVICE");
+   struct stat kst;
+   if (!node || !node[0])
+      node = "/dev/mali0";
+   return !stat(node, &kst) && S_ISCHR(kst.st_mode) &&
+          kst.st_rdev == st.st_rdev;
