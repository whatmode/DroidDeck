+/* mali-gl: kbase has no DRM node, so a /dev/mali* fd must be recognised
+ * before any DRM ioctl is issued on it (VERSION_CHECK has to be the first
+ * successful kbase ioctl).  Match by path, and by device number against
+ * /dev/mali0 or $MESA_KBASE_DEVICE for environments (proot) where the
+ * /proc/self/fd link does not show the guest path. */
+bool
+pan_kmod_fd_is_kbase(int fd)
+{
+#if defined(HAVE_PAN_KMOD_KBASE)
+   struct stat st;
+
+   if (fd < 0 || fstat(fd, &st) || !S_ISCHR(st.st_mode))
+      return false;
+
+   char link[64], path[PATH_MAX];
+   snprintf(link, sizeof(link), "/proc/self/fd/%d", fd);
+   ssize_t len = readlink(link, path, sizeof(path) - 1);
+   if (len > 0) {
+      path[len] = '\0';
+      if (!strncmp(path, "/dev/mali", 9))
+         return true;
+   }
+
+   const char *node = getenv("MESA_KBASE_DEVICE");
+   struct stat kst;
+   if (!node || !node[0])
+      node = "/dev/mali0";
+   if (!stat(node, &kst) && S_ISCHR(kst.st_mode) && kst.st_rdev == st.st_rdev)
+      return true;
+#endif
+   return false;
+}
