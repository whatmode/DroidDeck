diff --git a/src/panfrost/vulkan/panvk_kbase_profile.h b/src/panfrost/vulkan/panvk_kbase_profile.h
new file mode 100644
index 00000000000..efa5cc2e13d
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_kbase_profile.h
@@ -0,0 +1,121 @@
+/*
+ * Copyright © 2026 DroidDeck
+ * SPDX-License-Identifier: MIT
+ *
+ * Self-configuration for the Mali kbase backend.
+ *
+ * Every tunable below used to be an environment variable a tester had to set
+ * per game, which made a bug report a description of the reporter's
+ * environment instead of the driver.  The values are derived from what
+ * pan_kmod already probes, so the same GPU always gets the same behaviour and
+ * the shipped driver needs no launcher-side environment.
+ */
+
+#ifndef PANVK_KBASE_PROFILE_H
+#define PANVK_KBASE_PROFILE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "kmod/pan_kmod.h"
+#include "pan_props.h"
+
+enum panvk_bc_mode {
+   /* The GPU samples BC natively; no decode is performed. */
+   PANVK_BC_MODE_NATIVE,
+   /* BC is decoded by a compute shader into a linear plane. */
+   PANVK_BC_MODE_COMPUTE,
+   /* BC is decoded by a fragment pass into a compact tiled shadow. */
+   PANVK_BC_MODE_FRAGMENT_SHADOW,
+};
+
+struct panvk_kbase_profile {
+   enum panvk_bc_mode bc_mode;
+
+   /* Keep BC4/BC5/BC6H shadows at 16 bpp instead of the compact format. */
+   bool bc_wide;
+
+   /* Advertise geometry shaders, which the compute-based gpu_prerast path
+    * carries. */
+   bool geometry_shaders;
+
+   uint32_t tiler_chunk_size;
+   uint32_t tiler_initial_chunks;
+   uint32_t tiler_max_chunks;
+   uint32_t heap_renew_interval;
+   uint32_t heap_renew_work;
+
+   /* Wait for same-queue semaphores on the GPU rather than stalling the CPU. */
+   bool gpu_semaphore_waits;
+
+   /* Order the HOST_CACHED memory type before the coherent one. */
+   bool cached_before_coherent;
+
+   /* Expose the WB_MMAP memory type. */
+   bool wb_mmap;
+
+   /* Suppress the CRCs the tiled layout would otherwise maintain. */
+   bool no_crc;
+
+   /* Advertise AFBC for WSI images. */
+   bool wsi_afbc;
+};
+
+/* All ten BC formats, the mask the emulation decision keys on. */
+#define PANVK_BC_NATIVE_MASK 0x1ff80
+
+static inline bool
+panvk_kbase_has_native_bc(const struct pan_kmod_dev_props *props)
+{
+   return (pan_query_compressed_formats(props) & PANVK_BC_NATIVE_MASK) ==
+          PANVK_BC_NATIVE_MASK;
+}
+
+static inline struct panvk_kbase_profile
+panvk_kbase_profile_for(const struct pan_kmod_dev_props *props)
+{
+   const unsigned arch = pan_arch(props->gpu_id);
+   struct panvk_kbase_profile p = {
+      .bc_mode = PANVK_BC_MODE_FRAGMENT_SHADOW,
+      .bc_wide = false,
+      .geometry_shaders = true,
+      .tiler_chunk_size = 1024 * 1024,
+      .tiler_initial_chunks = 10,
+      .tiler_max_chunks = 400,
+      .heap_renew_interval = 128,
+      .heap_renew_work = 65536,
+      .gpu_semaphore_waits = true,
+      .cached_before_coherent = false,
+      .wb_mmap = true,
+      .no_crc = false,
+      .wsi_afbc = true,
+   };
+
+   /* Layered FS rendering starts at v10, so lower arches decode BC through
+    * compute.  Geometry shaders are advertised from v9 on. */
+   if (arch < 10)
+      p.bc_mode = PANVK_BC_MODE_COMPUTE;
+   if (arch < 9)
+      p.geometry_shaders = false;
+
+   /* Where the probe reports every BC format the GPU samples them natively,
+    * so no decode path is selected at all. */
+   if (panvk_kbase_has_native_bc(props))
+      p.bc_mode = PANVK_BC_MODE_NATIVE;
+
+   return p;
+}
+
+static inline bool
+panvk_kbase_bc_fragment_shadow(const struct panvk_kbase_profile *p)
+{
+   return p->bc_mode == PANVK_BC_MODE_FRAGMENT_SHADOW;
+}
+
+static inline bool
+panvk_kbase_bc_emulated(const struct panvk_kbase_profile *p)
+{
+   return p->bc_mode != PANVK_BC_MODE_NATIVE;
+}
+
+#endif /* PANVK_KBASE_PROFILE_H */
