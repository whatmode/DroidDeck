+/* mali-gl: a GPU reached through a non-DRM kernel driver (Arm mali_kbase:
+ * /dev/mali0) has no DRM render node for the compositor to advertise, but
+ * Mesa can still drive GBM/EGL on it.  XWAYLAND_GBM_DEVICE names such a
+ * node; without it /dev/mali0 is used when the compositor gives no usable
+ * DRM device.  The node is then also what DRI3 clients get to open. */
+static const char *
+xwl_gbm_fallback_device(void)
+{
+    const char *path = getenv("XWAYLAND_GBM_DEVICE");
+
+    if (path && *path)
+        return path;
+    if (access("/dev/mali0", R_OK | W_OK) == 0)
+        return "/dev/mali0";
+    return NULL;
+}
+
+static Bool
+xwl_glamor_gbm_init_path(struct xwl_screen *xwl_screen, const char *path)
+{
+    struct xwl_gbm_private *xwl_gbm = xwl_gbm_get(xwl_screen);
+
+    free(xwl_gbm->device_name);
+    xwl_gbm->device_name = strdup(path);
+    if (!xwl_gbm->device_name)
+        return FALSE;
+
+    xwl_gbm->drm_fd = open(xwl_gbm->device_name, O_RDWR | O_CLOEXEC);
+    if (xwl_gbm->drm_fd < 0) {
+        ErrorF("glamor: could not open GBM device %s (%s)\n",
+               xwl_gbm->device_name, strerror(errno));
+        xwl_gbm->drm_fd = 0;
+        return FALSE;
+    }
+
+    /* Not a DRM node: there is no drmDevice to compare tranches against. */
+    if (drmGetDevice2(xwl_gbm->drm_fd, 0, &xwl_gbm->device) != 0)
+        xwl_gbm->device = NULL;
+
+    xwl_gbm->fd_render_node = TRUE;
+    LogMessage(X_INFO, "glamor: using GBM device %s%s\n", xwl_gbm->device_name,
+               xwl_gbm->device ? "" : " (not a DRM node)");
+    return TRUE;
+}
