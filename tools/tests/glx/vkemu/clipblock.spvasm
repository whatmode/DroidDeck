; A vertex shader writing clip and cull distances as members of the gl_PerVertex output block
; (as DXVK does for Unity's shaders): Position, PointSize, ClipDistance[1], CullDistance[1].
; Full-screen triangle; both distances 1.0 (nothing clipped). Also writes the members through
; a pointer to the whole block and through a chain into the array element.
               OpCapability Shader
               OpCapability ClipDistance
               OpCapability CullDistance
               OpMemoryModel Logical GLSL450
               OpEntryPoint Vertex %main "main" %pv %vid
               OpMemberDecorate %PerVertex 0 BuiltIn Position
               OpMemberDecorate %PerVertex 1 BuiltIn PointSize
               OpMemberDecorate %PerVertex 2 BuiltIn ClipDistance
               OpMemberDecorate %PerVertex 3 BuiltIn CullDistance
               OpDecorate %PerVertex Block
               OpDecorate %vid BuiltIn VertexIndex
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
       %bool = OpTypeBool
      %float = OpTypeFloat 32
        %int = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
         %v4 = OpTypeVector %float 4
     %uint_1 = OpConstant %uint 1
       %arr1 = OpTypeArray %float %uint_1
  %PerVertex = OpTypeStruct %v4 %float %arr1 %arr1
 %ptr_out_pv = OpTypePointer Output %PerVertex
 %ptr_out_v4 = OpTypePointer Output %v4
%ptr_out_arr = OpTypePointer Output %arr1
  %ptr_out_f = OpTypePointer Output %float
 %ptr_in_int = OpTypePointer Input %int
         %pv = OpVariable %ptr_out_pv Output
        %vid = OpVariable %ptr_in_int Input
      %int_0 = OpConstant %int 0
      %int_1 = OpConstant %int 1
      %int_2 = OpConstant %int 2
      %int_3 = OpConstant %int 3
       %f_m1 = OpConstant %float -1
        %f_3 = OpConstant %float 3
        %f_0 = OpConstant %float 0
        %f_1 = OpConstant %float 1
       %main = OpFunction %void None %fn
      %entry = OpLabel
          %v = OpLoad %int %vid
        %is1 = OpIEqual %bool %v %int_1
        %is2 = OpIEqual %bool %v %int_2
          %x = OpSelect %float %is1 %f_3 %f_m1
          %y = OpSelect %float %is2 %f_3 %f_m1
          %p = OpCompositeConstruct %v4 %x %y %f_0 %f_1
       %posp = OpAccessChain %ptr_out_v4 %pv %int_0
               OpStore %posp %p
        %psz = OpAccessChain %ptr_out_f %pv %int_1
               OpStore %psz %f_1
         %ca = OpAccessChain %ptr_out_arr %pv %int_2
         %c0 = OpAccessChain %ptr_out_f %ca %int_0
               OpStore %c0 %f_1
         %d0 = OpAccessChain %ptr_out_f %pv %int_3 %int_0
               OpStore %d0 %f_1
               OpReturn
               OpFunctionEnd
