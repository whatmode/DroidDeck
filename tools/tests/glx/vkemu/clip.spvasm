; A vertex shader writing clip and cull distances as standalone built-in variables, the way
; DXVK (dxbc-spirv) emits them. Full-screen triangle; both distances 1.0 (nothing clipped).
               OpCapability Shader
               OpCapability ClipDistance
               OpCapability CullDistance
               OpMemoryModel Logical GLSL450
               OpEntryPoint Vertex %main "main" %pos %clip %cull %vid
               OpDecorate %pos BuiltIn Position
               OpDecorate %clip BuiltIn ClipDistance
               OpDecorate %cull BuiltIn CullDistance
               OpDecorate %vid BuiltIn VertexIndex
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
       %bool = OpTypeBool
      %float = OpTypeFloat 32
        %int = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
         %v4 = OpTypeVector %float 4
     %uint_1 = OpConstant %uint 1
       %arr1 = OpTypeArray %float %uint_1
 %ptr_out_v4 = OpTypePointer Output %v4
%ptr_out_arr = OpTypePointer Output %arr1
  %ptr_out_f = OpTypePointer Output %float
 %ptr_in_int = OpTypePointer Input %int
        %pos = OpVariable %ptr_out_v4 Output
       %clip = OpVariable %ptr_out_arr Output
       %cull = OpVariable %ptr_out_arr Output
        %vid = OpVariable %ptr_in_int Input
      %int_0 = OpConstant %int 0
      %int_1 = OpConstant %int 1
      %int_2 = OpConstant %int 2
       %f_m1 = OpConstant %float -1
        %f_3 = OpConstant %float 3
        %f_0 = OpConstant %float 0
        %f_1 = OpConstant %float 1
       %main = OpFunction %void None %fn
      %entry = OpLabel
          %v = OpLoad %int %vid
        %is1 = OpIEqual %bool %v %int_1
        %is2 = OpIEqual %bool %v %int_2
          %x = OpSelect %float %is1 %f_3 %f_m1
          %y = OpSelect %float %is2 %f_3 %f_m1
          %p = OpCompositeConstruct %v4 %x %y %f_0 %f_1
               OpStore %pos %p
         %c0 = OpAccessChain %ptr_out_f %clip %int_0
               OpStore %c0 %f_1
         %d0 = OpAccessChain %ptr_out_f %cull %int_0
               OpStore %d0 %f_1
               OpReturn
               OpFunctionEnd
