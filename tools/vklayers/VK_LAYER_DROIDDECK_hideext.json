{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_DROIDDECK_hideext",
        "type": "GLOBAL",
        "library_path": "/usr/local/lib/droiddeck-vklayers/libVkLayer_droiddeck_hideext.so",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "Hides the device extensions named in DROIDDECK_HIDE_EXTS so DXVK takes its fallback path; bisects a driver bug by extension",
        "functions": {
            "vkNegotiateLoaderLayerInterfaceVersion": "DroidDeckHideExt_NegotiateLoaderLayerInterfaceVersion"
        },
        "enable_environment": {
            "DROIDDECK_HIDE_EXTS_ENABLE": "1"
        },
        "disable_environment": {
            "DROIDDECK_HIDE_EXTS_DISABLE": "1"
        }
    }
}
