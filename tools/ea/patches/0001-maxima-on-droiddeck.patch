+    pub fn get_cpu_details() -> CpuDetails {
+        let spec = std::env::var("MAXIMA_CPU").unwrap_or_default();
+        let mut parts = spec.splitn(3, '|');
+        let regs: Vec<u32> = parts
+            .next()
+            .unwrap_or("")
+            .split(':')
+            .filter_map(|r| u32::from_str_radix(r.trim().trim_start_matches("0x"), 16).ok())
+            .collect();
+        let manufacturer = parts.next().filter(|s| !s.is_empty()).unwrap_or("GenuineIntel");
+        let brand = parts
+            .next()
+            .filter(|s| !s.is_empty())
+            .unwrap_or("Intel(R) Core(TM) i7-8700K CPU @ 3.70GHz");
+        let flags = if regs.len() == 4 {
+            CpuidResult { eax: regs[0], ebx: regs[1], ecx: regs[2], edx: regs[3] }
+        } else {
+            CpuidResult { eax: 0x000906EA, ebx: 0x00100800, ecx: 0x7FFAFBFF, edx: 0xBFEBFBFF }
+        };
+        let mut brand_name = brand.to_string().into_bytes();
+        brand_name.resize(47, 0);
+        CpuDetails {
+            flags,
+            manufacturer: manufacturer.to_string(),
+            brand_name: String::from_utf8(brand_name).unwrap_or_default(),
+        }
+    }
