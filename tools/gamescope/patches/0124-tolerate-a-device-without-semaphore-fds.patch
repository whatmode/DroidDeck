-	enabledExtensions.push_back( VK_KHR_EXTERNAL_SEMAPHORE_FD_EXTENSION_NAME );
+	{
+		// A remoted driver (Mesa's venus over vtest, which carries the Vulkan of DroidDeck's
+		// Mali bridge) has no semaphore file descriptors. They only back explicit-sync
+		// timelines, which need a DRM render node anyway, so go on without them.
+		uint32_t nExtCount = 0;
+		vk.EnumerateDeviceExtensionProperties( physDev(), nullptr, &nExtCount, nullptr );
+		std::vector<VkExtensionProperties> exts( nExtCount );
+		vk.EnumerateDeviceExtensionProperties( physDev(), nullptr, &nExtCount, exts.data() );
+		s_bExternalSemaphoreFd = false;
+		for ( auto &ext : exts )
+			if ( strcmp( ext.extensionName, VK_KHR_EXTERNAL_SEMAPHORE_FD_EXTENSION_NAME ) == 0 )
+				s_bExternalSemaphoreFd = true;
+		if ( s_bExternalSemaphoreFd )
+			enabledExtensions.push_back( VK_KHR_EXTERNAL_SEMAPHORE_FD_EXTENSION_NAME );
+		else
+			vk_log.infof( "no %s: explicit-sync timelines are unavailable", VK_KHR_EXTERNAL_SEMAPHORE_FD_EXTENSION_NAME );
+	}
 
