/* ---- BC7 (BPTC) ----
 *
 * A port of decompress_rgba_unorm_block() from Mesa's texcompress_bptc_tmp.h, which is what the
 * CPU path runs for BC7: bc_decode_s3tc() and bc_decode_rgtc() do not handle it, so the job falls
 * through to util_format_translate. BC7 substitutes to RGBA8, four bytes a texel, so it shares
 * this shader's one-uint-per-pixel destination and needs no change to the driver's copy path.
 *
 * Mode 0 is reserved; the reference writes zeroes for it. The tables are generated from the same
 * header by gen-bc7-tables.py, because a wrong partition or anchor row reads a plausible wrong
 * texel rather than crashing.
 */

/* extract_bits() walks the block as bytes, so this reads byte n of the 16-byte block. */
uint
bc7_byte(uint base, uint n)
{
   return (src[base + (n >> 2)] >> (8u * (n & 3u))) & 0xffu;
}

uint
bc7_bits(uint base, uint bit_off, uint n_bits)
{
   uint result = 0u, got = 0u;
   uint byte_index = bit_off >> 3;
   uint bit_index = bit_off & 7u;
   uint n_in_byte = min(n_bits, 8u - bit_index);
   while (true) {
      uint b = (bc7_byte(base, byte_index) >> bit_index) & ((1u << n_in_byte) - 1u);
      result |= b << got;
      n_bits -= n_in_byte;
      if (n_bits == 0u)
         return result;
      got += n_in_byte;
      byte_index++;
      bit_index = 0u;
      n_in_byte = min(n_bits, 8u);
   }
}

/* expand_component(): copy the top bits into the unused low bits of a byte. */
uint
bc7_expand(uint v, uint n_bits)
{
   return (v << (8u - n_bits)) | (v >> (2u * n_bits - 8u));
}

/* interpolate(): weights indexed by index width. */
uint
bc7_interp(uint a, uint b, uint index, uint index_bits)
{
   uint w;
   if (index_bits == 2u) {
      uint w2[4] = uint[4](0u, 21u, 43u, 64u);
      w = w2[index];
   } else if (index_bits == 3u) {
      uint w3[8] = uint[8](0u, 9u, 18u, 27u, 37u, 46u, 55u, 64u);
      w = w3[index];
   } else {
      uint w4[16] = uint[16](0u, 4u, 9u, 13u, 17u, 21u, 26u, 30u, 34u, 38u, 43u, 47u,
                            51u, 55u, 60u, 64u);
      w = w4[index];
   }
   return ((64u - w) * a + w * b + 32u) >> 6u;
}

uint
bc7_anchor(uint n_subsets, uint part, uint texel)
{
   if (texel == 0u)
      return 1u;
   if (n_subsets == 1u)
      return 0u;
   if (n_subsets == 2u)
      return BC7_ANCHOR_A[part] == texel ? 1u : 0u;
   return (BC7_ANCHOR_B[part] == texel || BC7_ANCHOR_C[part] == texel) ? 1u : 0u;
}

uint
bc7_anchors_before(uint n_subsets, uint part, uint texel)
{
   uint count = 1u;
   if (texel == 0u)
      return 0u;
   if (n_subsets == 2u) {
      if (texel > BC7_ANCHOR_A[part])
         count++;
   } else if (n_subsets == 3u) {
      if (texel > BC7_ANCHOR_B[part])
         count++;
      if (texel > BC7_ANCHOR_C[part])
         count++;
   }
   return count;
}

/* extract_unorm_endpoints(): colour, then alpha, then the p-bits, then expand to a byte. */
/* Returns the bit offset just past the endpoints, which is where the indices start.  GLSL passes
 * scalars by value, so the caller cannot see bit_off advance inside here. */
uint
bc7_endpoints(uint base, uint bit_off, uint mode, out uint endpoints[6][4])
{
   uint n_subsets = BC7_NSUBSETS[mode];
   uint color_bits = BC7_COLORBITS[mode];
   uint alpha_bits = BC7_ALPHABITS[mode];
   uint ep_pbits = BC7_EPBITS[mode];
   uint shared_pbits = BC7_SHAREDPBITS[mode];
   uint sub, e, comp;

   for (comp = 0u; comp < 3u; comp++)
      for (sub = 0u; sub < n_subsets; sub++)
         for (e = 0u; e < 2u; e++) {
            endpoints[sub * 2u + e][comp] = bc7_bits(base, bit_off, color_bits);
            bit_off += color_bits;
         }

   uint n_comp = 4u;
   if (alpha_bits > 0u) {
      for (sub = 0u; sub < n_subsets; sub++)
         for (e = 0u; e < 2u; e++) {
            endpoints[sub * 2u + e][3] = bc7_bits(base, bit_off, alpha_bits);
            bit_off += alpha_bits;
         }
   } else {
      for (sub = 0u; sub < n_subsets; sub++)
         for (e = 0u; e < 2u; e++)
            endpoints[sub * 2u + e][3] = 255u;
      n_comp = 3u;
   }

   if (ep_pbits != 0u) {
      for (sub = 0u; sub < n_subsets; sub++)
         for (e = 0u; e < 2u; e++) {
            uint pbit = bc7_bits(base, bit_off, 1u);
            bit_off += 1u;
            for (comp = 0u; comp < n_comp; comp++) {
               endpoints[sub * 2u + e][comp] = (endpoints[sub * 2u + e][comp] << 1u) | pbit;
            }
         }
   } else if (shared_pbits != 0u) {
      for (sub = 0u; sub < n_subsets; sub++) {
         uint pbit = bc7_bits(base, bit_off, 1u);
         bit_off += 1u;
         for (e = 0u; e < 2u; e++)
            for (comp = 0u; comp < n_comp; comp++)
               endpoints[sub * 2u + e][comp] =
                  (endpoints[sub * 2u + e][comp] << 1u) | pbit;
      }
   }

   uint expand_bits = color_bits + ep_pbits + shared_pbits;
   for (sub = 0u; sub < n_subsets; sub++)
      for (e = 0u; e < 2u; e++) {
         for (comp = 0u; comp < 3u; comp++)
            endpoints[sub * 2u + e][comp] =
               bc7_expand(endpoints[sub * 2u + e][comp], expand_bits);
         if (alpha_bits > 0u)
            endpoints[sub * 2u + e][3] =
               bc7_expand(endpoints[sub * 2u + e][3], alpha_bits + ep_pbits + shared_pbits);
      }
   return bit_off;
}

void
bc7_block(uint base, uint dst_base, uint bx, uint by)
{
   uint mode_num = 0u;
   for (uint b = 0u; b < 8u; b++)
      if ((bc7_byte(base, 0u) & (1u << b)) != 0u) {
         mode_num = b + 1u;
         break;
      }
   if (mode_num == 0u) {
      /* Mode 0 is reserved.  The reference writes zeroes for the whole block, and the destination
       * is not otherwise initialised, so leaving it alone would put stale bytes on screen. */
      for (uint y = 0u; y < 4u; y++)
         for (uint x = 0u; x < 4u; x++)
            dst[dst_base + (by * 4u + y) * pc.dst_pitch + (bx * 4u + x)] = 0u;
      return;
   }

   uint mode = mode_num - 1u;
   uint n_subsets = BC7_NSUBSETS[mode];
   uint bit_off = mode_num;

   uint part = bc7_bits(base, bit_off, BC7_NPART[mode]);
   bit_off += BC7_NPART[mode];

   uint subsets = n_subsets == 1u ? 0u
                  : (n_subsets == 2u ? BC7_PART1[part] : BC7_PART2[part]);

   uint rotation = 0u;
   if (BC7_ROT[mode] != 0u) {
      rotation = bc7_bits(base, bit_off, 2u);
      bit_off += 2u;
   }
   uint index_selection = 0u;
   if (BC7_IDSEL[mode] != 0u) {
      index_selection = bc7_bits(base, bit_off, 1u);
      bit_off += 1u;
   }

   uint endpoints[6][4];
   bit_off = bc7_endpoints(base, bit_off, mode, endpoints);

   uint n_index_bits = BC7_INDEXBITS[mode];
   uint n_sec = BC7_SECINDEXBITS[mode];

   for (uint y = 0u; y < 4u; y++) {
      for (uint x = 0u; x < 4u; x++) {
         uint texel = x + y * 4u;
         uint before = bc7_anchors_before(n_subsets, part, texel);
         uint bo = bit_off + n_index_bits * texel - before;
         uint sec_off = bit_off + 16u * n_index_bits - n_subsets + n_sec * texel - before;

         uint subset = (subsets >> (texel * 2u)) & 3u;
         uint anchor = bc7_anchor(n_subsets, part, texel);

         uint ibits = anchor != 0u ? n_index_bits - 1u : n_index_bits;
         uint idx0 = bc7_bits(base, bo, ibits);
         uint idx1 = 0u;
         if (n_sec != 0u) {
            ibits = anchor != 0u ? n_sec - 1u : n_sec;
            idx1 = bc7_bits(base, sec_off, ibits);
         }

         uint color_index = index_selection != 0u ? idx1 : idx0;
         uint color_bits = index_selection != 0u ? n_sec : n_index_bits;

         uint rgba[4];
         for (uint comp = 0u; comp < 3u; comp++)
            rgba[comp] = bc7_interp(endpoints[subset * 2u][comp],
                                    endpoints[subset * 2u + 1u][comp],
                                    color_index, color_bits);

         /* Alpha uses the opposite index from the colour components. */
         uint alpha_index, alpha_bits;
         if (n_sec != 0u && index_selection == 0u) {
            alpha_index = idx1;
            alpha_bits = n_sec;
         } else {
            alpha_index = idx0;
            alpha_bits = n_index_bits;
         }
         rgba[3] = bc7_interp(endpoints[subset * 2u][3], endpoints[subset * 2u + 1u][3],
                              alpha_index, alpha_bits);

         if (rotation != 0u) {
            uint r = rotation - 1u;
            uint t = rgba[r];
            rgba[r] = rgba[3];
            rgba[3] = t;
         }

         uint row = (by * 4u + y) * pc.dst_pitch + (bx * 4u + x);
         dst[dst_base + row] = rgba[0] | (rgba[1] << 8) | (rgba[2] << 16) | (rgba[3] << 24);
      }
   }
}

void
main()
{
   uint gid = gl_GlobalInvocationID.x;
   if (gid >= pc.count)
      return;

   uint blk = pc.first + gid;
   uint bx = blk % pc.bw;
   uint by = blk / pc.bw;

   bool is_bc1 = pc.kind <= 1u;
   uint words = is_bc1 ? 2u : 4u;
   /* Source block rows can be padded: the driver's src_row is derived from bufferRowLength when
    * the program gave one, so the row a block sits in is not always bw blocks wide. */
   uint s = pc.src_off + by * pc.src_pitch + bx * words;

   /* BC7 has no fixed field layout, so it decodes the whole block itself. */
   if (pc.kind == 4u) {
      bc7_block(s, pc.dst_off, bx, by);
      return;
   }

   uint w0 = src[s];
   uint w1 = src[s + 1u];

   /* The colour half is the whole block for BC1, and the upper half for BC2/BC3. */
   uint cw = is_bc1 ? w0 : src[s + 2u];
   uint cbits = is_bc1 ? w1 : src[s + 3u];

   uint c0 = cw & 0xffffu;
   uint c1 = cw >> 16;

   /* BC2/BC3 always use four colours; BC1 uses three when color0 <= color1. */
   bool four = !is_bc1 || c0 > c1;

   uvec3 p0 = expand565(c0);
   uvec3 p1 = expand565(c1);
   uvec3 p2 = four ? (p0 * 2u + p1) / 3u : (p0 + p1) / 2u;
   uvec3 p3 = four ? (p0 + p1 * 2u) / 3u : uvec3(0u);

   /* BC1_RGBA in three-colour mode is transparent; BC1_RGB has no alpha. */
   uint c3_alpha = (pc.kind == 1u && !four) ? 0u : 255u;

   /* BC3's alpha palette is the low two bytes of the block; its 48-bit index field is the
    * remaining six, i.e. the top half of w0 followed by w1. */
   uint a0 = w0 & 0xffu;
   uint a1 = (w0 >> 8) & 0xffu;
   uint alo = (w0 >> 16) & 0xffffu; /* index bits 0..15 */
   uint ahi = w1;                  /* index bits 16..47 */

   for (uint j = 0u; j < 4u; j++) {
      for (uint i = 0u; i < 4u; i++) {
         uint t = j * 4u + i;
         uint code = (cbits >> (2u * t)) & 3u;
         uvec3 c = code == 0u ? p0 : code == 1u ? p1 : code == 2u ? p2 : p3;

         uint a;
         if (pc.kind <= 1u)
            a = code == 3u ? c3_alpha : 255u;
         else if (pc.kind == 2u)
            /* BC2: four alpha bits a pixel, in bytes 0..7 (so words 0 and 1). */
            a = (((t < 8u ? w0 : w1) >> (((t & 7u) >> 1) * 8u + (t & 1u) * 4u)) & 0xfu) * 17u;
         else
            a = alpha_pal(a0, a1, bits3(alo, ahi, t));

         uint px = c.x | (c.y << 8) | (c.z << 16) | (a << 24);
         uint row = (by * 4u + j) * pc.dst_pitch + (bx * 4u + i);
         dst[pc.dst_off + row] = px;
      }
   }
}
