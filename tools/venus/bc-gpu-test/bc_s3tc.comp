#version 450
/* DroidDeck: BC block decode on the GPU, S3TC (BC1/BC2/BC3) and BC7 (BPTC).
 *
 * This must match the CPU decoders in vn_droiddeck_bc.c exactly: the CPU path and this shader are
 * two implementations of one contract, and bc-band-test/run.sh records what happens when a copy
 * drifts from the driver. bc-gpu-test/run.sh translates the SPIR-V that actually ships into C++
 * with SPIRV-Cross and runs it against the real decoders, so the two cannot disagree unnoticed.
 *
 * One invocation per 4x4 block. The destination is the RGBA8 image the BC format was substituted
 * with, so a pixel is exactly one uint: R in the low byte, A in the high byte.
 *
 * S3TC block layout, in words (little-endian), matching the byte offsets the CPU decoder uses:
 *   BC1 (8 bytes):  w0 = c0 | c1<<16,  w1 = colour indices
 *   BC2/BC3 (16):   w0 = alpha bytes 0..3, w1 = alpha bytes 4..7,
 *                   w2 = c0 | c1<<16,      w3 = colour indices
 *
 * BC7 is 16 bytes like BC2/BC3 but has no fixed field layout: eight modes, each with its own
 * subset count, endpoint and index widths. Its decode reads the block as bytes, not words.
 */

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer Src { uint src[]; };
layout(set = 0, binding = 1, std430) buffer Dst { uint dst[]; };

/* The job's parameters. A push constant would be simpler, but push constants are state shared
 * between the graphics and compute bind points, and this dispatch is recorded into the program's
 * own command buffer: writing them would corrupt whatever the program pushed and has not re-pushed
 * before its next draw. Descriptor bindings are per bind point, so binding this set for compute
 * cannot disturb the program's graphics bindings. */
layout(set = 0, binding = 2, std430) readonly buffer Params {
   uint kind;      /* 0 BC1_RGB, 1 BC1_RGBA, 2 BC2, 3 BC3, 4 BC7 */
   uint bw;        /* blocks across */
   uint dst_pitch; /* uint stride between destination rows */
   uint dst_off;   /* first destination word of this job */
   uint src_off;   /* first source word of this job */
   uint src_pitch; /* uint stride between source block rows */
   uint first;     /* first block index in this job */
   uint count;     /* number of blocks in this job */
} pc;

/* bc_expand565(), one channel per component. */
uvec3
expand565(uint c)
{
   uint r5 = (c >> 11) & 0x1fu, g6 = (c >> 5) & 0x3fu, b5 = c & 0x1fu;
   return uvec3((r5 << 3) | (r5 >> 2), (g6 << 2) | (g6 >> 4), (b5 << 3) | (b5 >> 2));
}

/* bc_alpha_palette() for the 8-bit a0/a1 of BC3 (and BC4/BC5). */
uint
alpha_pal(uint a0, uint a1, uint c)
{
   if (c == 0u)
      return a0;
   if (c == 1u)
      return a1;
   if (a0 > a1)
      return (a0 * (8u - c) + a1 * (c - 1u)) / 7u;
   if (c < 6u)
      return (a0 * (6u - c) + a1 * (c - 1u)) / 5u;
   return c == 6u ? 0u : 255u;
}

/* Three bits at index t of the 48-bit field the alpha indices live in, held as a 16-bit low
 * word and a 32-bit high one. Spelled out rather than using a 64-bit integer so the shader needs
 * nothing beyond plain uint, which every Mali has.
 *
 * The low word is only 16 bits, so the boundary is at 16 and not at 32: index 5 (bits 15..17) is
 * the first to straddle. Treating lo as a full word makes every index from 5 up read zero, which
 * is a plausible-looking wrong alpha rather than a crash, so it is worth the explicit cases. */
uint
bits3(uint lo, uint hi, uint t)
{
   uint b = 3u * t;
   if (b >= 16u)
      return (hi >> (b - 16u)) & 7u;
   uint v = lo >> b;
   if (b > 13u)
      v |= hi << (16u - b);
   return v & 7u;
}

