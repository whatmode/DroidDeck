+void
+vn_dd_pcache_absorb(struct vn_device *dev, VkPipelineCache app_cache)
+{
+   struct vn_dd_pcache *pc = dev->dd_pcache;
+   if (!pc || app_cache == VK_NULL_HANDLE || app_cache == pc->cache || app_cache == pc->tmp)
+      return;
+   if (vn_MergePipelineCaches(vn_device_to_handle(dev), pc->cache, 1, &app_cache) == VK_SUCCESS)
+      p_atomic_inc(&pc->created);
+}
