+static bool
+pcache_file_changed(const struct vn_dd_pcache *pc, struct stat *st)
+{
+   if (stat(pc->path, st) != 0)
+      return false;
+   return st->st_size != pc->file_size || st->st_mtim.tv_sec != pc->file_mtime.tv_sec ||
+          st->st_mtim.tv_nsec != pc->file_mtime.tv_nsec;
+}
+
+/* the file's data if it is this driver's (the header vn_GetPipelineCacheData wrote: data from
+ * another GPU or driver is dropped), and the file's stamp remembered */
+static void *
+pcache_load(struct vn_device *dev, struct vn_dd_pcache *pc, size_t *size, bool log)
+{
+   struct stat st;
+   const bool have = stat(pc->path, &st) == 0;
+   void *data = pcache_read(pc->path, size);
+   if (have) {
+      pc->file_mtime = st.st_mtim;
+      pc->file_size = st.st_size;
+   }
+   if (!data)
+      return NULL;
+   const uint8_t *uuid = dev->physical_device->base.vk.properties.pipelineCacheUUID;
+   const struct vk_pipeline_cache_header *h = data;
+   if (h->header_size < sizeof(*h) || h->header_size > *size ||
+       h->header_version != VK_PIPELINE_CACHE_HEADER_VERSION_ONE ||
+       memcmp(h->uuid, uuid, VK_UUID_SIZE)) {
+      if (log)
+         vn_droiddeck_log("pipeline cache: %s is for another driver; starting empty", pc->path);
+      free(data);
+      *size = 0;
+      return NULL;
+   }
+   return data;
+}
+
+/* what another process saved since this one last looked, merged in before this one saves over it */
+static bool
+pcache_merge_file(struct vn_device *dev, struct vn_dd_pcache *pc)
+{
+   struct stat st;
+   if (!pcache_file_changed(pc, &st))
+      return false;
+   size_t size = 0;
+   void *data = pcache_load(dev, pc, &size, false);
+   if (!data)
+      return false;
+   VkDevice device = vn_device_to_handle(dev);
+   const VkPipelineCacheCreateInfo ci = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO,
+      .initialDataSize = size,
+      .pInitialData = data,
+   };
+   bool merged = false;
+   if (vn_CreatePipelineCache(device, &ci, NULL, &pc->tmp) == VK_SUCCESS) {
+      merged = vn_MergePipelineCaches(device, pc->cache, 1, &pc->tmp) == VK_SUCCESS;
+      vn_DestroyPipelineCache(device, pc->tmp, NULL);
+      pc->tmp = VK_NULL_HANDLE;
+   }
+   free(data);
+   if (merged)
+      vn_droiddeck_log("pipeline cache: merged %zu bytes another process saved", size);
+   return merged;
+}
