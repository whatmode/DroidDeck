+/* Free the pooled chunks a device owns.  Called before the device goes away, so the pool never
+ * holds a buffer of a destroyed device. */
+void
+vn_dd_bc_device_fini(VkDevice device)
+{
+   simple_mtx_lock(&bc_chunk_pool.lock);
+   unsigned kept = 0;
+   for (unsigned i = 0; i < bc_chunk_pool.count; i++) {
+      if (bc_chunk_pool.entries[i].device == device) {
+         vn_DestroyBuffer(device, bc_chunk_pool.entries[i].chunk.buffer, NULL);
+         vn_FreeMemory(device, bc_chunk_pool.entries[i].chunk.memory, NULL);
+         continue;
+      }
+      bc_chunk_pool.entries[kept++] = bc_chunk_pool.entries[i];
+   }
+   bc_chunk_pool.count = kept;
+   simple_mtx_unlock(&bc_chunk_pool.lock);
+}
