+/* Staging chunks are handed back here on command buffer reset instead of being destroyed, so a
+ * program that uploads BC textures every frame does not allocate and free an 8 MiB dma-heap
+ * buffer per command buffer.  The server's own accounting showed that churn: vkAllocateMemory
+ * peaks at 80 ms a call and over a second per 10 s window while the staging chunks are recycled.
+ * A chunk is only pooled after its command buffer is reset, at which point the copy that read it
+ * has completed, so a pooled chunk is never reused while a copy still reads it.  Entries carry
+ * the device that owns them: a VkBuffer is not valid on another device. */
+#define BC_CHUNK_POOL_MAX 4
+static struct {
+   simple_mtx_t lock;
+   struct {
+      VkDevice device;
+      struct vn_dd_bc_chunk chunk;
+   } entries[BC_CHUNK_POOL_MAX];
+   unsigned count;
+} bc_chunk_pool = { .lock = SIMPLE_MTX_INITIALIZER };
+
+static bool
+bc_chunk_take_pooled(VkDevice device, VkDeviceSize size, struct vn_dd_bc_chunk *out)
+{
+   bool found = false;
+   simple_mtx_lock(&bc_chunk_pool.lock);
+   for (unsigned i = 0; i < bc_chunk_pool.count; i++) {
+      if (bc_chunk_pool.entries[i].device != device || bc_chunk_pool.entries[i].chunk.size < size)
+         continue;
+      *out = bc_chunk_pool.entries[i].chunk;
+      bc_chunk_pool.entries[i] = bc_chunk_pool.entries[--bc_chunk_pool.count];
+      found = true;
+      break;
+   }
+   simple_mtx_unlock(&bc_chunk_pool.lock);
+   if (found)
+      out->used = 0;
+   return found;
+}
+
+static bool
+bc_chunk_put_pooled(VkDevice device, const struct vn_dd_bc_chunk *chunk)
+{
+   bool pooled = false;
+   simple_mtx_lock(&bc_chunk_pool.lock);
+   if (bc_chunk_pool.count < BC_CHUNK_POOL_MAX) {
+      bc_chunk_pool.entries[bc_chunk_pool.count].device = device;
+      bc_chunk_pool.entries[bc_chunk_pool.count].chunk = *chunk;
+      bc_chunk_pool.count++;
+      pooled = true;
+   }
+   simple_mtx_unlock(&bc_chunk_pool.lock);
+   return pooled;
+}
+
 static struct vn_dd_bc_chunk *
 bc_chunk_new(struct vn_device *dev, struct vn_dd_bc_cmd *state, VkDeviceSize size)
 {
    VkDevice device = vn_device_to_handle(dev);
