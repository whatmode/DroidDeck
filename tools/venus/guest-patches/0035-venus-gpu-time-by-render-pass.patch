+
 void
 vn_dd_frame_stats(int64_t present_wait_ns)
 {
    static int64_t last, since;
    static uint64_t frames, wait_total;
    static unsigned reports;
+   /* the frame times of the window, for how even they are: a steady 9 fps and 20 fps with
+    * hitches can have the same average */
+   static float times[4096];
+   static unsigned time_count;
    const int64_t now = os_time_get_nano();
 
+   vn_dd_prof_present();
    mtx_lock(&vn_dd_stats_mutex);
    if (last && now > last) {
       frames++;
       wait_total += present_wait_ns > 0 ? (uint64_t)present_wait_ns : 0;
+      if (time_count < ARRAY_SIZE(times))
+         times[time_count++] = (float)((now - last) / 1e6);
    }
    last = now;
    if (!since)
@@ -332,11 +347,24 @@
    if (now - since >= 10000000000ll) {
       if (frames && ++reports <= 2000) {
          const double span = (double)(now - since);
-         vn_droiddeck_log("frames: %.1f fps (%.2f ms/frame); present GPU wait %.2f ms/frame",
+         float median = 0, p95 = 0, max = 0;
+         unsigned hitches = 0;
+         if (time_count) {
+            qsort(times, time_count, sizeof(times[0]), vn_dd_float_cmp);
+            median = times[time_count / 2];
+            p95 = times[MIN2(time_count - 1, time_count * 95 / 100)];
+            max = times[time_count - 1];
+            for (unsigned i = 0; i < time_count; i++)
+               hitches += times[i] > 2.0f * median && times[i] > 25.0f;
+         }
+         vn_droiddeck_log("frames: %.1f fps (%.2f ms/frame); present GPU wait %.2f ms/frame; "
+                          "frame times median %.1f, 95%% %.1f, max %.1f ms, %u over twice the "
+                          "median",
