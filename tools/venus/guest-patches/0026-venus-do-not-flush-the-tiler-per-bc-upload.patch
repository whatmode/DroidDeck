    /* Pass two: record the dispatches and hand the caller the regions that read the result. */
-   bc_gpu_barrier(cmd_handle);
+   bc_gpu_barrier_before_dispatch(cmd_handle);
    vn_CmdBindPipeline(cmd_handle, VK_PIPELINE_BIND_POINT_COMPUTE, bc_gpu_dev.pipeline);
 
    pidx = 0;
