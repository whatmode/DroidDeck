+
+/* DroidDeck: why a window's swapchain is made again. Each new swapchain starts with blank
+ * images, which shows as flicker; Steam's UI flickered and its window got a new swapchain
+ * every few seconds. First 40 times, then every 200th. */
+#include <stdio.h>
+static void
+droiddeck_kopper_note(const char *why, unsigned w, unsigned h, int mode)
+{
+   static unsigned count;
+   unsigned n = ++count;
+   if (n <= 40 || n % 200 == 0)
+      fprintf(stderr, "droiddeck kopper: new swapchain #%u: %s (%ux%u, present mode %d)\n", n, why, w, h, mode);
+}
+
+static VkResult
+update_swapchain(struct zink_screen *screen, struct kopper_displaytarget *cdt, unsigned w, unsigned h);
+
 static struct kopper_swapchain *
 kopper_CreateSwapchain(struct zink_screen *screen, struct kopper_displaytarget *cdt, unsigned w, unsigned h, VkResult *result)
 {
@@ -597,6 +614,8 @@ kopper_acquire(struct zink_screen *screen, struct zink_resource *res, uint64_t t
       ret = VKSCR(AcquireNextImageKHR)(screen->dev, cdt->swapchain->swapchain, timeout, acquire, VK_NULL_HANDLE, &res->obj->dt_idx);
       if (ret != VK_SUCCESS && ret != VK_SUBOPTIMAL_KHR) {
          if (ret == VK_ERROR_OUT_OF_DATE_KHR) {
+            droiddeck_kopper_note("vkAcquireNextImageKHR said VK_ERROR_OUT_OF_DATE_KHR", res->base.b.width0,
+                                  res->base.b.height0, cdt->present_mode);
             res->obj->new_dt = true;
             continue;
          }
@@ -778,8 +797,11 @@ kopper_present(void *data, void *gdata, int thread_idx)
    swapchain->last_present = cpi->image;
    if (cpi->indefinite_acquire)
       p_atomic_dec(&swapchain->num_acquires);
-   if (error2 == VK_SUBOPTIMAL_KHR && cdt->swapchain == swapchain)
+   if (error2 == VK_SUBOPTIMAL_KHR && cdt->swapchain == swapchain) {
+      droiddeck_kopper_note("vkQueuePresentKHR said VK_SUBOPTIMAL_KHR", cpi->res->base.b.width0,
+                            cpi->res->base.b.height0, cdt->present_mode);
       cpi->res->obj->new_dt = true;
+   }
 
    /* it's illegal to destroy semaphores if they're in use by a cmdbuf.
