+
+/* a game's own device: its databases, in the background, reaped by a thread */
+static void
+pcache_precompile(const char *steam_dir, const char *ddir, const char *uuid_hex)
+{
+   if (!pcache_precompile_enabled())
+      return;
+   const pid_t pid = pcache_precompile_app(steam_dir, ddir, uuid_hex, false);
+   thrd_t reaper;
+   if (pid > 0 && thrd_create(&reaper, pcache_reap, (void *)(intptr_t)pid) == thrd_success)
+      thrd_detach(reaper);
+}
+
+/* ---- every installed game, while Steam is open ----
+ *
+ * The Steam client's UI process draws through this driver too (Zink), from the moment Steam
+ * opens. Its first device starts a thread that goes through steamapps/shadercache/<appid> for
+ * every game Steam has recorded pipelines for and replays them one game after another, so the
+ * pipelines are compiled before Play is pressed -- what a Steam Deck's "Processing Vulkan
+ * shaders" does. One Steam process does it (a lock file with its pid); a game started meanwhile
+ * sees its own replay already running and takes its pipelines as they are saved. */
+struct pcache_library {
+   char root[512];
+   char uuid_hex[2 * VK_UUID_SIZE + 1];
+};
+
+static int
+pcache_library_thread(void *arg)
+{
+   struct pcache_library *lib = arg;
+   char pattern[600];
+   glob_t g = { 0 };
+   snprintf(pattern, sizeof(pattern), "%s/*/fozpipelinesv6", lib->root);
+   glob(pattern, 0, NULL, &g);
+   unsigned started = 0;
+   for (size_t i = 0; i < g.gl_pathc; i++) {
+      char appdir[600], ddir[620];
+      snprintf(appdir, sizeof(appdir), "%s", g.gl_pathv[i]);
+      char *slash = strrchr(appdir, '/');
+      if (!slash)
+         continue;
+      *slash = 0;
+      snprintf(ddir, sizeof(ddir), "%s/droiddeck-venus", appdir);
+      mkdir(ddir, 0755);
+      const pid_t pid = pcache_precompile_app(appdir, ddir, lib->uuid_hex, true);
+      if (pid <= 0)
+         continue;
+      started++;
+      const int64_t t0 = os_time_get_nano();
+      int status = 0;
+      while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+         ;
+      vn_droiddeck_log("precompile: %s finished in %.0f s (exit %d)", appdir,
+                       (os_time_get_nano() - t0) / 1e9,
+                       WIFEXITED(status) ? WEXITSTATUS(status) : -1);
+   }
+   vn_droiddeck_log("precompile: the library is done (%zu game(s) with recorded pipelines, %u replayed)",
+                    g.gl_pathc, started);
+   globfree(&g);
+   free(lib);
+   return 0;
+}
+
+static void
+pcache_precompile_library(struct vn_device *dev)
+{
+   if (!pcache_precompile_enabled())
+      return;
+   char cmd[256] = "";
+   pcache_read_text("/proc/self/cmdline", cmd, sizeof(cmd));
+   if (!strstr(cmd, "steamwebhelper"))
+      return;
+   static int once;
+   if (p_atomic_xchg(&once, 1))
+      return;
+   struct pcache_library *lib = calloc(1, sizeof(*lib));
+   if (!lib)
+      return;
+   const char *home = getenv("HOME");
+   snprintf(lib->root, sizeof(lib->root), "%s/.local/share/Steam/steamapps/shadercache",
+            home && *home ? home : "/root");
+   struct stat st;
+   if (stat(lib->root, &st) != 0 || !S_ISDIR(st.st_mode)) {
+      free(lib);
+      return;
+   }
+   /* one Steam process at a time */
+   char lock[600], text[64];
+   snprintf(lock, sizeof(lock), "%s/droiddeck-precompile.pid", lib->root);
+   if (pcache_read_text(lock, text, sizeof(text))) {
+      char proc[64];
+      snprintf(proc, sizeof(proc), "/proc/%d", atoi(text));
+      if (atoi(text) > 0 && atoi(text) != (int)getpid() && access(proc, F_OK) == 0) {
+         free(lib);
+         return;
+      }
+   }
+   FILE *f = fopen(lock, "we");
+   if (f) {
+      fprintf(f, "%d", (int)getpid());
+      fclose(f);
+   }
+   const uint8_t *uuid = dev->physical_device->base.vk.properties.pipelineCacheUUID;
+   for (int i = 0; i < VK_UUID_SIZE; i++)
+      snprintf(lib->uuid_hex + 2 * i, 3, "%02x", uuid[i]);
+   thrd_t t;
+   if (thrd_create(&t, pcache_library_thread, lib) == thrd_success) {
+      thrd_detach(t);
+      vn_droiddeck_log("precompile: going through the library's recorded pipelines (%s)", lib->root);
+   } else {
+      free(lib);
+   }
 }
 
