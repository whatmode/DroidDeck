+   VN_DD_POOL_SYNC_FAILED, /* ... and refused there */
+};
+void
+vn_dd_stats_descriptor_pool(enum vn_dd_pool_event event);
+
+/* the queue's timing resources, at vkDestroyDevice */
+void
+vn_dd_stats_queue_fini(struct vn_queue *queue);
