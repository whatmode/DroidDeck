+/* DroidDeck: one line per GLX set-up step on stderr, so a display that ends up without GL
+ * says why. DROIDDECK_GLX_QUIET=1 silences it. */
+static void
+droiddeck_glx_log(Display *dpy, const char *f, ...)
+{
+   static int quiet = -1;
+   if (quiet < 0) quiet = debug_get_bool_option("DROIDDECK_GLX_QUIET", false);
+   if (quiet) return;
+   char msg[512];
+   va_list args;
+   va_start(args, f);
+   vsnprintf(msg, sizeof(msg), f, args);
+   va_end(args);
+   fprintf(stderr, "droiddeck glx[%d]: display %p \"%s\": %s\n", (int)getpid(), (void *)dpy,
+           dpy ? DisplayString(dpy) : "?", msg);
+}
