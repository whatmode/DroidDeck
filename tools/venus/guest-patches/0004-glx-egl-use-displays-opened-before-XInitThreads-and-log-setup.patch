+/* DroidDeck: why xcb gets no reply on a display whose Xlib side works. Which object each xcb
+ * entry point comes from (another one than libxcb means the program replaced it), whether a
+ * core request gets a reply, the extension query done by hand, and whether Xlib and xcb
+ * talk over the same socket. */
+#include <dlfcn.h>
+static void
+droiddeck_xcb_report(Display *dpy, xcb_connection_t *c)
+{
+   static const char *names[] = {
+      "XGetXCBConnection", "xcb_send_request", "xcb_send_request64", "xcb_send_request_with_fds64",
+      "xcb_wait_for_reply", "xcb_wait_for_reply64", "xcb_query_extension", "xcb_query_extension_reply",
+      "xcb_get_extension_data", "xcb_prefetch_extension_data", "xcb_glx_query_version",
+      "xcb_glx_query_version_reply", "xcb_take_socket", "xcb_poll_for_reply", NULL,
+   };
+   for (int i = 0; names[i]; i++) {
+      void *p = dlsym(RTLD_DEFAULT, names[i]);
+      Dl_info info;
+      droiddeck_glx_log(dpy, "  %s comes from %s", names[i],
+                        !p ? "(nowhere)" : dladdr(p, &info) && info.dli_fname ? info.dli_fname : "?");
+   }
+   xcb_generic_error_t *e = NULL;
+   xcb_get_input_focus_reply_t *focus = xcb_get_input_focus_reply(c, xcb_get_input_focus(c), &e);
+   droiddeck_glx_log(dpy, "  core request over xcb (GetInputFocus): %s, X error %d", focus ? "reply" : "NO reply",
+                     e ? e->error_code : -1);
+   free(focus);
+   free(e);
+   e = NULL;
+   xcb_query_extension_cookie_t qc = xcb_query_extension(c, 3, "GLX");
+   xcb_query_extension_reply_t *q = xcb_query_extension_reply(c, qc, &e);
+   droiddeck_glx_log(dpy, "  QueryExtension(GLX) by hand over xcb: request %u, %s, present %d, opcode %d, X error %d",
+                     qc.sequence, q ? "reply" : "NO reply", q ? q->present : -1, q ? q->major_opcode : -1,
+                     e ? e->error_code : -1);
+   free(q);
+   free(e);
+   droiddeck_glx_log(dpy, "  socket: xcb %d, Xlib %d; xcb connection %p", xcb_get_file_descriptor(c),
+                     ConnectionNumber(dpy), (void *)c);
+}
