+/* droiddeck (0028): optimal-tiling images in the server's native device-local memory. DXVK takes
+ * the first device-local type for an image, and here that type is host-visible, so every texture
+ * and render target of a game was dma-heap memory the server allocates, zeroes and imports into
+ * the GPU driver -- cached and coherent, which the GPU reaches through the coherency
+ * interconnect, and not the memory the GPU driver lays its own images out in. Lake's GPU time
+ * was 50-65 ms a frame with it. Nothing maps an optimal-tiling image, so when the server offers
+ * native types (dd_native_types), the image's allowed types drop the host-visible ones; images
+ * that cross a process (external memory, DRM modifiers) and linear ones are left alone.
+ * DROIDDECK_VN_IMAGE_NATIVE=0 turns it off. */
+static void
+vn_dd_image_native_bits(const struct vn_physical_device *physical_dev,
+                        VkImageTiling tiling,
+                        VkImageCreateFlags flags,
+                        VkExternalMemoryHandleTypeFlags external,
+                        uint32_t *bits)
+{
+   static int on = -1;
+   if (on < 0) {
+      on = debug_get_bool_option("DROIDDECK_VN_IMAGE_NATIVE", true);
+      if (on)
+         vn_droiddeck_log("images: optimal-tiling images in native device-local memory "
+                          "(types 0x%x; DROIDDECK_VN_IMAGE_NATIVE=0 turns it off)",
+                          physical_dev->dd_native_types);
+   }
+   if (!on || tiling != VK_IMAGE_TILING_OPTIMAL || external ||
+       (flags & (VK_IMAGE_CREATE_SPARSE_BINDING_BIT | VK_IMAGE_CREATE_PROTECTED_BIT)))
+      return;
+   const uint32_t native = *bits & physical_dev->dd_native_types;
+   if (!native)
+      return;
+   const VkPhysicalDeviceMemoryProperties *mp = &physical_dev->memory_properties;
+   uint32_t keep = native;
+   for (uint32_t i = 0; i < mp->memoryTypeCount; i++) {
+      if ((*bits & (1u << i)) &&
+          (mp->memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT))
+         keep |= 1u << i;
+   }
+   *bits &= keep;
+}
