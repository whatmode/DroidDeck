+
+/* VkPhysicalDeviceFeatures members, in order */
+static const char *const vn_dd_core_features[] = {
+   "robustBufferAccess", "fullDrawIndexUint32", "imageCubeArray", "independentBlend",
+   "geometryShader", "tessellationShader", "sampleRateShading", "dualSrcBlend", "logicOp",
+   "multiDrawIndirect", "drawIndirectFirstInstance", "depthClamp", "depthBiasClamp",
+   "fillModeNonSolid", "depthBounds", "wideLines", "largePoints", "alphaToOne", "multiViewport",
+   "samplerAnisotropy", "textureCompressionETC2", "textureCompressionASTC_LDR",
+   "textureCompressionBC", "occlusionQueryPrecise", "pipelineStatisticsQuery",
+   "vertexPipelineStoresAndAtomics", "fragmentStoresAndAtomics",
+   "shaderTessellationAndGeometryPointSize", "shaderImageGatherExtended",
+   "shaderStorageImageExtendedFormats", "shaderStorageImageMultisample",
+   "shaderStorageImageReadWithoutFormat", "shaderStorageImageWriteWithoutFormat",
+   "shaderUniformBufferArrayDynamicIndexing", "shaderSampledImageArrayDynamicIndexing",
+   "shaderStorageBufferArrayDynamicIndexing", "shaderStorageImageArrayDynamicIndexing",
+   "shaderClipDistance", "shaderCullDistance", "shaderFloat64", "shaderInt64", "shaderInt16",
+   "shaderResourceResidency", "shaderResourceMinLod", "sparseBinding", "sparseResidencyBuffer",
+   "sparseResidencyImage2D", "sparseResidencyImage3D", "sparseResidency2Samples",
+   "sparseResidency4Samples", "sparseResidency8Samples", "sparseResidency16Samples",
+   "sparseResidencyAliased", "variableMultisampleRate", "inheritedQueries",
+};
+
 VkResult
 vn_CreateDevice(VkPhysicalDevice physicalDevice,
                 const VkDeviceCreateInfo *pCreateInfo,
                 const VkAllocationCallbacks *pAllocator,
                 VkDevice *pDevice)
 {
+   /* DroidDeck: what the program asked of the GPU and what it got (droiddeck_vulkan.txt) */
+   struct vn_physical_device *pdev = vn_physical_device_from_handle(physicalDevice);
+   char exts[1500] = "", missing[600] = "", feats[600] = "";
+   for (uint32_t i = 0; i < pCreateInfo->enabledExtensionCount; i++) {
+      const char *name = pCreateInfo->ppEnabledExtensionNames[i];
+      size_t len = strlen(exts);
+      snprintf(exts + len, sizeof(exts) - len, "%s%s", i ? " " : "", name);
+      bool found = false;
+      for (int e = 0; e < VK_DEVICE_EXTENSION_COUNT; e++)
+         if (pdev->base.vk.supported_extensions.extensions[e] && !strcmp(vk_device_extensions[e].extensionName, name))
+            found = true;
+      if (!found) {
+         len = strlen(missing);
+         snprintf(missing + len, sizeof(missing) - len, " %s", name);
+      }
+   }
+   const VkPhysicalDeviceFeatures *want = pCreateInfo->pEnabledFeatures;
+   char chain[400] = "";
+   vk_foreach_struct_const(ext, pCreateInfo->pNext) {
+      if (ext->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2)
+         want = &((const VkPhysicalDeviceFeatures2 *)ext)->features;
+      size_t len = strlen(chain);
+      snprintf(chain + len, sizeof(chain) - len, " %s", vk_StructureType_to_str(ext->sType) + 18);
+   }
+   if (want) {
+      VkPhysicalDeviceFeatures have;
+      pdev->base.vk.dispatch_table.GetPhysicalDeviceFeatures(physicalDevice, &have);
+      const VkBool32 *w = (const VkBool32 *)want, *h = (const VkBool32 *)&have;
+      for (unsigned i = 0; i < ARRAY_SIZE(vn_dd_core_features); i++)
+         if (w[i] && !h[i]) {
+            size_t len = strlen(feats);
+            snprintf(feats + len, sizeof(feats) - len, " %s", vn_dd_core_features[i]);
+         }
+   }
+   vn_droiddeck_log("vkCreateDevice on %s: extensions: %s", pdev->base.vk.properties.deviceName,
+                    exts[0] ? exts : "(none)");
+   vn_droiddeck_log("vkCreateDevice: feature structs:%s", chain[0] ? chain : " (none)");
+   if (missing[0] || feats[0])
+      vn_droiddeck_log("vkCreateDevice: asked for what this GPU lacks: extensions:%s; core features:%s",
+                       missing[0] ? missing : " none", feats[0] ? feats : " none");
+   VkResult result = vn_create_device(physicalDevice, pCreateInfo, pAllocator, pDevice);
+   vn_droiddeck_log("vkCreateDevice: %s", result == VK_SUCCESS ? "ok" : vk_Result_to_str(result));
+   return result;
+}
