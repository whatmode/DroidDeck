 VkResult
 vn_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
                   const VkAllocationCallbacks *pAllocator,
                   VkInstance *pInstance)
 {
+   /* DroidDeck: what the program asked for and what it got (droiddeck_vulkan.txt) */
+   const VkApplicationInfo *ai = pCreateInfo->pApplicationInfo;
+   char exts[700] = "";
+   for (uint32_t i = 0; i < pCreateInfo->enabledExtensionCount; i++) {
+      size_t len = strlen(exts);
+      snprintf(exts + len, sizeof(exts) - len, "%s%s", i ? " " : "", pCreateInfo->ppEnabledExtensionNames[i]);
+   }
+   vn_droiddeck_log("vkCreateInstance: app '%s' engine '%s' api %u.%u, %u layer(s), extensions: %s",
+                    ai && ai->pApplicationName ? ai->pApplicationName : "",
+                    ai && ai->pEngineName ? ai->pEngineName : "",
+                    ai ? VK_VERSION_MAJOR(ai->apiVersion) : 1, ai ? VK_VERSION_MINOR(ai->apiVersion) : 0,
+                    pCreateInfo->enabledLayerCount, exts[0] ? exts : "(none)");
+   VkResult result = vn_create_instance(pCreateInfo, pAllocator, pInstance);
+   if (result != VK_SUCCESS) {
+      /* which extension this driver lacks, when that was it */
+      char missing[400] = "";
+      for (uint32_t i = 0; i < pCreateInfo->enabledExtensionCount; i++) {
+         bool found = false;
+         for (int e = 0; e < VK_INSTANCE_EXTENSION_COUNT; e++)
+            if (vn_instance_supported_extensions.extensions[e] &&
+                !strcmp(vk_instance_extensions[e].extensionName, pCreateInfo->ppEnabledExtensionNames[i]))
+               found = true;
+         if (!found) {
+            size_t len = strlen(missing);
+            snprintf(missing + len, sizeof(missing) - len, " %s", pCreateInfo->ppEnabledExtensionNames[i]);
+         }
+      }
+      vn_droiddeck_log("vkCreateInstance FAILED: %s%s%s", vk_Result_to_str(result),
+                       missing[0] ? "; not supported here:" : "", missing);
+   } else {
+      struct vn_instance *instance = vn_instance_from_handle(*pInstance);
+      vn_droiddeck_log("vkCreateInstance: ok%s", instance->renderer ? "" :
+                       " but NO renderer (the bridge's vtest socket did not answer): no GPU will be listed");
+   }
+   return result;
+}
