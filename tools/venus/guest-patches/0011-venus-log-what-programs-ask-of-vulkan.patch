+static FILE *vn_dd_file;
+static mtx_t vn_dd_mutex;
+static char vn_dd_prog[96];
+
+static void
+vn_dd_open_once(void)
+{
+   mtx_init(&vn_dd_mutex, mtx_plain);
+   const char *env = getenv("DROIDDECK_VK_LOG");
+   if (env && !strcmp(env, "0"))
+      return;
+   char path[512];
+   if (env && *env) {
+      snprintf(path, sizeof(path), "%s", env);
+   } else {
+      const char *steam = getenv("STEAM_COMPAT_CLIENT_INSTALL_PATH");
+      const char *home = getenv("HOME");
+      char dir[400];
+      if (steam && *steam)
+         snprintf(dir, sizeof(dir), "%s/logs", steam);
+      else
+         snprintf(dir, sizeof(dir), "%s/.local/share/Steam/logs", home && *home ? home : "/root");
+      struct stat st;
+      if (stat(dir, &st) != 0 || !S_ISDIR(st.st_mode))
+         snprintf(dir, sizeof(dir), "/root/.local/share/Steam/logs");
+      if (stat(dir, &st) != 0 || !S_ISDIR(st.st_mode))
+         return;
+      snprintf(path, sizeof(path), "%s/droiddeck_vulkan.txt", dir);
+   }
+   struct stat st;
+   bool big = stat(path, &st) == 0 && st.st_size > 4 * 1024 * 1024;
+   vn_dd_file = fopen(path, big ? "w" : "a");
+   /* the program: its command line's first two words (Wine: the .exe) */
+   FILE *c = fopen("/proc/self/cmdline", "r");
+   if (c) {
+      char buf[512];
+      size_t n = fread(buf, 1, sizeof(buf) - 1, c);
+      fclose(c);
+      buf[n] = 0;
+      const char *a0 = buf, *a1 = n > strlen(buf) + 1 ? buf + strlen(buf) + 1 : "";
+      const char *b0 = strrchr(a0, '/');
+      const char *b1 = strrchr(a1, '\\') ? strrchr(a1, '\\') : strrchr(a1, '/');
+      snprintf(vn_dd_prog, sizeof(vn_dd_prog), "%s%s%s", b0 ? b0 + 1 : a0, *a1 ? " " : "",
+               b1 ? b1 + 1 : a1);
+   }
+}
+
+void
+vn_droiddeck_log(const char *format, ...)
+{
+   static once_flag once = ONCE_FLAG_INIT;
+   static unsigned lines;
+   call_once(&once, vn_dd_open_once);
+   if (!vn_dd_file)
+      return;
+   char msg[1024];
+   va_list ap;
+   va_start(ap, format);
+   vsnprintf(msg, sizeof(msg), format, ap);
+   va_end(ap);
+   mtx_lock(&vn_dd_mutex);
+   if (++lines <= 600) {
+      struct timespec ts;
+      clock_gettime(CLOCK_REALTIME, &ts);
+      struct tm tm;
+      localtime_r(&ts.tv_sec, &tm);
+      fprintf(vn_dd_file, "%02d:%02d:%02d.%03ld [%d %s] %s\n", tm.tm_hour, tm.tm_min, tm.tm_sec,
+              ts.tv_nsec / 1000000, (int)getpid(), vn_dd_prog, msg);
+      fflush(vn_dd_file);
+   }
+   mtx_unlock(&vn_dd_mutex);
+}
+
 void
 vn_log(struct vn_instance *instance, const char *format, ...)
 {
    va_list ap;
 
    va_start(ap, format);
+   char msg[1024];
+   va_list ap2;
+   va_copy(ap2, ap);
+   vsnprintf(msg, sizeof(msg), format, ap2);
+   va_end(ap2);
+   vn_droiddeck_log("venus: %s", msg);
    mesa_log_v(MESA_LOG_DEBUG, "MESA-VIRTIO", format, ap);
    va_end(ap);
 
@@ -113,7 +198,11 @@
               VkResult result,
               const char *where)
 {
-   vn_log(instance, "%s: %s", where, vk_Result_to_str(result));
+   /* image format queries answer "not supported" by the hundred: not for the file */
+   if (result == VK_ERROR_FORMAT_NOT_SUPPORTED)
+      mesa_log(MESA_LOG_DEBUG, "MESA-VIRTIO", "%s: %s", where, vk_Result_to_str(result));
+   else
+      vn_log(instance, "%s: %s", where, vk_Result_to_str(result));
    return result;
 }
 
