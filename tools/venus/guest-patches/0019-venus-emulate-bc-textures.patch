diff -ruN a/src/virtio/vulkan/vn_droiddeck_bc.c b/src/virtio/vulkan/vn_droiddeck_bc.c
new file mode 100644
--- /dev/null
+++ b/src/virtio/vulkan/vn_droiddeck_bc.c
@@ -0,0 +1,596 @@
+/*
+ * DroidDeck: BC compressed textures on a GPU without them (see the header).
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vn_droiddeck_bc.h"
+
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/format/u_format.h"
+#include "util/simple_mtx.h"
+#include "util/u_atomic.h"
+#include "util/os_time.h"
+#include "util/u_dynarray.h"
+#include "util/u_math.h"
+#include "vk_format.h"
+#include "vk_util.h"
+
+#include "vn_buffer.h"
+#include "vn_command_buffer.h"
+#include "vn_device.h"
+#include "vn_device_memory.h"
+#include "vn_droiddeck_emu.h"
+#include "vn_image.h"
+#include "vn_physical_device.h"
+#include "vn_renderer.h"
+
+static VkFormat
+bc_sub(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_BC1_RGB_UNORM_BLOCK:
+   case VK_FORMAT_BC1_RGBA_UNORM_BLOCK:
+   case VK_FORMAT_BC2_UNORM_BLOCK:
+   case VK_FORMAT_BC3_UNORM_BLOCK:
+   case VK_FORMAT_BC7_UNORM_BLOCK:
+      return VK_FORMAT_R8G8B8A8_UNORM;
+   case VK_FORMAT_BC1_RGB_SRGB_BLOCK:
+   case VK_FORMAT_BC1_RGBA_SRGB_BLOCK:
+   case VK_FORMAT_BC2_SRGB_BLOCK:
+   case VK_FORMAT_BC3_SRGB_BLOCK:
+   case VK_FORMAT_BC7_SRGB_BLOCK:
+      return VK_FORMAT_R8G8B8A8_SRGB;
+   case VK_FORMAT_BC4_UNORM_BLOCK:
+      return VK_FORMAT_R8_UNORM;
+   case VK_FORMAT_BC4_SNORM_BLOCK:
+      return VK_FORMAT_R8_SNORM;
+   case VK_FORMAT_BC5_UNORM_BLOCK:
+      return VK_FORMAT_R8G8_UNORM;
+   case VK_FORMAT_BC5_SNORM_BLOCK:
+      return VK_FORMAT_R8G8_SNORM;
+   case VK_FORMAT_BC6H_UFLOAT_BLOCK:
+   case VK_FORMAT_BC6H_SFLOAT_BLOCK:
+      return VK_FORMAT_R16G16B16A16_SFLOAT;
+   default:
+      return VK_FORMAT_UNDEFINED;
+   }
+}
+
+static uint32_t
+bc_block_bytes(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_BC1_RGB_UNORM_BLOCK:
+   case VK_FORMAT_BC1_RGBA_UNORM_BLOCK:
+   case VK_FORMAT_BC1_RGB_SRGB_BLOCK:
+   case VK_FORMAT_BC1_RGBA_SRGB_BLOCK:
+   case VK_FORMAT_BC4_UNORM_BLOCK:
+   case VK_FORMAT_BC4_SNORM_BLOCK:
+      return 8;
+   default:
+      return 16;
+   }
+}
+
+VkFormat
+vn_dd_bc_substitute(const struct vn_physical_device *physical_dev, VkFormat format)
+{
+   if (!physical_dev || !(physical_dev->dd_emu & VN_DD_EMU_BC))
+      return VK_FORMAT_UNDEFINED;
+   return bc_sub(format);
+}
+
+/* ---- statistics, every 10 s in droiddeck_vulkan.txt while they change ---- */
+
+static simple_mtx_t bc_stats_lock = SIMPLE_MTX_INITIALIZER;
+static struct {
+   uint64_t images, copies, regions, bytes_in, bytes_out, decode_ns, dropped, missing_src;
+   int64_t since;
+   unsigned reports;
+} bc_stats;
+
+static void
+bc_stats_add(uint64_t images, uint64_t copies, uint64_t regions, uint64_t bytes_in,
+             uint64_t bytes_out, uint64_t decode_ns, uint64_t dropped, uint64_t missing_src)
+{
+   simple_mtx_lock(&bc_stats_lock);
+   bc_stats.images += images;
+   bc_stats.copies += copies;
+   bc_stats.regions += regions;
+   bc_stats.bytes_in += bytes_in;
+   bc_stats.bytes_out += bytes_out;
+   bc_stats.decode_ns += decode_ns;
+   bc_stats.dropped += dropped;
+   bc_stats.missing_src += missing_src;
+   const int64_t now = os_time_get_nano();
+   if (!bc_stats.since)
+      bc_stats.since = now;
+   const bool first = images && bc_stats.images == images && !bc_stats.reports;
+   if (first || now - bc_stats.since >= 10000000000ll) {
+      if (bc_stats.reports++ < 200)
+         vn_droiddeck_log("BC textures emulated over %.1f s: %" PRIu64 " images made, %" PRIu64
+                          " uploads (%" PRIu64 " regions) decoded, %.1f MiB compressed -> %.1f MiB, "
+                          "%.1f ms decoding; %" PRIu64 " copies left out, %" PRIu64
+                          " uploads from memory the driver cannot read",
+                          (now - bc_stats.since) / 1e9, bc_stats.images, bc_stats.copies,
+                          bc_stats.regions, bc_stats.bytes_in / 1048576.0,
+                          bc_stats.bytes_out / 1048576.0, bc_stats.decode_ns / 1e6,
+                          bc_stats.dropped, bc_stats.missing_src);
+      memset(&bc_stats, 0, sizeof(bc_stats));
+      bc_stats.since = now;
+      bc_stats.reports = 1;
+   }
+   simple_mtx_unlock(&bc_stats_lock);
+}
+
+static void
+bc_log_once(int *flag, const char *what)
+{
+   if (!p_atomic_xchg(flag, 1))
+      vn_droiddeck_log("BC textures: %s", what);
+}
+
+/* ---- formats ---- */
+
+void
+vn_dd_bc_fix_format_properties(VkFormatProperties2 *props)
+{
+   const VkFormatFeatureFlags keep =
+      VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT |
+      VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_MINMAX_BIT | VK_FORMAT_FEATURE_TRANSFER_SRC_BIT |
+      VK_FORMAT_FEATURE_TRANSFER_DST_BIT | VK_FORMAT_FEATURE_BLIT_SRC_BIT;
+   props->formatProperties.optimalTilingFeatures &= keep;
+   props->formatProperties.linearTilingFeatures = 0;
+   props->formatProperties.bufferFeatures = 0;
+   VkFormatProperties3 *props3 =
+      vk_find_struct(props->pNext, FORMAT_PROPERTIES_3);
+   if (props3) {
+      const VkFormatFeatureFlags2 keep2 =
+         VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_FILTER_LINEAR_BIT |
+         VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_FILTER_MINMAX_BIT | VK_FORMAT_FEATURE_2_TRANSFER_SRC_BIT |
+         VK_FORMAT_FEATURE_2_TRANSFER_DST_BIT | VK_FORMAT_FEATURE_2_BLIT_SRC_BIT;
+      props3->optimalTilingFeatures &= keep2;
+      props3->linearTilingFeatures = 0;
+      props3->bufferFeatures = 0;
+   }
+}
+
+/* a format list in the chain: BC formats become their substitutes; an emulated image keeps
+ * only those (its other formats cannot view the uncompressed data) */
+static void
+bc_fix_list(const void *chain, bool image_is_bc, struct vn_dd_bc_fix *fix)
+{
+   VkImageFormatListCreateInfo *list =
+      (VkImageFormatListCreateInfo *)vk_find_struct_const(chain, IMAGE_FORMAT_LIST_CREATE_INFO);
+   if (!list || !list->viewFormatCount)
+      return;
+   bool has_bc = false;
+   for (uint32_t i = 0; i < list->viewFormatCount; i++)
+      has_bc |= bc_sub(list->pViewFormats[i]) != VK_FORMAT_UNDEFINED;
+   if (!has_bc && !image_is_bc)
+      return;
+   uint32_t n = 0;
+   for (uint32_t i = 0; i < list->viewFormatCount && n < ARRAY_SIZE(fix->formats); i++) {
+      VkFormat f = list->pViewFormats[i];
+      const VkFormat sub = bc_sub(f);
+      if (sub)
+         f = sub;
+      else if (image_is_bc)
+         continue;
+      bool dup = false;
+      for (uint32_t j = 0; j < n; j++)
+         dup |= fix->formats[j] == f;
+      if (!dup)
+         fix->formats[n++] = f;
+   }
+   fix->list = list;
+   fix->list_formats = list->pViewFormats;
+   fix->list_count = list->viewFormatCount;
+   list->pViewFormats = fix->formats;
+   list->viewFormatCount = n;
+}
+
+static bool
+bc_chain_has_bc_list(const void *chain)
+{
+   const VkImageFormatListCreateInfo *list =
+      vk_find_struct_const(chain, IMAGE_FORMAT_LIST_CREATE_INFO);
+   if (!list)
+      return false;
+   for (uint32_t i = 0; i < list->viewFormatCount; i++) {
+      if (bc_sub(list->pViewFormats[i]))
+         return true;
+   }
+   return false;
+}
+
+const VkImageCreateInfo *
+vn_dd_bc_image_info_begin(const struct vn_physical_device *physical_dev,
+                          const VkImageCreateInfo *info,
+                          VkImageCreateInfo *local,
+                          struct vn_dd_bc_fix *fix)
+{
+   memset(fix, 0, sizeof(*fix));
+   if (!physical_dev || !(physical_dev->dd_emu & VN_DD_EMU_BC))
+      return info;
+   const VkFormat sub = bc_sub(info->format);
+   if (!sub && !bc_chain_has_bc_list(info->pNext))
+      return info;
+   *local = *info;
+   if (sub) {
+      fix->orig = info->format;
+      local->format = sub;
+      local->flags &= ~VK_IMAGE_CREATE_BLOCK_TEXEL_VIEW_COMPATIBLE_BIT;
+   }
+   bc_fix_list(info->pNext, sub != VK_FORMAT_UNDEFINED, fix);
+   return local;
+}
+
+const VkPhysicalDeviceImageFormatInfo2 *
+vn_dd_bc_format_info_begin(const struct vn_physical_device *physical_dev,
+                           const VkPhysicalDeviceImageFormatInfo2 *info,
+                           VkPhysicalDeviceImageFormatInfo2 *local,
+                           struct vn_dd_bc_fix *fix)
+{
+   memset(fix, 0, sizeof(*fix));
+   if (!physical_dev || !(physical_dev->dd_emu & VN_DD_EMU_BC))
+      return info;
+   const VkFormat sub = bc_sub(info->format);
+   if (!sub && !bc_chain_has_bc_list(info->pNext))
+      return info;
+   *local = *info;
+   if (sub) {
+      fix->orig = info->format;
+      local->format = sub;
+      local->flags &= ~VK_IMAGE_CREATE_BLOCK_TEXEL_VIEW_COMPATIBLE_BIT;
+   }
+   bc_fix_list(info->pNext, sub != VK_FORMAT_UNDEFINED, fix);
+   return local;
+}
+
+void
+vn_dd_bc_info_end(struct vn_dd_bc_fix *fix)
+{
+   if (fix->list) {
+      fix->list->pViewFormats = fix->list_formats;
+      fix->list->viewFormatCount = fix->list_count;
+      fix->list = NULL;
+   }
+}
+
+void
+vn_dd_bc_image_created(VkImage image, VkFormat orig)
+{
+   struct vn_image *img = vn_image_from_handle(image);
+   if (!img || !orig)
+      return;
+   img->dd_bc_format = orig;
+   bc_stats_add(1, 0, 0, 0, 0, 0, 0, 0);
+}
+
+VkFormat
+vn_dd_bc_view_format(VkImage image, VkFormat format)
+{
+   struct vn_image *img = vn_image_from_handle(image);
+   if (!img || !img->dd_bc_format)
+      return format;
+   const VkFormat sub = bc_sub(format);
+   if (sub)
+      return sub;
+   static int logged;
+   bc_log_once(&logged, "a view of a BC image in an uncompressed format (block view) shows "
+                        "the decoded texels instead");
+   return img->base.vk.format;
+}
+
+/* ---- uploads ---- */
+
+struct vn_dd_bc_chunk {
+   VkBuffer buffer;
+   VkDeviceMemory memory;
+   uint8_t *ptr;
+   VkDeviceSize size, used;
+};
+
+struct vn_dd_bc_job {
+   VkBuffer src;
+   VkDeviceSize src_offset; /* in the source buffer */
+   VkDeviceSize src_row, src_slice;
+   uint32_t slices;
+   uint32_t width, height; /* in texels, multiples of 4 */
+   enum pipe_format src_format, dst_format;
+   uint8_t *dst;
+   uint32_t dst_row;
+   VkDeviceSize dst_slice;
+};
+
+struct vn_dd_bc_cmd {
+   struct util_dynarray chunks; /* struct vn_dd_bc_chunk */
+   struct util_dynarray jobs;   /* struct vn_dd_bc_job */
+};
+
+static struct vn_dd_bc_chunk *
+bc_chunk_new(struct vn_device *dev, struct vn_dd_bc_cmd *state, VkDeviceSize size)
+{
+   VkDevice device = vn_device_to_handle(dev);
+   struct vn_dd_bc_chunk chunk = { .size = size };
+   const VkBufferCreateInfo bci = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = size,
+      .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   if (vn_CreateBuffer(device, &bci, NULL, &chunk.buffer) != VK_SUCCESS)
+      return NULL;
+   const VkBufferMemoryRequirementsInfo2 rqi = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_REQUIREMENTS_INFO_2,
+      .buffer = chunk.buffer,
+   };
+   VkMemoryRequirements2 req = { .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2 };
+   vn_GetBufferMemoryRequirements2(device, &rqi, &req);
+   const VkPhysicalDeviceMemoryProperties *mp = &dev->physical_device->memory_properties;
+   const VkMemoryPropertyFlags want =
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   uint32_t type = UINT32_MAX;
+   for (uint32_t i = 0; i < mp->memoryTypeCount && type == UINT32_MAX; i++) {
+      if ((req.memoryRequirements.memoryTypeBits & (1u << i)) &&
+          (mp->memoryTypes[i].propertyFlags & want) == want)
+         type = i;
+   }
+   if (type == UINT32_MAX)
+      goto fail_buffer;
+   const VkMemoryAllocateInfo mai = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = req.memoryRequirements.size,
+      .memoryTypeIndex = type,
+   };
+   if (vn_AllocateMemory(device, &mai, NULL, &chunk.memory) != VK_SUCCESS)
+      goto fail_buffer;
+   const VkBindBufferMemoryInfo bind = {
+      .sType = VK_STRUCTURE_TYPE_BIND_BUFFER_MEMORY_INFO,
+      .buffer = chunk.buffer,
+      .memory = chunk.memory,
+   };
+   vn_BindBufferMemory2(device, 1, &bind);
+   const VkMemoryMapInfo map = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_MAP_INFO,
+      .memory = chunk.memory,
+      .size = VK_WHOLE_SIZE,
+   };
+   void *ptr = NULL;
+   if (vn_MapMemory2(device, &map, &ptr) != VK_SUCCESS || !ptr)
+      goto fail_memory;
+   chunk.ptr = ptr;
+   util_dynarray_append(&state->chunks, struct vn_dd_bc_chunk, chunk);
+   return util_dynarray_top_ptr(&state->chunks, struct vn_dd_bc_chunk);
+
+fail_memory:
+   vn_FreeMemory(device, chunk.memory, NULL);
+fail_buffer:
+   vn_DestroyBuffer(device, chunk.buffer, NULL);
+   return NULL;
+}
+
+void
+vn_dd_bc_cmd_reset(struct vn_command_buffer *cmd)
+{
+   struct vn_dd_bc_cmd *state = cmd->dd_bc;
+   if (!state)
+      return;
+   struct vn_device *dev = vn_device_from_vk(cmd->base.vk.pool->base.device);
+   VkDevice device = vn_device_to_handle(dev);
+   util_dynarray_foreach(&state->chunks, struct vn_dd_bc_chunk, chunk) {
+      vn_DestroyBuffer(device, chunk->buffer, NULL);
+      vn_FreeMemory(device, chunk->memory, NULL);
+   }
+   util_dynarray_fini(&state->chunks);
+   util_dynarray_fini(&state->jobs);
+   free(state);
+   cmd->dd_bc = NULL;
+}
+
+bool
+vn_dd_bc_copy_begin(VkCommandBuffer cmd_handle,
+                    VkBuffer src,
+                    VkImage dst,
+                    uint32_t count,
+                    const VkBufferImageCopy *regions,
+                    const VkBufferImageCopy2 *regions2,
+                    struct vn_dd_bc_copy *copy)
+{
+   struct vn_image *img = vn_image_from_handle(dst);
+   memset(copy, 0, sizeof(*copy));
+   if (!img || !img->dd_bc_format || !count)
+      return false;
+   struct vn_command_buffer *cmd = vn_command_buffer_from_handle(cmd_handle);
+   struct vn_device *dev = vn_device_from_vk(cmd->base.vk.pool->base.device);
+   const VkFormat orig = img->dd_bc_format;
+   const VkFormat sub = img->base.vk.format;
+   const uint32_t block = bc_block_bytes(orig);
+   const enum pipe_format src_format = util_format_linear(vk_format_to_pipe_format(orig));
+   const enum pipe_format dst_format = util_format_linear(vk_format_to_pipe_format(sub));
+   const uint32_t texel = util_format_get_blocksize(dst_format);
+
+   copy->regions = malloc(count * sizeof(*copy->regions));
+   if (!copy->regions)
+      return false;
+   VkDeviceSize total = 0;
+   for (uint32_t i = 0; i < count; i++) {
+      const VkExtent3D e = regions ? regions[i].imageExtent : regions2[i].imageExtent;
+      const uint32_t layers = regions ? regions[i].imageSubresource.layerCount
+                                      : regions2[i].imageSubresource.layerCount;
+      total += align64(align(e.width, 4) * (VkDeviceSize)align(e.height, 4) * texel * e.depth *
+                          MAX2(layers, 1), 16);
+   }
+
+   if (!cmd->dd_bc) {
+      cmd->dd_bc = calloc(1, sizeof(*cmd->dd_bc));
+      if (!cmd->dd_bc)
+         goto fail;
+      util_dynarray_init(&cmd->dd_bc->chunks, NULL);
+      util_dynarray_init(&cmd->dd_bc->jobs, NULL);
+   }
+   struct vn_dd_bc_cmd *state = cmd->dd_bc;
+   struct vn_dd_bc_chunk *chunk = util_dynarray_num_elements(&state->chunks, struct vn_dd_bc_chunk)
+                                     ? util_dynarray_top_ptr(&state->chunks, struct vn_dd_bc_chunk)
+                                     : NULL;
+   if (!chunk || chunk->size - chunk->used < total)
+      chunk = bc_chunk_new(dev, state, MAX2(total, 8ull << 20));
+   if (!chunk)
+      goto fail;
+
+   uint64_t bytes_in = 0, bytes_out = 0;
+   for (uint32_t i = 0; i < count; i++) {
+      VkBufferImageCopy r;
+      if (regions) {
+         r = regions[i];
+      } else {
+         r = (VkBufferImageCopy){
+            .bufferOffset = regions2[i].bufferOffset,
+            .bufferRowLength = regions2[i].bufferRowLength,
+            .bufferImageHeight = regions2[i].bufferImageHeight,
+            .imageSubresource = regions2[i].imageSubresource,
+            .imageOffset = regions2[i].imageOffset,
+            .imageExtent = regions2[i].imageExtent,
+         };
+      }
+      const uint32_t layers = MAX2(r.imageSubresource.layerCount, 1);
+      const uint32_t w4 = align(r.imageExtent.width, 4), h4 = align(r.imageExtent.height, 4);
+      const uint32_t row_texels = r.bufferRowLength ? r.bufferRowLength : r.imageExtent.width;
+      const uint32_t height_texels = r.bufferImageHeight ? r.bufferImageHeight : r.imageExtent.height;
+      struct vn_dd_bc_job job = {
+         .src = src,
+         .src_offset = r.bufferOffset,
+         .src_row = (VkDeviceSize)DIV_ROUND_UP(row_texels, 4) * block,
+         .slices = r.imageExtent.depth * layers,
+         .width = w4,
+         .height = h4,
+         .src_format = src_format,
+         .dst_format = dst_format,
+         .dst = chunk->ptr + chunk->used,
+         .dst_row = w4 * texel,
+      };
+      job.src_slice = job.src_row * DIV_ROUND_UP(height_texels, 4);
+      job.dst_slice = (VkDeviceSize)job.dst_row * h4;
+      util_dynarray_append(&state->jobs, struct vn_dd_bc_job, job);
+      bytes_in += job.src_slice * job.slices;
+      bytes_out += job.dst_slice * job.slices;
+
+      r.bufferOffset = chunk->used;
+      r.bufferRowLength = w4;
+      r.bufferImageHeight = h4;
+      copy->regions[i] = r;
+      chunk->used += align64(job.dst_slice * job.slices, 16);
+   }
+   copy->staging = chunk->buffer;
+   copy->count = count;
+   bc_stats_add(0, 1, count, bytes_in, bytes_out, 0, 0, 0);
+   return true;
+
+fail:
+   free(copy->regions);
+   copy->regions = NULL;
+   {
+      static int logged;
+      bc_log_once(&logged, "no staging memory for a BC upload: the texture stays empty");
+   }
+   /* leave the copy out: the program's compressed bytes do not fit the image */
+   copy->count = 0;
+   return true;
+}
+
+void
+vn_dd_bc_copy_end(struct vn_dd_bc_copy *copy)
+{
+   free(copy->regions);
+   copy->regions = NULL;
+}
+
+bool
+vn_dd_bc_drop_image_copy(VkImage src, VkImage dst)
+{
+   struct vn_image *s = vn_image_from_handle(src), *d = vn_image_from_handle(dst);
+   const bool sb = s && s->dd_bc_format, db = d && d->dd_bc_format;
+   if (sb == db)
+      return false;
+   static int logged;
+   bc_log_once(&logged, "a copy between a BC image and an uncompressed one is left out");
+   bc_stats_add(0, 0, 0, 0, 0, 0, 1, 0);
+   return true;
+}
+
+bool
+vn_dd_bc_drop_image_to_buffer(VkImage src)
+{
+   struct vn_image *s = vn_image_from_handle(src);
+   if (!s || !s->dd_bc_format)
+      return false;
+   static int logged;
+   bc_log_once(&logged, "a BC image read back to a buffer is left out");
+   bc_stats_add(0, 0, 0, 0, 0, 0, 1, 0);
+   return true;
+}
+
+void
+vn_dd_bc_buffer_bound(const VkBindBufferMemoryInfo *bind)
+{
+   struct vn_buffer *buf = vn_buffer_from_handle(bind->buffer);
+   if (!buf)
+      return;
+   buf->dd_memory = bind->memory;
+   buf->dd_memory_offset = bind->memoryOffset;
+}
+
+static void
+bc_decode_cmd(struct vn_command_buffer *cmd)
+{
+   struct vn_dd_bc_cmd *state = cmd->dd_bc;
+   if (!state || !util_dynarray_num_elements(&state->jobs, struct vn_dd_bc_job))
+      return;
+   struct vn_device *dev = vn_device_from_vk(cmd->base.vk.pool->base.device);
+   const int64_t start = os_time_get_nano();
+   uint64_t missing = 0;
+   util_dynarray_foreach(&state->jobs, struct vn_dd_bc_job, job) {
+      struct vn_buffer *buf = vn_buffer_from_handle(job->src);
+      struct vn_device_memory *mem = buf ? vn_device_memory_from_handle(buf->dd_memory) : NULL;
+      const uint8_t *base = mem && mem->base_bo ? vn_renderer_bo_map(dev->renderer, mem->base_bo) : NULL;
+      const VkDeviceSize start_off = buf ? buf->dd_memory_offset + job->src_offset : 0;
+      const VkDeviceSize need = job->src_slice * job->slices;
+      if (!base || start_off + need > mem->base.vk.size) {
+         missing++;
+         continue;
+      }
+      for (uint32_t s = 0; s < job->slices; s++) {
+         util_format_translate(job->dst_format, job->dst + s * job->dst_slice, job->dst_row, 0, 0,
+                               job->src_format, base + start_off + s * job->src_slice,
+                               (unsigned)job->src_row, 0, 0, job->width, job->height);
+      }
+   }
+   if (missing) {
+      static int logged;
+      bc_log_once(&logged, "a BC upload from memory the driver has not mapped: that texture stays empty");
+   }
+   bc_stats_add(0, 0, 0, 0, 0, os_time_get_nano() - start, 0, missing);
+}
+
+void
+vn_dd_bc_submit(uint32_t batch_count,
+                const VkSubmitInfo *batches,
+                const VkSubmitInfo2 *batches2)
+{
+   if (!(vn_dd_emu_global & VN_DD_EMU_BC))
+      return;
+   for (uint32_t i = 0; i < batch_count; i++) {
+      const uint32_t n = batches ? batches[i].commandBufferCount : batches2[i].commandBufferInfoCount;
+      for (uint32_t j = 0; j < n; j++) {
+         VkCommandBuffer h = batches ? batches[i].pCommandBuffers[j]
+                                     : batches2[i].pCommandBufferInfos[j].commandBuffer;
+         struct vn_command_buffer *cmd = vn_command_buffer_from_handle(h);
+         if (cmd)
+            bc_decode_cmd(cmd);
+      }
+   }
+}
