diff -ruN a/src/virtio/vulkan/vn_instance.c b/src/virtio/vulkan/vn_instance.c
--- a/src/virtio/vulkan/vn_instance.c	2026-10-30 22:10:20.156938619 +0000
+++ b/src/virtio/vulkan/vn_instance.c	2026-10-30 22:10:26.804830438 +0000
@@ -15,6 +15,8 @@
 #include "vk_enum_to_str.h"
 
 #include "util/driconf.h"
+#include "util/u_debug.h"
+#include "util/u_math.h"
 #include "venus-protocol/vn_protocol_driver_info.h"
 #include "venus-protocol/vn_protocol_driver_instance.h"
 #include "venus-protocol/vn_protocol_driver_transport.h"
@@ -149,7 +151,16 @@
    static const size_t extra_size = sizeof(uint32_t);
 
    /* default instance ring size */
-   static const size_t buf_size = 128 * 1024;
+   /* droiddeck (0029): 128 KiB is ~30 ms of a DXVK game's commands (Lake: ~26k descriptor
+    * allocations and updates a second). Whenever the server stalls longer than that -- a 256 MiB
+    * vkAllocateMemory takes 60-95 ms, a command stream up to 155 ms -- the game's dxvk-cs thread
+    * blocks on "ring space" and the frame stops with it (400-550 such waits per 10 s, up to 61 ms
+    * each, in the 2026-10-31-01 bundle). 4 MiB rides those stalls out; the server accepts up to
+    * 16 MiB (VKR_RING_BUFFER_MAX_SIZE). DROIDDECK_VN_RING_KB sets it (a power of two). */
+   size_t buf_size = (size_t)debug_get_num_option("DROIDDECK_VN_RING_KB", 4096) * 1024;
+   if (buf_size < 128 * 1024 || buf_size > 16 * 1024 * 1024 ||
+       !util_is_power_of_two_nonzero64(buf_size))
+      buf_size = 128 * 1024;
 
    /* order of 4 for performant async cmd enqueue */
    static const uint8_t direct_order = 4;
@@ -161,6 +172,7 @@
                                         false /* is_tls_ring */);
    if (!instance->ring.ring)
       return VK_ERROR_OUT_OF_HOST_MEMORY;
+   vn_droiddeck_log("ring: %zu KiB (DROIDDECK_VN_RING_KB)", buf_size / 1024);
 
    list_inithead(&instance->ring.tls_rings);
 
