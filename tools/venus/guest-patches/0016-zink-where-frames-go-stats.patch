+/* droiddeck: see zink_dd_stats.h */
+struct zink_dd_stats zink_dd_stats;
+bool zink_dd_stats_on;
+__thread int zink_dd_wait_reason;
+static simple_mtx_t zink_dd_lock = SIMPLE_MTX_INITIALIZER;
+static uint64_t zink_dd_since;
+static uint64_t zink_dd_interval_ns = 10000000000ull;
+
+void
+zink_dd_stats_init(void)
+{
+   zink_dd_stats_on = debug_get_bool_option("DROIDDECK_ZINK_STATS", true);
+   /* DROIDDECK_ZINK_STATS_MS: how often (tests use less than 10 s) */
+   zink_dd_interval_ns = debug_get_num_option("DROIDDECK_ZINK_STATS_MS", 10000) * 1000000ull;
+}
+
+void
+zink_dd_stats_add(uint64_t *count, uint64_t *total, uint64_t *max, uint64_t value)
+{
+   if (!zink_dd_stats_on)
+      return;
+   simple_mtx_lock(&zink_dd_lock);
+   (*count)++;
+   *total += value;
+   if (value > *max)
+      *max = value;
+   simple_mtx_unlock(&zink_dd_lock);
+   zink_dd_stats_tick();
+}
+
+void
+zink_dd_stats_tick(void)
+{
+   if (!zink_dd_stats_on)
+      return;
+   const uint64_t now = os_time_get_nano();
+   struct zink_dd_stats s;
+   simple_mtx_lock(&zink_dd_lock);
+   if (!zink_dd_since)
+      zink_dd_since = now;
+   if (now - zink_dd_since < zink_dd_interval_ns) {
+      simple_mtx_unlock(&zink_dd_lock);
+      return;
+   }
+   const double secs = (now - zink_dd_since) / 1e9;
+   zink_dd_since = now;
+   s = zink_dd_stats;
+   memset(&zink_dd_stats, 0, sizeof(zink_dd_stats));
+   simple_mtx_unlock(&zink_dd_lock);
+   if (!s.batches)
+      return;
+#define DD_MS(x) ((x) / 1e6)
+   mesa_logi("droiddeck zink [%d %s]: over %.0f s: %" PRIu64 " batches, GPU busy %.1f ms (%" PRIu64
+             " timed, avg %.2f, max %.2f ms); %" PRIu64 " render passes (+%" PRIu64 " clear-only): "
+             "color load %" PRIu64 " clear %" PRIu64 " dont-care %" PRIu64 ", depth load %" PRIu64
+             " clear %" PRIu64 "; pipelines: full %" PRIu64 " %.1f ms (max %.1f), library %" PRIu64
+             " %.1f ms (max %.1f), compute %" PRIu64 " %.1f ms (max %.1f); waits: fence %" PRIu64
+             " %.1f ms (max %.1f), map %" PRIu64 " %.1f ms (max %.1f), other %" PRIu64
+             " %.1f ms (max %.1f)",
+             (int)getpid(), util_get_process_name(), secs, s.batches, DD_MS(s.gpu_ns), s.gpu_batches,
+             s.gpu_batches ? DD_MS(s.gpu_ns) / s.gpu_batches : 0.0, DD_MS(s.gpu_max_ns), s.passes,
+             s.clear_passes, s.color_load, s.color_clear, s.color_dont_care, s.depth_load,
+             s.depth_clear, s.pipe_count[ZINK_DD_PIPE_GFX], DD_MS(s.pipe_ns[ZINK_DD_PIPE_GFX]),
+             DD_MS(s.pipe_max_ns[ZINK_DD_PIPE_GFX]), s.pipe_count[ZINK_DD_PIPE_LIBRARY],
+             DD_MS(s.pipe_ns[ZINK_DD_PIPE_LIBRARY]), DD_MS(s.pipe_max_ns[ZINK_DD_PIPE_LIBRARY]),
+             s.pipe_count[ZINK_DD_PIPE_COMPUTE], DD_MS(s.pipe_ns[ZINK_DD_PIPE_COMPUTE]),
+             DD_MS(s.pipe_max_ns[ZINK_DD_PIPE_COMPUTE]), s.wait_count[ZINK_DD_WAIT_FENCE],
+             DD_MS(s.wait_ns[ZINK_DD_WAIT_FENCE]), DD_MS(s.wait_max_ns[ZINK_DD_WAIT_FENCE]),
+             s.wait_count[ZINK_DD_WAIT_MAP], DD_MS(s.wait_ns[ZINK_DD_WAIT_MAP]),
+             DD_MS(s.wait_max_ns[ZINK_DD_WAIT_MAP]), s.wait_count[ZINK_DD_WAIT_OTHER],
+             DD_MS(s.wait_ns[ZINK_DD_WAIT_OTHER]), DD_MS(s.wait_max_ns[ZINK_DD_WAIT_OTHER]));
+#undef DD_MS
+}
