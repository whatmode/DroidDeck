diff -ruN a/src/gallium/drivers/zink/zink_dd_stats.h b/src/gallium/drivers/zink/zink_dd_stats.h
new file mode 100644
--- /dev/null
+++ b/src/gallium/drivers/zink/zink_dd_stats.h
@@ -0,0 +1,61 @@
+/*
+ * DroidDeck: where a GL program's frames go in Zink, every 10 s in its log (stderr), so one
+ * round of logs shows whether Steam's UI waits on the GPU, on shader/pipeline compiles, on
+ * buffer maps, or on render pass load/stores (expensive on a tiler like Mali):
+ *   batches submitted and the GPU's time for them (timestamps at the start and end of each);
+ *   render passes begun and their color/depth load ops;
+ *   pipelines made (graphics, libraries, compute) and how long each took on the CPU;
+ *   waits for the GPU by reason (fence: glFinish/glClientWaitSync/swap throttle, map: a
+ *   buffer or texture the CPU wants while the GPU uses it, other).
+ * DROIDDECK_ZINK_STATS=0 turns it off; DROIDDECK_ZINK_STATS_MS sets the interval.
+ */
+#ifndef ZINK_DD_STATS_H
+#define ZINK_DD_STATS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "util/os_time.h"
+
+enum zink_dd_wait {
+   ZINK_DD_WAIT_OTHER,
+   ZINK_DD_WAIT_FENCE,
+   ZINK_DD_WAIT_MAP,
+   ZINK_DD_WAIT_COUNT,
+};
+
+enum zink_dd_pipe {
+   ZINK_DD_PIPE_GFX,
+   ZINK_DD_PIPE_LIBRARY,
+   ZINK_DD_PIPE_COMPUTE,
+   ZINK_DD_PIPE_COUNT,
+};
+
+struct zink_dd_stats {
+   uint64_t batches, gpu_batches, gpu_ns, gpu_max_ns;
+   uint64_t passes, clear_passes, color_load, color_clear, color_dont_care, depth_load, depth_clear;
+   uint64_t pipe_count[ZINK_DD_PIPE_COUNT], pipe_ns[ZINK_DD_PIPE_COUNT], pipe_max_ns[ZINK_DD_PIPE_COUNT];
+   uint64_t pipe_main_thread;
+   uint64_t wait_count[ZINK_DD_WAIT_COUNT], wait_ns[ZINK_DD_WAIT_COUNT], wait_max_ns[ZINK_DD_WAIT_COUNT];
+};
+
+extern struct zink_dd_stats zink_dd_stats;
+extern bool zink_dd_stats_on;
+extern __thread int zink_dd_wait_reason;
+
+void
+zink_dd_stats_init(void);
+/* adds max under the stats lock and prints when 10 s have passed */
+void
+zink_dd_stats_add(uint64_t *count, uint64_t *total, uint64_t *max, uint64_t value);
+void
+zink_dd_stats_tick(void);
+
+static inline void
+zink_dd_count(uint64_t *counter, uint64_t n)
+{
+   if (zink_dd_stats_on)
+      __atomic_fetch_add(counter, n, __ATOMIC_RELAXED);
+}
+
+#endif
