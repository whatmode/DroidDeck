+/* droiddeck: frame rate of this process's GL windows, every 10 s in the log (to tune Steam's
+ * UI at the panel's 120 Hz): swaps per second, the longest gap between two, and how long a
+ * swap itself took at most. */
+static __thread int64_t droiddeck_flush_ns;
+static __thread int droiddeck_kind; /* 0 presented, 1 composed, 2 hidden */
+
+static void
+droiddeck_frame_stats(int64_t start, int64_t end)
+{
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static int64_t since, last;
+   static unsigned swaps, kinds[3], slow;
+   static int64_t gap, cost, flush_max, flush_sum, rest_max, rest_sum;
+   simple_mtx_lock(&lock);
+   if (!since)
+      since = start;
+   int k = droiddeck_kind;
+   if (k == 0 || k == 1) {
+      if (last && start - last > gap)
+         gap = start - last;
+      last = end;
+   }
+   if (end - start > cost)
+      cost = end - start;
+   int64_t fl = droiddeck_flush_ns, rest = end - start - droiddeck_flush_ns;
+   flush_sum += fl;
+   rest_sum += rest;
+   if (fl > flush_max) flush_max = fl;
+   if (rest > rest_max) rest_max = rest;
+   if (end - start > 8000000) slow++;
+   if (k >= 0 && k < 3) kinds[k]++;
+   swaps++;
+   if (end - since >= 10000000000ll) {
+      static unsigned reports;
+      double secs = (end - since) / 1e9;
+      if (++reports <= 60)
+         fprintf(stderr, "droiddeck kopper: frames over %.0f s: shown %.1f/s, composed %.1f/s, hidden %.1f/s; "
+                 "longest gap between shown %.1f ms; swap: flush avg %.2f max %.1f ms, present avg %.2f max %.1f ms, "
+                 "%u swaps over 8 ms\n", secs, kinds[0] / secs, kinds[1] / secs, kinds[2] / secs, gap / 1e6,
+                 flush_sum / 1e6 / swaps, flush_max / 1e6, rest_sum / 1e6 / swaps, rest_max / 1e6, slow);
+      since = end;
+      swaps = slow = 0;
+      memset(kinds, 0, sizeof(kinds));
+      gap = cost = flush_max = flush_sum = rest_max = rest_sum = 0;
+   }
+   simple_mtx_unlock(&lock);
+}
