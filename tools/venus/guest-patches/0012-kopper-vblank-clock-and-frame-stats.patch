+static bool
+droiddeck_sync_values(struct dri_drawable *drawable, xcb_connection_t *conn, int64_t target_msc,
+                      int64_t divisor, int64_t remainder, int64_t *ust, int64_t *msc, int64_t *sbc)
+{
+   /* Off by default: with this clock Chromium drew at the panel's 120 Hz and the bridge fell
+    * behind until Steam's UI stalled for seconds. DROIDDECK_GLX_FAKE_MSC=1 turns it on. */
+   static int real = -1;
+   if (real < 0)
+      real = !debug_get_bool_option("DROIDDECK_GLX_FAKE_MSC", false);
+   if (real)
+      return false;
+   uint32_t win = ((VkXcbSurfaceCreateInfoKHR *)&drawable->info.bos)->window;
+   int64_t period = 1000000ll / droiddeck_refresh_hz(conn, win); /* microseconds */
+   int64_t now = os_time_get_nano() / 1000;
+   int64_t cur = now / period;
+   int64_t want = cur;
+   if (target_msc > cur)
+      want = target_msc;
+   else if (divisor > 0) {
+      want = cur - cur % divisor + remainder;
+      if (want <= cur)
+         want += divisor;
+   }
+   if (want > cur) {
+      int64_t wait = want * period - now;
+      if (wait > 0 && wait < 1000000)
+         os_time_sleep(wait);
+      cur = want;
+   }
+   *ust = cur * period;
+   *msc = cur;
+   *sbc = drawable->lastStamp;
+   return true;
+}
