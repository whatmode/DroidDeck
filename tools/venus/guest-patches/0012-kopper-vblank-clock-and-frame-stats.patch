+/* droiddeck: frame rate of this process's GL windows, every 10 s in the log (to tune Steam's
+ * UI at the panel's 120 Hz): swaps per second, the longest gap between two, and how long a
+ * swap itself took at most. */
+static void
+droiddeck_frame_stats(int64_t start, int64_t end)
+{
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static int64_t since, last;
+   static unsigned swaps;
+   static int64_t gap, cost;
+   simple_mtx_lock(&lock);
+   if (!since)
+      since = start;
+   if (last && start - last > gap)
+      gap = start - last;
+   if (end - start > cost)
+      cost = end - start;
+   last = end;
+   swaps++;
+   if (end - since >= 10000000000ll) {
+      static unsigned reports;
+      if (++reports <= 60)
+         fprintf(stderr, "droiddeck kopper: frames: %.1f swaps/s over %.0f s, longest gap %.1f ms, slowest swap %.1f ms\n",
+                 swaps * 1e9 / (end - since), (end - since) / 1e9, gap / 1e6, cost / 1e6);
+      since = end;
+      swaps = 0;
+      gap = cost = 0;
+   }
+   simple_mtx_unlock(&lock);
+}
