+/* droiddeck: vblank counts and times for GLX_OML_sync_control / GLX_SGI_video_sync from a
+ * clock at the X screen's refresh. Under gamescope a GL window presents straight to it, so
+ * Xwayland never shows it and its Present vblank events come from an idle timer (about once
+ * a second): glXGetSyncValuesOML blocked Chromium's GPU thread and its frame clock (Steam's
+ * UI) had no vsync to follow. Refresh from RandR (Xwayland's mode is gamescope's rate),
+ * looked at every 2 s; DROIDDECK_GLX_REFRESH=<Hz> sets it, DROIDDECK_GLX_REAL_MSC=1 keeps
+ * the X server's counts. */
+#include <dlfcn.h>
+struct droiddeck_randr_info_reply { uint8_t response_type, set_of_rotations; uint16_t sequence; uint32_t length;
+                                    uint32_t root, timestamp, config_timestamp; uint16_t n_sizes, size_id, rotation, rate; };
+typedef struct { unsigned int sequence; } droiddeck_randr_cookie;
+
+static unsigned
+droiddeck_refresh_hz(xcb_connection_t *conn, xcb_window_t win)
+{
+   static int fixed = -1;
+   if (fixed < 0) {
+      const char *e = getenv("DROIDDECK_GLX_REFRESH");
+      fixed = e ? atoi(e) : 0;
+   }
+   if (fixed > 0)
+      return fixed;
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static unsigned hz;
+   static int64_t checked;
+   static droiddeck_randr_cookie (*get_info)(xcb_connection_t *, xcb_window_t);
+   static struct droiddeck_randr_info_reply *(*get_info_reply)(xcb_connection_t *, droiddeck_randr_cookie, void **);
+   static bool tried;
+   int64_t now = os_time_get_nano();
+   simple_mtx_lock(&lock);
+   if (!tried) {
+      tried = true;
+      void *lib = dlopen("libxcb-randr.so.0", RTLD_NOW | RTLD_LOCAL);
+      if (lib) {
+         get_info = (droiddeck_randr_cookie (*)(xcb_connection_t *, xcb_window_t))dlsym(lib, "xcb_randr_get_screen_info");
+         get_info_reply = (struct droiddeck_randr_info_reply *(*)(xcb_connection_t *, droiddeck_randr_cookie, void **))
+            dlsym(lib, "xcb_randr_get_screen_info_reply");
+      }
+   }
+   if ((!hz || now - checked > 2000000000ll) && get_info && get_info_reply) {
+      checked = now;
+      unsigned old = hz;
+      struct droiddeck_randr_info_reply *r = get_info_reply(conn, get_info(conn, win), NULL);
+      if (r && r->rate >= 24 && r->rate <= 360)
+         hz = r->rate;
+      free(r);
+      if (hz != old)
+         fprintf(stderr, "droiddeck kopper: vblank clock at %u Hz (the X screen's refresh)\n", hz);
+   }
+   unsigned out = hz ? hz : 60;
+   simple_mtx_unlock(&lock);
+   return out;
+}
