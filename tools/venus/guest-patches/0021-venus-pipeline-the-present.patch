       return;
@@ -1022,8 +1025,22 @@
                    "forcing vkQueueWaitIdle before presenting");
       }
 
-      vn_QueueWaitIdle(submit->queue_handle);
+      /* DroidDeck: with no implicit fencing the queue is drained to idle before every present,
+       * so the CPU cannot run ahead of the GPU by even one frame. DROIDDECK_VN_SYNC_PRESENT=0
+       * skips the drain: the server still orders the present after the submitted work (the
+       * ring submission is ordered), it just stops the guest from blocking on it. Off by
+       * default, since correctness on every path has not been shown yet. */
+      static int sync_present = -1;
+      if (sync_present < 0)
+         sync_present = debug_get_bool_option("DROIDDECK_VN_SYNC_PRESENT", true);
+      if (sync_present) {
+         const int64_t start = os_time_get_nano();
+         vn_QueueWaitIdle(submit->queue_handle);
+         present_wait_ns = os_time_get_nano() - start;
+      }
    }
+
+   vn_dd_frame_stats(present_wait_ns);
