+VkResult
+vn_log_result(struct vn_instance *instance,
+              VkResult result,
+              const char *where)
+{
+   /* image format queries answer "not supported" by the hundred, and a full descriptor pool is
+    * how DXVK learns to take the next one (dozens a frame; counted in the 10 s descriptor-pool
+    * report instead): not for the file */
+   if (result == VK_ERROR_FORMAT_NOT_SUPPORTED || result == VK_ERROR_OUT_OF_POOL_MEMORY ||
+       result == VK_ERROR_FRAGMENTED_POOL)
+      mesa_log(MESA_LOG_DEBUG, "MESA-VIRTIO", "%s: %s", where, vk_Result_to_str(result));
+   else
+      vn_log(instance, "%s: %s", where, vk_Result_to_str(result));
+   return result;
+}
