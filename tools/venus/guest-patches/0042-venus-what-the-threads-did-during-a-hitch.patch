+static mtx_t vn_dd_stats_mutex;
+static void vn_dd_lock_init(void) { mtx_init(&vn_dd_stats_mutex, mtx_plain); }
+static FILE *vn_dd_file;
+static mtx_t vn_dd_mutex;
+static char vn_dd_prog[96];
