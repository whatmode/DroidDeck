+/* droiddeck: windows this process draws with GL (their kopper drawable is alive and has
+ * swapped), with the toplevel each is in. A covering child counts only when GL draws it (a
+ * child X paints nothing into leaves its parent visible), however long ago it last drew:
+ * Steam's main view stays still while its menu is open. */
+static struct { uint32_t win, top; } droiddeck_presented[128];
+static simple_mtx_t droiddeck_presented_lock = SIMPLE_MTX_INITIALIZER;
+
+static void
+droiddeck_note_present(uint32_t win, int64_t now)
+{
+   (void)now;
+   simple_mtx_lock(&droiddeck_presented_lock);
+   int slot = -1;
+   for (unsigned i = 0; i < ARRAY_SIZE(droiddeck_presented); i++) {
+      if (droiddeck_presented[i].win == win) { slot = -2; break; }
+      if (slot == -1 && !droiddeck_presented[i].win) slot = i;
+   }
+   if (slot != -2) {
+      if (slot < 0) slot = 0;
+      droiddeck_presented[slot].win = win;
+      droiddeck_presented[slot].top = 0;
+   }
+   simple_mtx_unlock(&droiddeck_presented_lock);
+}
+
+static void
+droiddeck_note_top(uint32_t win, uint32_t top)
+{
+   simple_mtx_lock(&droiddeck_presented_lock);
+   for (unsigned i = 0; i < ARRAY_SIZE(droiddeck_presented); i++)
+      if (droiddeck_presented[i].win == win)
+         droiddeck_presented[i].top = top;
+   simple_mtx_unlock(&droiddeck_presented_lock);
+}
+
+static void
+droiddeck_forget(uint32_t win)
+{
+   simple_mtx_lock(&droiddeck_presented_lock);
+   for (unsigned i = 0; i < ARRAY_SIZE(droiddeck_presented); i++)
+      if (droiddeck_presented[i].win == win)
+         droiddeck_presented[i].win = droiddeck_presented[i].top = 0;
+   simple_mtx_unlock(&droiddeck_presented_lock);
+}
+
+/* other GL windows of this process in the same toplevel (shown or not) */
+static unsigned
+droiddeck_others_in_top(uint32_t win, uint32_t top)
+{
+   unsigned n = 0;
+   simple_mtx_lock(&droiddeck_presented_lock);
+   for (unsigned i = 0; i < ARRAY_SIZE(droiddeck_presented); i++)
+      if (droiddeck_presented[i].win && droiddeck_presented[i].win != win && droiddeck_presented[i].top == top)
+         n++;
+   simple_mtx_unlock(&droiddeck_presented_lock);
+   return n;
+}
+
+static bool
+droiddeck_drawn_lately(uint32_t win, int64_t now)
+{
+   (void)now;
+   bool drawn = false;
+   simple_mtx_lock(&droiddeck_presented_lock);
+   for (unsigned i = 0; i < ARRAY_SIZE(droiddeck_presented); i++)
+      if (droiddeck_presented[i].win == win)
+         drawn = true;
+   simple_mtx_unlock(&droiddeck_presented_lock);
+   return drawn;
+}
