+/* droiddeck: the toplevel a window is in, its offset there and its stacking order (the child
+ * index at each level from the toplevel down, so siblings and cousins compare as X stacks them). */
+static void
+droiddeck_place(struct dri_drawable *drawable, xcb_connection_t *conn, xcb_window_t win,
+                unsigned w, unsigned h, xcb_window_t parent)
+{
+   uint8_t path[8];
+   int depth = 0;
+   xcb_window_t cur = win, top = win, up = parent;
+   for (int guard = 0; up && guard < 8; guard++) {
+      xcb_query_tree_reply_t *t = xcb_query_tree_reply(conn, xcb_query_tree(conn, up), NULL);
+      if (!t)
+         break;
+      if (up == t->root) {
+         free(t);
+         break;
+      }
+      int n = xcb_query_tree_children_length(t);
+      xcb_window_t *kids = xcb_query_tree_children(t);
+      int idx = 0;
+      for (int i = 0; i < n; i++)
+         if (kids[i] == cur)
+            idx = i;
+      if (depth < 8)
+         path[depth++] = MIN2(idx, 255);
+      top = up;
+      cur = up;
+      up = t->parent;
+      free(t);
+   }
+   uint64_t order = 0;
+   for (int i = depth - 1, level = 0; level < 7; i--, level++)
+      order = (order << 8) | (i >= 0 ? path[i] + 1u : 0u);
+   int x = 0, y = 0;
+   if (top != win) {
+      xcb_translate_coordinates_reply_t *tr =
+         xcb_translate_coordinates_reply(conn, xcb_translate_coordinates(conn, win, top, 0, 0), NULL);
+      if (tr) {
+         x = tr->dst_x;
+         y = tr->dst_y;
+         free(tr);
+      }
+   }
+   drawable->droiddeck_top = top;
+   droiddeck_note_top(win, top);
+   drawable->droiddeck_x = x;
+   drawable->droiddeck_y = y;
+   drawable->droiddeck_w = w;
+   drawable->droiddeck_h = h;
+   drawable->droiddeck_order = order;
+}
+
+/* droiddeck: GL windows sharing a toplevel. gamescope shows one swapchain per toplevel (the
+ * last presented replaces the whole window), while X shows them all, stacked: Steam draws its
+ * side menu in a GL window next to the main one inside Chromium's toplevel. With two or more
+ * of them shown, none presents on its own: their frames go into one swapchain made for the
+ * toplevel, each copied at its place in stacking order, as X would compose them. */
+#define DROIDDECK_MEMBERS 8
+struct droiddeck_member {
+   uint32_t win;
+   int x, y;
+   unsigned w, h;
+   uint64_t order;
+   struct pipe_resource *tex;
+   int64_t swap;
+};
+struct droiddeck_group {
+   uint32_t top;
+   struct droiddeck_member m[DROIDDECK_MEMBERS];
+   struct pipe_resource *comp;
+   unsigned cw, ch;
+   struct kopper_loader_info info;
+   int64_t last_comp;
+   bool compositing;
+};
+static struct droiddeck_group droiddeck_groups[4];
+static simple_mtx_t droiddeck_group_lock = SIMPLE_MTX_INITIALIZER;
+
+static void
+droiddeck_group_leave(uint32_t win)
+{
+   simple_mtx_lock(&droiddeck_group_lock);
+   for (unsigned g = 0; g < ARRAY_SIZE(droiddeck_groups); g++)
+      for (unsigned i = 0; i < DROIDDECK_MEMBERS; i++)
+         if (droiddeck_groups[g].m[i].win == win) {
+            pipe_resource_reference(&droiddeck_groups[g].m[i].tex, NULL);
+            memset(&droiddeck_groups[g].m[i], 0, sizeof(droiddeck_groups[g].m[i]));
+         }
+   simple_mtx_unlock(&droiddeck_group_lock);
+}
+
+static int
+droiddeck_member_cmp(const void *a, const void *b)
+{
+   const struct droiddeck_member *ma = a, *mb = b;
+   return ma->order < mb->order ? -1 : ma->order > mb->order;
+}
+
+/* droiddeck: keep this window's latest frame in a texture of its own while its toplevel has
+ * other GL windows: when one of them shows (Steam's menu opens over a still main view) the
+ * shared swapchain needs every window's picture, and a presented swapchain image is gone. */
+static void
+droiddeck_copy_frame(struct dri_drawable *drawable, struct pipe_context *pipe, struct pipe_resource *ptex)
+{
+   uint32_t win = ((VkXcbSurfaceCreateInfoKHR *)&drawable->info.bos)->window;
+   if (!drawable->droiddeck_top || !droiddeck_others_in_top(win, drawable->droiddeck_top)) {
+      pipe_resource_reference(&drawable->droiddeck_copy, NULL);
+      return;
+   }
+   struct pipe_screen *pscreen = drawable->screen->base.screen;
+   struct pipe_resource *copy = drawable->droiddeck_copy;
+   if (!copy || copy->width0 != ptex->width0 || copy->height0 != ptex->height0 || copy->format != ptex->format) {
+      pipe_resource_reference(&drawable->droiddeck_copy, NULL);
+      struct pipe_resource templ;
+      memset(&templ, 0, sizeof(templ));
+      templ.target = PIPE_TEXTURE_2D;
+      templ.format = ptex->format;
+      templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+      templ.width0 = ptex->width0;
+      templ.height0 = ptex->height0;
+      templ.depth0 = 1;
+      templ.array_size = 1;
+      drawable->droiddeck_copy = pscreen->resource_create(pscreen, &templ);
+      copy = drawable->droiddeck_copy;
+      if (!copy)
+         return;
+   }
+   struct pipe_blit_info b;
+   memset(&b, 0, sizeof(b));
+   b.dst.resource = copy;
+   b.dst.format = copy->format;
+   u_box_2d(0, 0, ptex->width0, ptex->height0, &b.dst.box);
+   b.src.resource = ptex;
+   b.src.format = ptex->format;
+   u_box_2d(0, 0, ptex->width0, ptex->height0, &b.src.box);
+   b.mask = PIPE_MASK_RGBA;
+   b.filter = PIPE_TEX_FILTER_NEAREST;
+   pipe->blit(pipe, &b);
+}
+
+/* true when this frame went into the toplevel's shared swapchain (the window does not present) */
+static bool
+droiddeck_composite(struct dri_drawable *drawable, struct pipe_context *pipe, struct pipe_resource *ptex)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *e = getenv("DROIDDECK_KOPPER_COMPOSITE");
+      enabled = !(e && e[0] == '0');
+   }
+   if (!enabled || !drawable->is_window || !drawable->droiddeck_top || !drawable->droiddeck_copy ||
+       drawable->info.bos.sType != VK_STRUCTURE_TYPE_XCB_SURFACE_CREATE_INFO_KHR)
+      return false;
+   VkXcbSurfaceCreateInfoKHR *xcb = (VkXcbSurfaceCreateInfoKHR *)&drawable->info.bos;
+   xcb_connection_t *conn = xcb->connection;
+   uint32_t win = xcb->window, top = drawable->droiddeck_top;
+   struct pipe_screen *pscreen = drawable->screen->base.screen;
+   int64_t now = os_time_get_nano();
+
+   simple_mtx_lock(&droiddeck_group_lock);
+   struct droiddeck_group *grp = NULL, *spare = NULL;
+   for (unsigned g = 0; g < ARRAY_SIZE(droiddeck_groups); g++) {
+      if (droiddeck_groups[g].top == top)
+         grp = &droiddeck_groups[g];
+      else if (!spare && !droiddeck_groups[g].comp) {
+         bool empty = true;
+         for (unsigned i = 0; i < DROIDDECK_MEMBERS; i++)
+            empty &= !droiddeck_groups[g].m[i].win;
+         if (empty)
+            spare = &droiddeck_groups[g];
+      }
+   }
+   if (!grp) {
+      if (!spare) {
+         simple_mtx_unlock(&droiddeck_group_lock);
+         return false;
+      }
+      grp = spare;
+      memset(grp, 0, sizeof(*grp));
+      grp->top = top;
+   }
+   /* this window's latest frame, and members that stopped drawing a second ago drop out */
+   struct droiddeck_member *self = NULL;
+   for (unsigned i = 0; i < DROIDDECK_MEMBERS; i++) {
+      struct droiddeck_member *m = &grp->m[i];
+      if (m->win == win)
+         self = m;
+   }
+   for (unsigned i = 0; !self && i < DROIDDECK_MEMBERS; i++)
+      if (!grp->m[i].win)
+         self = &grp->m[i];
+   if (!self) {
+      simple_mtx_unlock(&droiddeck_group_lock);
+      return false;
+   }
+   self->win = win;
+   self->x = drawable->droiddeck_x;
+   self->y = drawable->droiddeck_y;
+   self->w = drawable->droiddeck_w;
+   self->h = drawable->droiddeck_h;
+   self->order = drawable->droiddeck_order;
+   self->swap = now;
+   pipe_resource_reference(&self->tex, drawable->droiddeck_copy);
+
+   unsigned n = 0;
+   bool top_drawn = false;
+   struct droiddeck_member *primary = NULL;
+   for (unsigned i = 0; i < DROIDDECK_MEMBERS; i++) {
+      struct droiddeck_member *m = &grp->m[i];
+      if (!m->win || !m->tex || m->tex->screen != pscreen)
+         continue;
+      /* the toplevel drawn by GL itself has its own swapchain: X allows one per window */
+      top_drawn |= m->win == top;
+      n++;
+      if (!primary || m->w * m->h > primary->w * primary->h)
+         primary = m;
+   }
+   static unsigned notes;
+   if (n < 2 || top_drawn) {
+      if (top_drawn)
+         pipe_resource_reference(&grp->comp, NULL);
+      if (grp->compositing && (++notes <= 60 || notes % 500 == 0))
+         fprintf(stderr, "droiddeck kopper: toplevel 0x%x: one GL window again (0x%x), it presents itself\n", top, win);
+      grp->compositing = false;
+      if (grp->comp && now - grp->last_comp > 2000000000ll)
+         pipe_resource_reference(&grp->comp, NULL);
+      simple_mtx_unlock(&droiddeck_group_lock);
+      return false;
+   }
+   if (!grp->compositing && (++notes <= 60 || notes % 500 == 0)) {
+      fprintf(stderr, "droiddeck kopper: toplevel 0x%x shows %u GL windows; composed into one swapchain:", top, n);
+      for (unsigned i = 0; i < DROIDDECK_MEMBERS; i++)
+         if (grp->m[i].win)
+            fprintf(stderr, " 0x%x %ux%u%+d%+d", grp->m[i].win, grp->m[i].w, grp->m[i].h, grp->m[i].x, grp->m[i].y);
+      fprintf(stderr, "\n");
+   }
+   grp->compositing = true;
+   /* compose when the biggest window swaps, or when it has been idle for 30 ms */
+   if (primary != self && now - primary->swap < 30000000ll) {
+      simple_mtx_unlock(&droiddeck_group_lock);
+      return true;
+   }
+   struct droiddeck_member list[DROIDDECK_MEMBERS];
+   unsigned count = 0;
+   for (unsigned i = 0; i < DROIDDECK_MEMBERS; i++) {
+      struct droiddeck_member *m = &grp->m[i];
+      if (!m->win || !m->tex || m->tex->screen != pscreen)
+         continue;
+      list[count] = *m;
+      list[count].tex = NULL;
+      pipe_resource_reference(&list[count].tex, m->tex);
+      count++;
+   }
+   if (!grp->info.bos.sType) {
+      grp->info = drawable->info;
+      ((VkXcbSurfaceCreateInfoKHR *)&grp->info.bos)->window = top;
+   }
+   grp->last_comp = now;
+   simple_mtx_unlock(&droiddeck_group_lock);
+
+   /* where the members are now (the menu slides, closes) and the toplevel's size */
+   xcb_get_geometry_cookie_t tgc = xcb_get_geometry(conn, top);
+   xcb_get_window_attributes_cookie_t ac[DROIDDECK_MEMBERS];
+   xcb_translate_coordinates_cookie_t tc[DROIDDECK_MEMBERS];
+   xcb_get_geometry_cookie_t gc[DROIDDECK_MEMBERS];
+   for (unsigned i = 0; i < count; i++) {
+      ac[i] = xcb_get_window_attributes(conn, list[i].win);
+      tc[i] = xcb_translate_coordinates(conn, list[i].win, top, 0, 0);
+      gc[i] = xcb_get_geometry(conn, list[i].win);
+   }
+   xcb_get_geometry_reply_t *tg = xcb_get_geometry_reply(conn, tgc, NULL);
+   for (unsigned i = 0; i < count; i++) {
+      xcb_get_window_attributes_reply_t *a = xcb_get_window_attributes_reply(conn, ac[i], NULL);
+      xcb_translate_coordinates_reply_t *t = xcb_translate_coordinates_reply(conn, tc[i], NULL);
+      xcb_get_geometry_reply_t *g = xcb_get_geometry_reply(conn, gc[i], NULL);
+      if (!a || a->map_state != XCB_MAP_STATE_VIEWABLE || !t || !g) {
+         if (list[i].win != win)
+            droiddeck_group_leave(list[i].win);
+         list[i].w = list[i].h = 0;
+      } else {
+         list[i].x = t->dst_x;
+         list[i].y = t->dst_y;
+         list[i].w = g->width;
+         list[i].h = g->height;
+      }
+      free(a);
+      free(t);
+      free(g);
+   }
+   unsigned cw = tg ? tg->width : 0, ch = tg ? tg->height : 0;
+   free(tg);
+
+   bool done = false;
+   if (cw && ch) {
+      simple_mtx_lock(&droiddeck_group_lock);
+      if (grp->top == top && (!grp->comp || grp->cw != cw || grp->ch != ch)) {
+         pipe_resource_reference(&grp->comp, NULL);
+         struct pipe_resource templ;
+         memset(&templ, 0, sizeof(templ));
+         templ.target = ptex->target;
+         templ.format = ptex->format;
+         templ.bind = ptex->bind | PIPE_BIND_DISPLAY_TARGET;
+         templ.width0 = cw;
+         templ.height0 = ch;
+         templ.depth0 = 1;
+         templ.array_size = 1;
+         grp->comp = pscreen->resource_create_drawable(pscreen, &templ, &grp->info);
+         grp->cw = cw;
+         grp->ch = ch;
+         static unsigned made;
+         if (++made <= 40)
+            fprintf(stderr, "droiddeck kopper: toplevel 0x%x: shared swapchain %ux%u %s\n", top, cw, ch,
+                    grp->comp ? "made" : "could not be made");
+      }
+      struct pipe_resource *comp = NULL;
+      if (grp->top == top)
+         pipe_resource_reference(&comp, grp->comp);
+      simple_mtx_unlock(&droiddeck_group_lock);
+
+      if (comp) {
+         qsort(list, count, sizeof(list[0]), droiddeck_member_cmp);
+         for (unsigned i = 0; i < count; i++) {
+            struct droiddeck_member *m = &list[i];
+            if (!m->w || !m->h)
+               continue;
+            int x0 = MAX2(m->x, 0), y0 = MAX2(m->y, 0);
+            int x1 = MIN3(m->x + (int)m->w, (int)cw, m->x + (int)m->tex->width0);
+            int y1 = MIN3(m->y + (int)m->h, (int)ch, m->y + (int)m->tex->height0);
+            if (x1 <= x0 || y1 <= y0)
+               continue;
+            struct pipe_blit_info b;
+            memset(&b, 0, sizeof(b));
+            b.dst.resource = comp;
+            b.dst.format = comp->format;
+            u_box_2d(x0, y0, x1 - x0, y1 - y0, &b.dst.box);
+            b.src.resource = m->tex;
+            b.src.format = m->tex->format;
+            u_box_2d(x0 - m->x, y0 - m->y, x1 - x0, y1 - y0, &b.src.box);
+            b.mask = PIPE_MASK_RGBA;
+            b.filter = PIPE_TEX_FILTER_NEAREST;
+            pipe->blit(pipe, &b);
+         }
+         pipe->flush_resource(pipe, comp);
+         pipe->flush(pipe, NULL, 0);
+         pscreen->flush_frontbuffer(pscreen, pipe, comp, 0, 0, NULL, 0, NULL);
+         if (!zink_kopper_check(comp)) {
+            simple_mtx_lock(&droiddeck_group_lock);
+            if (grp->comp == comp)
+               pipe_resource_reference(&grp->comp, NULL);
+            simple_mtx_unlock(&droiddeck_group_lock);
+         }
+         pipe_resource_reference(&comp, NULL);
+         done = true;
+      }
+   }
+   for (unsigned i = 0; i < count; i++)
+      pipe_resource_reference(&list[i].tex, NULL);
+   return done;
+}
