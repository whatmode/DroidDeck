+/* droiddeck: a mapped child (or a child's child, as Chromium puts ANGLE's GL window in a plain
+ * child of its own) covering the whole w x h window and drawn by this process; 0 if none. */
+static xcb_window_t
+droiddeck_drawn_cover(xcb_connection_t *conn, xcb_query_tree_reply_t *tree, unsigned w, unsigned h,
+                      int64_t now, int depth)
+{
+   xcb_window_t found = 0;
+   int n = xcb_query_tree_children_length(tree);
+   xcb_window_t *kids = xcb_query_tree_children(tree);
+   for (int i = n - 1; i >= 0 && !found; i--) {
+      xcb_get_window_attributes_cookie_t kac = xcb_get_window_attributes(conn, kids[i]);
+      xcb_get_geometry_cookie_t kgc = xcb_get_geometry(conn, kids[i]);
+      xcb_get_window_attributes_reply_t *ka = xcb_get_window_attributes_reply(conn, kac, NULL);
+      xcb_get_geometry_reply_t *kg = xcb_get_geometry_reply(conn, kgc, NULL);
+      if (ka && kg && ka->map_state == XCB_MAP_STATE_VIEWABLE && ka->_class == XCB_WINDOW_CLASS_INPUT_OUTPUT &&
+          kg->x <= 0 && kg->y <= 0 &&
+          kg->x + kg->width + 2 * kg->border_width >= w &&
+          kg->y + kg->height + 2 * kg->border_width >= h) {
+         if (droiddeck_drawn_lately(kids[i], now)) {
+            found = kids[i];
+         } else if (depth < 3) {
+            xcb_query_tree_reply_t *sub = xcb_query_tree_reply(conn, xcb_query_tree(conn, kids[i]), NULL);
+            if (sub)
+               found = droiddeck_drawn_cover(conn, sub, kg->width, kg->height, now, depth + 1);
+            free(sub);
+         }
+      }
+      free(ka);
+      free(kg);
+   }
+   return found;
+}
