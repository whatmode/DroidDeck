+/* droiddeck: a frame for a window X does not show (unmapped, or covered by a child window).
+ * Under gamescope every present hands the window's toplevel to this swapchain, so a hidden
+ * child (Chromium/ANGLE make them inside Steam's window) presenting there took the toplevel
+ * from the window really drawn: both swapchains retired each other and the UI flashed.
+ * The frame's work is submitted as usual; its present semaphore is waited here instead of
+ * by a present, and the image stays acquired for the next frame. */
+void
+zink_kopper_discard(struct pipe_screen *pscreen, struct pipe_context *pctx, struct pipe_resource *pres)
+{
+   struct zink_screen *screen = zink_screen(pscreen);
+   struct zink_resource *res = zink_resource(pres);
+
+   if (!zink_is_swapchain(res) || !res->obj->dt)
+      return;
+   struct zink_context *ctx = zink_tc_context_unwrap(pctx);
+   if (!zink_kopper_acquired(res->obj->dt, res->obj->dt_idx))
+      return;
+   if (ctx->swapchain || ctx->needs_present) {
+      ctx->bs->has_work = true;
+      pctx->flush(pctx, NULL, PIPE_FLUSH_END_OF_FRAME);
+      if (ctx->last_batch_state && screen->threaded_submit) {
+         struct zink_batch_state *bs = ctx->last_batch_state;
+         util_queue_fence_wait(&bs->flush_completed);
+      }
+   }
+   if (!res->obj->present)
+      return;
+   if (screen->threaded_submit)
+      util_queue_finish(&screen->flush_queue);
+
+   VkFenceCreateInfo fci = {0};
+   fci.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+   VkFence fence = VK_NULL_HANDLE;
+   if (VKSCR(CreateFence)(screen->dev, &fci, NULL, &fence) != VK_SUCCESS)
+      return;
+   VkSubmitInfo si = {0};
+   si.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+   si.waitSemaphoreCount = 1;
+   si.pWaitSemaphores = &res->obj->present;
+   VkPipelineStageFlags stages = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+   si.pWaitDstStageMask = &stages;
+   simple_mtx_lock(&screen->queue_lock);
+   VkResult error = VKSCR(QueueSubmit)(screen->queue, 1, &si, fence);
+   simple_mtx_unlock(&screen->queue_lock);
+   if (error == VK_SUCCESS)
+      VKSCR(WaitForFences)(screen->dev, 1, &fence, VK_TRUE, UINT64_MAX);
+   VKSCR(DestroyFence)(screen->dev, fence, NULL);
+   if (error != VK_SUCCESS) {
+      zink_screen_handle_vkresult(screen, error);
+      return;
+   }
+   VKSCR(DestroySemaphore)(screen->dev, res->obj->present, NULL);
+   res->obj->present = VK_NULL_HANDLE;
+}
