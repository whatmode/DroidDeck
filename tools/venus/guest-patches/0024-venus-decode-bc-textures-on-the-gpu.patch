+/* ---- GPU decode (DROIDDECK_VN_BC_GPU) ----
+ *
+ * On by default. A BC1/BC2/BC3 upload is decoded by bc_s3tc.comp on the GPU instead of by
+ * bc_decode_s3tc() on the guest CPU, and the texels are written straight into device-local
+ * memory. The CPU path writes them into a host-visible dma-heap chunk instead, which is the cost
+ * the frame-time analysis points at; this path removes the guest CPU work and the uncached writes
+ * together. DROIDDECK_VN_BC_GPU=0 puts the decode back on the CPU without a rebuild.
+ *
+ * It was off by default while it was unverified on hardware: there is no Vulkan implementation in
+ * the build environment, so it compiles but had never run there. The shader is not the unknown --
+ * tools/venus/bc-gpu-test/run.sh runs the SPIR-V that ships against the driver's own decoder. What
+ * the build environment cannot test is the plumbing around it: the pipeline, the descriptor set,
+ * and the barriers. Each of those fails into the CPU fallback below, so a device that cannot run
+ * the dispatch gets the path that already shipped rather than a wrong picture.
+ *
+ * Everything is recorded into the program's command buffer at the copy site, so no queue or submit
+ * change is needed:
+ *
+ *   vkCmdCopyBuffer  the compressed data into a device-local buffer, because the program's upload
+ *                    buffer is not necessarily a storage buffer and the shader cannot read it
+ *   barrier          the copy, and the host-written parameters, are visible to the shader
+ *   bind + dispatch  one dispatch per slice, the slice's parameters selected by dynamic offset
+ *   barrier          the texels are visible to the image copy that follows
+ *   (the caller then records its vkCmdCopyBufferToImage from the chunk's buffer)
+ *
+ * Every failure -- no compute queue, no device-local memory, no descriptor set, a dispatch too
+ * large for the workgroup limit, a copy inside a render pass -- falls back to the CPU path for
+ * that copy, so the picture stays right and the worst case is the behaviour that already ships.
+ *
+ * The job parameters go in a storage buffer and not in push constants on purpose. Push constants
+ * are command buffer state shared between the graphics and compute bind points, and this dispatch
+ * is recorded into the program's own command buffer: pushing them would overwrite whatever the
+ * program pushed and has not re-pushed before its next draw. Descriptor bindings are per bind
+ * point, so binding this set for compute cannot disturb the program's graphics bindings.
+ */
+
+bool
+vn_dd_bc_gpu_enabled(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = debug_get_bool_option("DROIDDECK_VN_BC_GPU", true) ? 1 : 0;
+   return on;
+}
+
+/* must match Params in bc_s3tc.comp */
+struct vn_dd_bc_gpu_params {
+   uint32_t kind, bw, dst_pitch, dst_off, src_off, src_pitch, first, count;
+};
+
+/* One descriptor set per GPU chunk, and a chunk lives until its command buffer is reset, so the
+ * pool bounds how many GPU uploads can be in flight.  A program that exhausts it falls back to the
+ * CPU rather than failing, but that fallback is silent, so the pool is sized well past the number
+ * of compressed uploads a frame usually carries. */
+#define BC_GPU_POOL_SETS 256
+
+/* The pipeline, descriptor set layout and descriptor pool, made once for the device on the first
+ * GPU upload.  One device is all that is supported; a second one falls back to the CPU. */
+static struct {
+   VkDevice device;
+   bool ok;
+   uint32_t align; /* minStorageBufferOffsetAlignment, at least 16 */
+   uint32_t param_stride;
+   uint32_t max_blocks; /* maxComputeWorkGroupCount[0] * 64 */
+   VkDescriptorSetLayout set_layout;
+   VkPipelineLayout layout;
+   VkShaderModule module;
+   VkPipeline pipeline;
+   VkDescriptorPool pool;
+} bc_gpu_dev = { .device = VK_NULL_HANDLE };
+
+static VkDeviceSize
+bc_gpu_align_up(VkDeviceSize v, VkDeviceSize a)
+{
+   return (v + a - 1) / a * a;
+}
+
+static int
+bc_gpu_kind(enum pipe_format src_format)
+{
+   switch (src_format) {
+   case PIPE_FORMAT_DXT1_RGB:
+      return 0;
+   case PIPE_FORMAT_DXT1_RGBA:
+      return 1;
+   case PIPE_FORMAT_DXT3_RGBA:
+      return 2;
+   case PIPE_FORMAT_DXT5_RGBA:
+      return 3;
+   default:
+      return -1;
+   }
+}
+
+/* One barrier wide enough for everything: any writer of the buffers (host, transfer, shader) to any
+ * reader.  Coarse on purpose -- this runs once per upload, and a missed dependency here is a wrong
+ * picture rather than a slow frame. */
+static void
+bc_gpu_barrier(VkCommandBuffer cmd)
+{
+   const VkMemoryBarrier mb = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_HOST_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+   };
+   vn_CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+}
+
+static bool
+bc_gpu_dev_init(struct vn_device *dev, struct vn_command_buffer *cmd)
+{
+   VkDevice device = vn_device_to_handle(dev);
+   const struct vn_physical_device *pdev = dev->physical_device;
+   const struct vk_properties *props = &pdev->base.vk.properties;
+
+   if (bc_gpu_dev.device == device)
+      return bc_gpu_dev.ok;
+   if (bc_gpu_dev.device != VK_NULL_HANDLE) {
+      static int logged;
+      bc_log_once(&logged, "a second Vulkan device: only the first decodes BC textures on the GPU");
+      return false;
+   }
+   bc_gpu_dev.device = device;
+
+   /* the command buffer's queue family has to run compute, or the dispatch cannot be recorded */
+   const uint32_t family = cmd->base.vk.pool->queue_family_index;
+   if (family >= pdev->queue_family_count ||
+       !(pdev->queue_family_properties[family].queueFamilyProperties.queueFlags &
+         VK_QUEUE_COMPUTE_BIT)) {
+      static int logged;
+      bc_log_once(&logged, "no compute queue on the pool's queue family, so BC textures stay on "
+                           "the CPU (DROIDDECK_VN_BC_GPU)");
+      return false;
+   }
+
+   bc_gpu_dev.align = MAX2((uint32_t)props->minStorageBufferOffsetAlignment, 16u);
+   bc_gpu_dev.param_stride =
+      (uint32_t)bc_gpu_align_up(sizeof(struct vn_dd_bc_gpu_params), bc_gpu_dev.align);
+   bc_gpu_dev.max_blocks = props->maxComputeWorkGroupCount[0] * 64u;
+
+   const VkDescriptorSetLayoutBinding bindings[3] = {
+      { 0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL },
+      { 1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL },
+      { 2, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL },
+   };
+   const VkDescriptorSetLayoutCreateInfo slci = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .bindingCount = 3,
+      .pBindings = bindings,
+   };
+   if (vn_CreateDescriptorSetLayout(device, &slci, NULL, &bc_gpu_dev.set_layout) != VK_SUCCESS)
+      goto fail_none;
+
+   const VkPipelineLayoutCreateInfo plci = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+      .setLayoutCount = 1,
+      .pSetLayouts = &bc_gpu_dev.set_layout,
+   };
+   if (vn_CreatePipelineLayout(device, &plci, NULL, &bc_gpu_dev.layout) != VK_SUCCESS)
+      goto fail_set_layout;
+
+   const VkShaderModuleCreateInfo smci = {
+      .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+      .codeSize = sizeof(vn_dd_bc_s3tc_spirv),
+      .pCode = vn_dd_bc_s3tc_spirv,
+   };
+   if (vn_CreateShaderModule(device, &smci, NULL, &bc_gpu_dev.module) != VK_SUCCESS)
+      goto fail_layout;
+
+   const VkComputePipelineCreateInfo cpci = {
+      .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+      .stage = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+         .module = bc_gpu_dev.module,
+         .pName = "main",
+      },
+      .layout = bc_gpu_dev.layout,
+   };
+   if (vn_CreateComputePipelines(device, VK_NULL_HANDLE, 1, &cpci, NULL,
+                                 &bc_gpu_dev.pipeline) != VK_SUCCESS)
+      goto fail_module;
+
+   const VkDescriptorPoolSize sizes[2] = {
+      { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, BC_GPU_POOL_SETS * 2 },
+      { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC, BC_GPU_POOL_SETS },
+   };
+   const VkDescriptorPoolCreateInfo dpci = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+      .flags = VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT,
+      .maxSets = BC_GPU_POOL_SETS,
+      .poolSizeCount = 2,
+      .pPoolSizes = sizes,
+   };
+   if (vn_CreateDescriptorPool(device, &dpci, NULL, &bc_gpu_dev.pool) != VK_SUCCESS)
+      goto fail_pipeline;
+
+   bc_gpu_dev.ok = true;
+   vn_droiddeck_log("BC textures: decoding on the GPU (DROIDDECK_VN_BC_GPU), alignment %u",
+                    bc_gpu_dev.align);
+   return true;
+
+fail_pipeline:
+   vn_DestroyPipeline(device, bc_gpu_dev.pipeline, NULL);
+fail_module:
+   vn_DestroyShaderModule(device, bc_gpu_dev.module, NULL);
+fail_layout:
+   vn_DestroyPipelineLayout(device, bc_gpu_dev.layout, NULL);
+fail_set_layout:
+   vn_DestroyDescriptorSetLayout(device, bc_gpu_dev.set_layout, NULL);
+fail_none:
+   vn_droiddeck_log("BC textures: the GPU decode pipeline could not be made, staying on the CPU");
+   return false;
+}
+
+static void
+bc_gpu_dev_fini(VkDevice device)
+{
+   if (bc_gpu_dev.device != device)
+      return;
+   if (bc_gpu_dev.ok) {
+      vn_DestroyDescriptorPool(device, bc_gpu_dev.pool, NULL);
+      vn_DestroyPipeline(device, bc_gpu_dev.pipeline, NULL);
+      vn_DestroyShaderModule(device, bc_gpu_dev.module, NULL);
+      vn_DestroyPipelineLayout(device, bc_gpu_dev.layout, NULL);
+      vn_DestroyDescriptorSetLayout(device, bc_gpu_dev.set_layout, NULL);
+   }
+   bc_gpu_dev.device = VK_NULL_HANDLE;
+   bc_gpu_dev.ok = false;
+}
+
+/* The descriptor set that binds a chunk's three buffers.  Written once: the dynamic offsets select
+ * the per-slice region, so nothing here changes between dispatches. */
+static bool
+bc_chunk_gpu_setup(struct vn_device *dev, struct vn_dd_bc_chunk *chunk)
+{
+   VkDevice device = vn_device_to_handle(dev);
+   const VkDescriptorSetAllocateInfo ai = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+      .descriptorPool = bc_gpu_dev.pool,
+      .descriptorSetCount = 1,
+      .pSetLayouts = &bc_gpu_dev.set_layout,
+   };
+   if (vn_AllocateDescriptorSets(device, &ai, &chunk->set) != VK_SUCCESS)
+      return false;
+   const VkDescriptorBufferInfo infos[3] = {
+      { .buffer = chunk->src, .offset = 0, .range = VK_WHOLE_SIZE },
+      { .buffer = chunk->buffer, .offset = 0, .range = VK_WHOLE_SIZE },
+      { .buffer = chunk->params, .offset = 0, .range = VK_WHOLE_SIZE },
+   };
+   VkWriteDescriptorSet writes[3];
+   for (unsigned i = 0; i < 3; i++) {
+      writes[i] = (VkWriteDescriptorSet){
+         .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+         .dstSet = chunk->set,
+         .dstBinding = i,
+         .descriptorCount = 1,
+         .descriptorType = i == 2 ? VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC
+                                  : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+         .pBufferInfo = &infos[i],
+      };
+   }
+   vn_UpdateDescriptorSets(device, 3, writes, 0, NULL);
+   return true;
+}
+
+/* GPU chunks are not pooled: they carry three buffers and a descriptor set, and the pool is sized
+ * for the simple CPU chunks.  A reset tears them down. */
+static void
+bc_chunk_gpu_destroy(VkDevice device, const struct vn_dd_bc_chunk *chunk)
+{
+   struct vn_dd_bc_chunk c = *chunk;
+   vn_FreeDescriptorSets(device, bc_gpu_dev.pool, 1, &c.set);
+   const VkMemoryUnmapInfo unmap = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_UNMAP_INFO,
+      .memory = c.params_mem,
+   };
+   vn_UnmapMemory2(device, &unmap);
+   vn_DestroyBuffer(device, c.src, NULL);
+   vn_FreeMemory(device, c.src_mem, NULL);
+   vn_DestroyBuffer(device, c.params, NULL);
+   vn_FreeMemory(device, c.params_mem, NULL);
+   vn_DestroyBuffer(device, c.buffer, NULL);
+   vn_FreeMemory(device, c.memory, NULL);
+}
+
+static struct vn_dd_bc_chunk *
+bc_chunk_gpu_new(struct vn_device *dev,
+                 struct vn_dd_bc_cmd *state,
+                 VkDeviceSize dst_size,
+                 VkDeviceSize src_size,
+                 VkDeviceSize params_size)
+{
+   VkDevice device = vn_device_to_handle(dev);
+   struct vn_dd_bc_chunk chunk = {
+      .gpu = true,
+      .size = dst_size,
+   };
+   if (!bc_buffer_new(dev, dst_size,
+                      VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, false,
+                      &chunk.buffer, &chunk.memory))
+      return NULL;
+   if (!bc_buffer_new(dev, src_size,
+                      VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, false,
+                      &chunk.src, &chunk.src_mem))
+      goto fail_dst;
+   if (!bc_buffer_new(dev, params_size, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, true, &chunk.params,
+                      &chunk.params_mem))
+      goto fail_src;
+   const VkMemoryMapInfo map = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_MAP_INFO,
+      .memory = chunk.params_mem,
+      .size = VK_WHOLE_SIZE,
+   };
+   void *ptr = NULL;
+   if (vn_MapMemory2(device, &map, &ptr) != VK_SUCCESS || !ptr)
+      goto fail_params;
+   chunk.params_ptr = ptr;
+   if (!bc_chunk_gpu_setup(dev, &chunk))
+      goto fail_params;
+   util_dynarray_append(&state->chunks, struct vn_dd_bc_chunk, chunk);
+   return util_dynarray_top_ptr(&state->chunks, struct vn_dd_bc_chunk);
+
+fail_params:
+   vn_DestroyBuffer(device, chunk.params, NULL);
+   vn_FreeMemory(device, chunk.params_mem, NULL);
+fail_src:
+   vn_DestroyBuffer(device, chunk.src, NULL);
+   vn_FreeMemory(device, chunk.src_mem, NULL);
+fail_dst:
+   vn_DestroyBuffer(device, chunk.buffer, NULL);
+   vn_FreeMemory(device, chunk.memory, NULL);
+   return NULL;
+}
+
+/* Record the GPU decode for one vkCmdCopyBufferToImage.  `copy->regions` has room for `count`
+ * entries.  Returns false to fall back to the CPU path. */
+static bool
+bc_gpu_copy(VkCommandBuffer cmd_handle,
+            struct vn_command_buffer *cmd,
+            struct vn_device *dev,
+            VkBuffer src,
+            VkImage dst,
+            uint32_t count,
+            const VkBufferImageCopy *regions,
+            const VkBufferImageCopy2 *regions2,
+            struct vn_dd_bc_copy *copy)
+{
+   struct vn_image *img = vn_image_from_handle(dst);
+   const VkFormat orig = img->dd_bc_format;
+   const VkFormat sub = img->base.vk.format;
+   const uint32_t block = bc_block_bytes(orig);
+   const enum pipe_format src_format = util_format_linear(vk_format_to_pipe_format(orig));
+   const enum pipe_format dst_format = util_format_linear(vk_format_to_pipe_format(sub));
+   const int kind = bc_gpu_kind(src_format);
+   if (kind < 0 || util_format_get_blocksize(dst_format) != 4)
+      return false;
+
+   /* A dispatch cannot be recorded inside a render pass, and the chunk's buffers are owned by the
+    * command buffer's pool, so only a primary command buffer outside a render pass qualifies. */
+   if (cmd->base.vk.level != VK_COMMAND_BUFFER_LEVEL_PRIMARY || cmd->builder.in_render_pass)
+      return false;
