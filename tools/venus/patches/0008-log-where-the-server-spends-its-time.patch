+/* DroidDeck: where the bridge's server spends its time, per ring, every 10 s in the server's
+ * log: busy time and the commands that took it (count, total, longest). Steam's UI waited on
+ * the GPU for a large part of each frame; this says whether it is the server itself (decoding,
+ * driver calls such as memory allocation) or the GPU behind it. */
+#define VKR_DD_TYPES 512
+struct vkr_dd_stats {
+   int64_t since, busy;
+   uint32_t count[VKR_DD_TYPES];
+   int64_t total[VKR_DD_TYPES], longest[VKR_DD_TYPES];
+   unsigned reports;
+};
+
+static int64_t
+vkr_dd_now(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (int64_t)ts.tv_sec * 1000000000ll + ts.tv_nsec;
+}
+
+static void
+vkr_dd_report(struct vkr_ring *ring, struct vkr_dd_stats *st, int64_t now)
+{
+   if (!st->since) {
+      st->since = now;
+      return;
+   }
+   if (now - st->since < 10000000000ll)
+      return;
+   char line[900];
+   int len = snprintf(line, sizeof(line), "droiddeck: ring %llu busy %.0f ms of %.0f s:",
+                      (unsigned long long)ring->id, st->busy / 1e6, (now - st->since) / 1e9);
+   for (int k = 0; k < 10; k++) {
+      int best = -1;
+      for (int i = 0; i < VKR_DD_TYPES; i++)
+         if (st->count[i] && (best < 0 || st->total[i] > st->total[best]))
+            best = i;
+      if (best < 0 || len >= (int)sizeof(line) - 80)
+         break;
+      len += snprintf(line + len, sizeof(line) - len, " %s %ux %.1f ms (max %.1f);",
+                      vn_dispatch_command_name((VkCommandTypeEXT)best), st->count[best],
+                      st->total[best] / 1e6, st->longest[best] / 1e6);
+      st->count[best] = 0;
+   }
+   if (st->busy > 0 && ++st->reports <= 360)
+      vkr_log("%s", line);
+   memset(st->count, 0, sizeof(st->count));
+   memset(st->total, 0, sizeof(st->total));
+   memset(st->longest, 0, sizeof(st->longest));
+   st->busy = 0;
+   st->since = now;
+}
+
 static bool
