From e1168ce6825569ba460ed8ee3b736ae8e26860c2 Mon Sep 17 00:00:00 2001
From: droiddeck <ci@droiddeck>
Date: Sat, 24 Oct 2026 13:30:34 +0000
Subject: [PATCH] venus: destroy the device object mutex after its objects

---
 src/venus/vkr_device.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/venus/vkr_device.c b/src/venus/vkr_device.c
index 9144180..a10ed33 100644
--- a/src/venus/vkr_device.c
+++ b/src/venus/vkr_device.c
@@ -324,13 +324,17 @@ vkr_device_destroy(struct vkr_context *ctx, struct vkr_device *dev, bool destroy
          vkr_log("vkDeviceWaitIdle(%p) failed(%d)", dev, (int32_t)result);
    }
 
-   mtx_destroy(&dev->object_mutex);
-
+   /* vkr_device_object_destroy -> vkr_device_remove_object locks object_mutex, so it can
+    * only go once the objects are gone. glibc tolerates locking a destroyed mutex; Android's
+    * bionic aborts ("pthread_mutex_lock called on a destroyed mutex"), which killed the
+    * whole context whenever a client destroyed a device it had not emptied (Zink does). */
    if (!list_is_empty(&dev->objects)) {
       list_for_each_entry_safe (struct vkr_object, obj, &dev->objects, track_head)
          vkr_device_object_destroy(ctx, dev, obj);
    }
 
+   mtx_destroy(&dev->object_mutex);
+
    list_for_each_entry_safe (struct vkr_queue, queue, &dev->queues, base.track_head)
       vkr_queue_destroy(ctx, queue);
 
-- 
