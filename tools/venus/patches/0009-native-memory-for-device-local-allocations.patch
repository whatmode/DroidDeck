+/* add the alias types of the host types in *bits (memory requirements replies) */
+static inline void
+vkr_physical_device_add_memory_aliases(const struct vkr_physical_device *physical_dev,
+                                       uint32_t *bits)
+{
+   for (uint32_t i = 0; i < physical_dev->alias_memory_type_count; i++) {
+      if (*bits & (1u << physical_dev->alias_host_type[i]))
+         *bits |= 1u << (physical_dev->host_memory_type_count + i);
+   }
+}
