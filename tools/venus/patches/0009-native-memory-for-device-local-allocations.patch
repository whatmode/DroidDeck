+static const char *
+vkr_memory_flags_str(VkMemoryPropertyFlags flags, char *buf, size_t size)
+{
+   static const struct {
+      VkMemoryPropertyFlags bit;
+      const char *name;
+   } names[] = {
+      { VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, "device-local" },
+      { VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT, "host-visible" },
+      { VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, "coherent" },
+      { VK_MEMORY_PROPERTY_HOST_CACHED_BIT, "cached" },
+      { VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT, "lazy" },
+      { VK_MEMORY_PROPERTY_PROTECTED_BIT, "protected" },
+   };
+   buf[0] = '\0';
+   for (size_t i = 0; i < ARRAY_SIZE(names); i++) {
+      if (flags & names[i].bit)
+         snprintf(buf + strlen(buf), size - strlen(buf), "%s%s", buf[0] ? "|" : "",
+                  names[i].name);
+   }
+   if (!buf[0])
+      snprintf(buf, size, "0x%x", flags);
+   return buf;
+}
+
+/* DroidDeck: when host-visible memory has to come from a dma-heap (Android), every image and
+ * buffer the guest puts in such a type becomes an imported dma_buf: an ioctl, an import and
+ * no native image layout or compression for the driver. Drivers like Mali offer no
+ * device-local type without host-visible, so everything the guest allocates takes that path.
+ * Offer a DEVICE_LOCAL-only alias of the first device-local host-visible type: the guest
+ * never maps it, so it is allocated by the driver directly. VKR_NATIVE_MEMORY=0 turns it
+ * off, =1 turns it on without a dma-heap (to test it).
+ */
+static void
+vkr_physical_device_init_memory_aliases(struct vkr_physical_device *physical_dev)
+{
+   VkPhysicalDeviceMemoryProperties *props = &physical_dev->memory_properties;
+   physical_dev->host_memory_type_count = props->memoryTypeCount;
+   physical_dev->alias_memory_type_count = 0;
+
+   char buf[96];
+   for (uint32_t i = 0; i < props->memoryTypeCount; i++)
+      vkr_log("memory type %u: heap %u (%llu MiB), %s", i, props->memoryTypes[i].heapIndex,
+              (unsigned long long)(props->memoryHeaps[props->memoryTypes[i].heapIndex].size >>
+                                   20),
+              vkr_memory_flags_str(props->memoryTypes[i].propertyFlags, buf, sizeof(buf)));
+
+   const char *env = getenv("VKR_NATIVE_MEMORY");
+   bool enable = physical_dev->udmabuf_dev_fd >= 0;
+   if (env && env[0])
+      enable = strcmp(env, "0") != 0;
+   if (!enable) {
+      vkr_log("native device-local memory types: off%s", env && env[0] ? " (VKR_NATIVE_MEMORY)" : "");
+      return;
+   }
+
+   const VkMemoryPropertyFlags want =
+      VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT | VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+   for (uint32_t i = 0; i < props->memoryTypeCount; i++) {
+      const VkMemoryPropertyFlags flags = props->memoryTypes[i].propertyFlags;
+      if ((flags & want) != want || (flags & VK_MEMORY_PROPERTY_PROTECTED_BIT))
+         continue;
+      bool has_plain = false;
+      for (uint32_t j = 0; j < props->memoryTypeCount; j++) {
+         const VkMemoryPropertyFlags f = props->memoryTypes[j].propertyFlags;
+         if (props->memoryTypes[j].heapIndex == props->memoryTypes[i].heapIndex &&
+             f == VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
+            has_plain = true;
+      }
+      if (has_plain || props->memoryTypeCount >= VK_MAX_MEMORY_TYPES)
+         break;
+
+      const uint32_t alias = props->memoryTypeCount++;
+      props->memoryTypes[alias] = (VkMemoryType){
+         .propertyFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+         .heapIndex = props->memoryTypes[i].heapIndex,
+      };
+      physical_dev->alias_host_type[physical_dev->alias_memory_type_count++] = i;
+      vkr_log("memory type %u: device-local only, native allocations of host type %u", alias,
+              i);
+      break;
+   }
+   if (!physical_dev->alias_memory_type_count)
+      vkr_log("native device-local memory types: none needed");
+}
+
 static void
 vkr_physical_device_init_memory_properties(struct vkr_physical_device *physical_dev)
 {
@@ -277,6 +363,8 @@ vkr_physical_device_init_memory_properties(struct vkr_physical_device *physical_
        physical_dev->EXT_external_memory_dma_buf && physical_dev->udmabuf_dev_fd < 0)
       physical_dev->udmabuf_dev_fd = vkr_android_dma_heap_fd();
 #endif
+
+   vkr_physical_device_init_memory_aliases(physical_dev);
 }
 
