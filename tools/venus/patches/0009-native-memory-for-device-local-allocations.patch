+/* DroidDeck: what allocations the guest makes and where they come from, every 10 s in the
+ * server log while it changes (0 native alias, 1 dma-heap, 2 other)
+ */
+static mtx_t vkr_dd_memory_stats_lock;
+
+static void
+vkr_dd_memory_stats_init(void)
+{
+   mtx_init(&vkr_dd_memory_stats_lock, mtx_plain);
+}
+
+static void
+vkr_dd_memory_stats(int kind, VkDeviceSize size)
+{
+   static const char *const names[3] = { "native device-local", "dma-heap", "other" };
+   static once_flag once = ONCE_FLAG_INIT;
+   static uint64_t count[3], bytes[3], total_count[3], total_bytes[3], last_ns;
+   call_once(&once, vkr_dd_memory_stats_init);
+   mtx_lock(&vkr_dd_memory_stats_lock);
+   count[kind]++;
+   bytes[kind] += size;
+   total_count[kind]++;
+   total_bytes[kind] += size;
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   const uint64_t now = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+   if (!last_ns)
+      last_ns = now;
+   static uint64_t interval_ns;
+   if (!interval_ns) {
+      /* VKR_MEMORY_STATS_MS: how often (default 10 s; tests use less) */
+      const char *env = getenv("VKR_MEMORY_STATS_MS");
+      interval_ns = (env && atoi(env) > 0 ? (uint64_t)atoi(env) : 10000ull) * 1000000ull;
+   }
+   if (now - last_ns >= interval_ns) {
+      char line[512];
+      int n = snprintf(line, sizeof(line), "allocations in %.1f s:",
+                       (double)(now - last_ns) / 1e9);
+      for (int i = 0; i < 3; i++)
+         n += snprintf(line + n, sizeof(line) - (size_t)n,
+                       " %s %llu (%.1f MiB, total %llu, %.1f MiB)", names[i],
+                       (unsigned long long)count[i], (double)bytes[i] / 1048576.0,
+                       (unsigned long long)total_count[i],
+                       (double)total_bytes[i] / 1048576.0);
+      vkr_log("%s", line);
+      memset(count, 0, sizeof(count));
+      memset(bytes, 0, sizeof(bytes));
+      last_ns = now;
+   }
+   mtx_unlock(&vkr_dd_memory_stats_lock);
+}
+
