# Venus bridge sources. The server (virglrenderer, vtest + venus) is built for Android and runs
# Vulkan on the phone's own driver; the guest ICD (Mesa venus) is built for the Linux side.
VIRGLRENDERER_REPO=https://gitlab.freedesktop.org/virgl/virglrenderer.git
VIRGLRENDERER_REF=1.1.1
LIBEPOXY_REPO=https://github.com/anholt/libepoxy.git
LIBEPOXY_REF=1.5.10
LIBDRM_REPO=https://gitlab.freedesktop.org/mesa/drm.git
LIBDRM_REF=libdrm-2.4.124
MESA_REPO=https://gitlab.freedesktop.org/mesa/mesa.git
MESA_REF=mesa-25.2.5
