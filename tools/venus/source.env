# Venus bridge sources. The server (virglrenderer, vtest + venus) is built for Android and runs
# Vulkan on the phone's own driver; the guest ICD (Mesa venus) is built for the Linux side.
VIRGLRENDERER_REPO=https://gitlab.freedesktop.org/virgl/virglrenderer.git
VIRGLRENDERER_REF=1.1.1
LIBEPOXY_REPO=https://github.com/anholt/libepoxy.git
LIBEPOXY_REF=1.5.10
LIBDRM_REPO=https://gitlab.freedesktop.org/mesa/drm.git
LIBDRM_REF=libdrm-2.4.124
MESA_REPO=https://gitlab.freedesktop.org/mesa/mesa.git
MESA_REF=mesa-25.2.5

# The GPU BC decode differential test (tools/venus/bc-gpu-test) runs the shader that ships on the
# host, so CI needs SPIRV-Cross (to translate the SPIR-V to C++ it can execute) and glm (used by
# SPIRV-Cross's shader runtime). The distro spirv-cross package ships neither the shader-runtime
# headers nor libspirv-cross.a, so it is built from source; both are pinned to the revisions the
# check was verified against.
SPIRV_CROSS_REPO=https://github.com/KhronosGroup/SPIRV-Cross.git
SPIRV_CROSS_REF=300681bbcb8365a8d1eacdacdbdd0249bbf1d6b1
GLM_REPO=https://github.com/g-truc/glm.git
GLM_REF=1.0.1
